// V2.4: Check if request was granted, poll for slot
app.post('/api/hop/claim-slot', (req, res) => {
  try {
    const { account, placeId = HOP_PLACE_ID, requestId } = req.body || {};
    if (!account) return res.status(400).json({ ok: false, error: 'Missing account' });

    const granted = globalScheduler.getNextReservation(account, Number(placeId));
    if (!granted) {
      return res.status(202).json({ ok: false, waiting: true });  // 202 Accepted - still waiting
    }

    // Verify requestId matches (client should send the requestId from enqueue response)
    if (requestId && granted.requestId !== requestId) {
      return res.status(409).json({ ok: false, error: 'REQUEST_ID_MISMATCH' });
    }

    // Slot granted, reserve immediately with requestId
    // V2.4: Atomic - reserve() now marks request as CONSUMED inside transaction
    const reservation = hopReserve({
      account,
      placeId: Number(placeId),
      currentJobId: granted.currentJobId || '',
      requestId: granted.requestId
    });
    if (!reservation) {
      return res.status(409).json({ ok: false, error: 'POOL_EMPTY', code: 'POOL_EMPTY' });
    }

    runtimeLogger.write('HOP-CLAIM-SLOT', `account=${account} reason=${granted.reason} requestId=${granted.requestId} reserved`);
    res.json({ ok: true, ...reservation, runtimeId: runtimeManager.getActiveRuntime()?.run_id });
  } catch (err) { fail(res, err, 400); }
});


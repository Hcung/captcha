      return S.countAccounts.get(q, q, status, status, cut, status, cut);
    },
  },
  getAccount: { get: id => S.getAccount.get(id) || null },
  countSnapshots: { get: () => S.countSnapshots.get() },
  getHistoryByDate: { all: cutoff => S.history.all(cutoff) },
  isDeleted: { get: id => !!S.isDeleted.get(id) },
  listDeleted: { all: () => S.listDeleted.all() },
  deleteAccount: { run: id => deleteAccount(id) },
};

// ---------- ingest ----------
const ingestTx = db.transaction((records, now) => {
  const out = { ingested: 0, deleted: 0, invalid: 0, stale: 0 };

  for (const r of records) {
    const account = r && typeof r === 'object' ? String(r.account ?? '').trim() : '';
    if (!account) { out.invalid++; continue; }

    // tombstone: account đã xóa nhưng có upload mới -> restore tự động
    if (S.isDeleted.get(account)) {
      S.unmarkDeleted.run(account);
      console.log(`[DB] Auto-restored deleted account: ${account}`);
    }

    let ts = num(r.ts) || now;
    if (ts < 1e12) ts *= 1000;              // Lua gửi giây -> ms
    if (ts > now + DAY_MS) ts = now;        // chống ts lệch giờ

    const prev = S.getAccount.get(account);
    if (prev && ts < prev.data_ts) { out.stale++; continue; }   // data cũ không đè data mới

    const gems = num(r.gems);
    const items = Array.isArray(r.items)
      ? r.items.filter(i => i && i.category != null && i.id != null)
      : [];
    const currencies =
      r.currencies && typeof r.currencies === 'object' && !Array.isArray(r.currencies)
        ? r.currencies
        : {};

    const hash = crypto.createHash('sha1')
      .update(JSON.stringify([items, currencies]))
      .digest('hex');
    const contentChanged = !prev || prev.items_hash !== hash;

    // last_seen/status luôn cập nhật, kể cả khi data không đổi
    S.upsertAccount.run({
      id: account,
      name: account,
      gems,
      rank: text(r.rank),
      rebirths: r.rebirths == null ? null : num(r.rebirths),
      huge_potion: num(r.hugePotion),
      bucket: num(r.bucket),
      bucket_magic: num(r.bucketMagic),
      coins: num(r.coins),
      last_seen: now,
      status: 'online',
      created_at: now,
      data_ts: ts,
      items_hash: hash,
    });

    if (contentChanged) {
      S.clearItems.run(account);
      for (const i of items) {
        S.insertItem.run(account, String(i.category), String(i.id), String(i.variant || 'Normal'), num(i.amount));
      }
      S.clearCurrencies.run(account);
      for (const [id, amount] of Object.entries(currencies)) {
        S.insertCurrency.run(account, id, num(amount));
      }
    }

    // snapshot nhẹ, tối đa 1 lần / SNAPSHOT_INTERVAL_MS (items không lặp trong payload)
    const lastTs = S.lastSnapshotTs.get(account).ts || 0;
    if (ts - lastTs >= SNAPSHOT_INTERVAL_MS) {
      S.insertSnapshot.run(account, ts, gems, JSON.stringify({
        gems,
        currencies,
        rank: text(r.rank),
        rebirths: r.rebirths ?? null,
        hugePotion: num(r.hugePotion),
        bucket: num(r.bucket),
        bucketMagic: num(r.bucketMagic),
        coins: num(r.coins),
      }));
    }

    out.ingested++;
  }

  return out;
});

function ingest(data) {
  return ingestTx(Array.isArray(data) ? data : [data], Date.now());
}

// ---------- delete / restore ----------
// Xóa = tombstone + gỡ dữ liệu. Account gửi lại sẽ bị chặn tới khi restore.
function deleteAccount(id) {
  return db.transaction(() => {
    S.markDeleted.run(id, Date.now());
    const existed = S.delAccount.run(id).changes > 0;
    S.delSnaps.run(id);
    S.clearItems.run(id);
    S.clearCurrencies.run(id);
    return existed;
  })();
}

function restoreAccount(id) {
  return S.unmarkDeleted.run(id).changes > 0;
}

function deleteAccounts(ids) {
  const list = Array.isArray(ids) ? [...new Set(ids.map(String))] : [];
  return db.transaction(() => {
    const deleted = [];
    const missing = [];
    for (const id of list) (deleteAccount(id) ? deleted : missing).push(id);
    return { deleted, missing };
  })();
}

// idle cleanup: KHÔNG tombstone -> account chạy lại tự hiện. idleMs <= 0 = tắt.
function cleanupInactiveAccounts(idleMs) {
  if (!(idleMs > 0)) return 0;
  return db.transaction(() => {
    const stale = db.prepare('SELECT id FROM accounts WHERE last_seen < ?').all(Date.now() - idleMs);
    for (const { id } of stale) {
      S.delAccount.run(id);
      S.delSnaps.run(id);
      S.clearItems.run(id);
      S.clearCurrencies.run(id);
    }
    return stale.length;
  })();
}

function cleanup(days = 30) {
  const cut = Date.now() - days * DAY_MS;
  db.prepare('DELETE FROM delivered_events WHERE delivered_at < ?').run(cut);
  return db.prepare('DELETE FROM snapshots WHERE ts < ?').run(cut).changes;
}

function updateOfflineStatus(ms = ONLINE_MS) {
  return db.prepare(`
    UPDATE accounts SET status = CASE WHEN last_seen >= ? THEN 'online' ELSE 'offline' END
  `).run(Date.now() - ms).changes;
}

// ---------- events / heartbeat ----------
function trackEvent(eventId, account, type, data) {
  if (db.prepare('SELECT 1 FROM delivered_events WHERE event_id = ?').get(eventId)) {
    return { ok: true, duplicate: true };
  }
  const r = db.prepare(`
    INSERT OR IGNORE INTO event_queue(event_id, account, type, data, created_at) VALUES(?, ?, ?, ?, ?)
  `).run(eventId, account, type, JSON.stringify(data ?? null), Date.now());
  return { ok: true, duplicate: !r.changes };
}

function trackBatch(events) {
  return db.transaction(rows =>
    rows.map(e => ({ event_id: e.event_id, ...trackEvent(e.event_id, e.account, e.type, e.data) }))
  )(events);
}

function trackHeartbeat(account) {
  if (S.isDeleted.get(account)) return { ok: true, ignored: true };
  const now = Date.now();
  S.touchAccount.run(account, account, now, now);
  return { ok: true };
}

function getQueueStats() {
  return {
    queue_size: db.prepare('SELECT COUNT(*) AS count FROM event_queue').get().count,
    delivered: db.prepare('SELECT COUNT(*) AS count FROM delivered_events').get().count,
  };
}

function processQueue() {
  return db.transaction(() => {
    const rows = db.prepare('SELECT event_id FROM event_queue').all();
    const mark = db.prepare('INSERT OR IGNORE INTO delivered_events(event_id, delivered_at) VALUES(?, ?)');
    const now = Date.now();
    for (const row of rows) mark.run(row.event_id, now);
    db.prepare('DELETE FROM event_queue').run();
    return rows.length;
  })();
}


  return
end

-- ============================================================
-- SHARED CONFIG
-- ============================================================
local SharedConfig = {
  WEB_SERVER = "https://entrepreneurs-healthcare-plus-mae.trycloudflare.com/",

  -- V2.3 Security: Separate credentials for HOP and TrackStat
  -- DEFAULT TESTING KEYS (for private testing environment only)
  -- ⚠️ CHANGE THESE BEFORE PUBLIC DEPLOYMENT!
  API_KEY_HOP = "311005",      -- Testing default - override via getgenv()
  API_KEY_INGEST = "311005",   -- Testing default - override via getgenv()

  -- Backward compatibility (deprecated)
  API_KEY = "",                -- Legacy: maps to INGEST if new keys not set

  PLACE_ID = game.PlaceId,
  TIMEOUT = 10,
  ENABLE_HOP_FETCHER = true,
  FETCHER_BACKUP_ENABLED = true,
  FETCH_INTERVAL = 30,
  HOP_VERIFY_INTERVAL = 150,
}

-- SECURITY: Override config via getgenv() before loading this script
-- Example:
--   getgenv().TrackStatConfig = { API_KEY_INGEST = "your-ingest-key", WEB_SERVER = "https://server.com" }
--   getgenv().TrackStatHopConfig = { API_KEY_HOP = "your-hop-key" }
--
-- ⚠️ IMPORTANT: Default "311005" is for TESTING ONLY in private environment!
-- NEVER use default keys in production or public deployment!

if type(getgenv().TrackStatConfig) == "table" then
  for k, v in pairs(getgenv().TrackStatConfig) do
    if SharedConfig[k] ~= nil then SharedConfig[k] = v end
  end
end

if type(getgenv().TrackStatHopConfig) == "table" then
  for k, v in pairs(getgenv().TrackStatHopConfig) do
    if SharedConfig[k] ~= nil then SharedConfig[k] = v end
  end
end

-- Backward compatibility: API_KEY → API_KEY_INGEST
if SharedConfig.API_KEY_INGEST == "" and SharedConfig.API_KEY ~= "" then
  SharedConfig.API_KEY_INGEST = SharedConfig.API_KEY
end

SharedConfig.WEB_SERVER = tostring(SharedConfig.WEB_SERVER):gsub("/+$", "")
SharedConfig.API_KEY_HOP = tostring(SharedConfig.API_KEY_HOP or "")
SharedConfig.API_KEY_INGEST = tostring(SharedConfig.API_KEY_INGEST or "")

local http = request or http_request or (syn and syn.request) or (fluxus and fluxus.request) or (http and http.request)

-- V2.4: Global startup sequencing flag
getgenv().CLIENT_JOINED = false  -- Set to true after successful join()

-- ============================================================
-- PART 1: HOP FETCHER
-- ============================================================
local function initFetcher()
  print("[UNIFIED] Starting HOP Fetcher...")

  if not SharedConfig.ENABLE_HOP_FETCHER then
    print("[UNIFIED] Fetcher disabled - Hop Client only")
    return
  end

  -- V2.3: Require API_KEY_HOP for Fetcher
  if not SharedConfig.API_KEY_HOP or SharedConfig.API_KEY_HOP == "" then
    warn("[HOP-FETCHER] Missing API_KEY_HOP. Fetcher disabled.")
    warn("[HOP-FETCHER] Configure: getgenv().TrackStatHopConfig = { API_KEY_HOP = 'your-key' }")
    getgenv().HopFetcherStats = function()
      return { status = "NO_API_KEY_HOP", collectorId = nil }
    end
    return
  end

  local FETCH_STATE = {
    collectorId = nil,
    leaseToken = nil,
    runtimeId = nil,
    status = "INIT",
  }

  local function log(msg, level)
    level = level or "info"
    local prefixes = { info = "[HOP-FETCHER]", warn = "[HOP-FETCHER-WARN]", error = "[HOP-FETCHER-ERROR]" }
    print(string.format("%s %s", prefixes[level] or "[HOP-FETCHER]", msg))
  end

  local function post(path, payload)
    if not http then
        return false, nil, "no request function", 0, nil
    end

    local okBody, body = pcall(function()
        return HttpService:JSONEncode(payload or {})
    end)

    if not okBody then
        return false, nil, tostring(body), 0, nil
    end

    local ok, response = pcall(function()
        return http({
            Url = SharedConfig.WEB_SERVER .. path,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["x-api-key"] = SharedConfig.API_KEY_HOP,
            },
            Body = body,
            Timeout = SharedConfig.TIMEOUT,
        })
    end)

    if not ok then
        return false, nil, tostring(response), 0, nil
    end

    if type(response) ~= "table" then
        return false, nil, "invalid HTTP response", 0, tostring(response)
    end

    local code = tonumber(response.StatusCode or response.Status) or 0
    local raw = response.Body or response.body
    local parsed = nil

    if type(raw) == "string" and raw ~= "" then
        local decodeOk, decoded = pcall(function()
            return HttpService:JSONDecode(raw)
        end)

        if decodeOk then
            parsed = decoded
        end
    end

    return code >= 200 and code < 300,
        parsed,
        "HTTP " .. tostring(code),
        code,
        raw
  end

  local function get(path)
    if not http then return false, nil, "no request function" end
    local ok, response = pcall(function()
      return http({
        Url = SharedConfig.WEB_SERVER .. path,
        Method = "GET",
        Headers = {
          ["x-api-key"] = SharedConfig.API_KEY_HOP,
        },
        Timeout = SharedConfig.TIMEOUT,
      })
    end)
    if not ok or type(response) ~= "table" then return false, nil, tostring(response) end
    local code = tonumber(response.StatusCode or response.Status) or 0
    local parsed = nil
    local raw = response.Body or response.body
    if type(raw) == "string" and raw ~= "" then
      pcall(function() parsed = HttpService:JSONDecode(raw) end)
    end
    return code >= 200 and code < 300, parsed, "HTTP " .. tostring(code)
  end

  local function claim()
    -- V2.4: Retry claim lúc khởi chạy với exponential backoff
    local backoffs = {5, 10, 20}  -- seconds
    local attempt = 0

    while true do
      attempt = attempt + 1
      local ok, body, err, code = post("/api/hop/fetcher/claim", {
        account = LocalPlayer.Name,
        placeId = SharedConfig.PLACE_ID,
        jobId = game.JobId,
      })

      if ok and body and body.collectorId and body.leaseToken and body.runtimeId then
        FETCH_STATE.collectorId = body.collectorId
        FETCH_STATE.leaseToken = body.leaseToken
        FETCH_STATE.runtimeId = body.runtimeId
        FETCH_STATE.status = "CLAIMED"
        log("Claimed: collectorId=" .. tostring(body.collectorId) .. " runtimeId=" .. tostring(body.runtimeId))
        return true
      end

      if body and body.code == "FETCHER_BUSY" then
        log("FETCHER_BUSY - running as Hop Client only", "warn")
        FETCH_STATE.status = "STANDBY"
        return false
      end

      -- Network error hoặc server error - retry
      local waitTime = (backoffs[attempt] or 30) + math.random(0, 5)
      local errDetail = tostring(body and body.error or err) .. " (HTTP " .. tostring(code or 0) .. ")"
      log(("Claim failed (attempt %d): %s - retrying in %ds"):format(attempt, errDetail, waitTime), "warn")
      FETCH_STATE.status = "CONNECTING"

      if attempt <= 3 then
        task.wait(waitTime)
      else
        -- After 3 attempts, wait 30-60s with jitter
        task.wait(waitTime)
        attempt = 2  -- Reset to keep backoff cycle
      end
    end
  end

  -- Thử claim một lần (dùng cho STANDBY retry)
  local function tryClaimOnce()
    local ok, body, err, code = post("/api/hop/fetcher/claim", {
      account = LocalPlayer.Name,
      placeId = SharedConfig.PLACE_ID,
      jobId = game.JobId,
    })

    if ok and body and body.collectorId and body.leaseToken and body.runtimeId then
      FETCH_STATE.collectorId = body.collectorId
      FETCH_STATE.leaseToken = body.leaseToken
      FETCH_STATE.runtimeId = body.runtimeId
      FETCH_STATE.status = "CLAIMED"
      log("Claimed from STANDBY: collectorId=" .. tostring(body.collectorId) .. " runtimeId=" .. tostring(body.runtimeId))
      return true
    end

    if not ok then
      log("STANDBY claim failed: " .. tostring(body and body.error or err) .. " (HTTP " .. tostring(code or 0) .. ")", "warn")
    end

    return false
  end

  local function heartbeat()
    if not FETCH_STATE.collectorId then return end
    local ok, body = post("/api/hop/fetcher/heartbeat", {
      collectorId = FETCH_STATE.collectorId,
      leaseToken = FETCH_STATE.leaseToken,
      placeId = SharedConfig.PLACE_ID,
    })
    if not ok then
      log("Heartbeat failed - lease may be expired", "warn")
      FETCH_STATE.status = "LEASE_LOST"
    end
  end

  -- Tự reclaim sau Backend restart
  local function reclaimAfterRestart()
    log("Attempting to reclaim after Backend restart...", "warn")
    task.wait(2) -- Chờ Backend khởi động

    local maxRetries = 10
    local retryCount = 0

    while retryCount < maxRetries do
      retryCount = retryCount + 1
      log(string.format("Reclaim attempt %d/%d...", retryCount, maxRetries), "warn")

      local ok, body = post("/api/hop/fetcher/claim", {
        account = LocalPlayer.Name,
        placeId = SharedConfig.PLACE_ID,
        jobId = game.JobId,
      })

      if ok and body and body.collectorId and body.leaseToken and body.runtimeId then
        FETCH_STATE.collectorId = body.collectorId
        FETCH_STATE.leaseToken = body.leaseToken
        FETCH_STATE.runtimeId = body.runtimeId
        FETCH_STATE.status = "CLAIMED"
        log("Reclaimed successfully: collectorId=" .. tostring(body.collectorId) .. " runtimeId=" .. tostring(body.runtimeId), "info")
        return true
      end

      log("Reclaim failed, waiting before retry...", "warn")
      task.wait(5 + math.random(0, 10))
    end

    log("Reclaim failed after " .. tostring(maxRetries) .. " attempts", "error")
    return false
  end

  local function getTask()
    if not FETCH_STATE.collectorId then return nil end
    local url = string.format("/api/hop/fetcher/task?collectorId=%s&leaseToken=%s&placeId=%d",
      tostring(FETCH_STATE.collectorId),
      tostring(FETCH_STATE.leaseToken),
      SharedConfig.PLACE_ID)
    local ok, body = get(url)
    if ok and body then
      FETCH_STATE.inFlightCount = (FETCH_STATE.inFlightCount or 0) + 1
      return body
    end
    return nil
  end

  local function fetchRobloxAPI(placeId, sortOrder, cursor)
    local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public", placeId)
    local params = "sortOrder=" .. sortOrder .. "&limit=100&excludeFullGames=true"
    if cursor then params = params .. "&cursor=" .. HttpService:UrlEncode(cursor) end
    local fullUrl = url .. "?" .. params
    log("Fetch " .. sortOrder .. " cursor=" .. (cursor and "yes" or "nil"))
    local ok, raw = pcall(function() return game:HttpGet(fullUrl) end)
    if not ok or type(raw) ~= "string" or raw == "" then
      return false, "HttpGet failed or empty"
    end
    local okDecode, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not okDecode or type(data) ~= "table" then
      return false, "JSON decode failed"
    end
    return true, data
  end

  local function parseServers(data)
    local servers = {}
    if type(data) ~= "table" or type(data.data) ~= "table" then return servers end
    local seen = {}
    for _, row in ipairs(data.data) do
      if type(row) == "table" and row.id and not seen[row.id] then
        seen[row.id] = true
        local playing = tonumber(row.playing) or 0
        local maxPlayers = tonumber(row.maxPlayers) or 0
        -- Send all servers to backend, let backend classify FULL
        -- No longer filter playing < maxPlayers here
        if maxPlayers > 0 then
          table.insert(servers, {
            jobId = tostring(row.id),
            playing = playing,
            maxPlayers = maxPlayers,
          })
        end
      end
    end
    return servers
  end

  local function reportServers(taskInfo, servers, nextCursor)
    if not FETCH_STATE.collectorId or not taskInfo then
        log("Report skipped: missing collectorId or taskInfo", "error")
        return false
    end

    local taskId = tostring(taskInfo.taskId or "")
    local source = tostring(taskInfo.source or "Unknown")
    local serverCount = type(servers) == "table" and #servers or 0

    log(string.format(
        "REPORT_SENDING source=%s page=%s servers=%d taskId=%s runtimeId=%s",
        source,
        tostring(taskInfo.pageIndex),
        serverCount,
        string.sub(taskId, 1, 8),
        tostring(FETCH_STATE.runtimeId)
    ))

    local ok, body, err, code, raw = post(
        "/api/hop/fetcher/report",
        {
            collectorId = FETCH_STATE.collectorId,
            leaseToken = FETCH_STATE.leaseToken,
            runtimeId = FETCH_STATE.runtimeId,
            taskId = taskInfo.taskId,
            scanId = taskInfo.scanId,
            pageIndex = taskInfo.pageIndex,
            cursorUsed = taskInfo.cursor,
            placeId = SharedConfig.PLACE_ID,
            source = taskInfo.source,
            servers = servers or {},
            nextCursor = nextCursor or nil,
        }
    )

    -- HTTP 2xx là request thành công,
    -- kể cả trường hợp response không có JSON body.
    if ok then
        body = type(body) == "table" and body or {}

        local newAdded = tonumber(body.newAdded) or 0
        local matched = tonumber(body.matchedExisting) or 0
        local updated = tonumber(body.updated) or 0
        local reactivated = tonumber(body.reactivated) or 0
        local playerChanged = tonumber(body.playerChanged) or 0
        local statusChanged = tonumber(body.statusChanged) or 0
        local removed = tonumber(body.removedOutOfRange) or 0
        local active = tonumber(body.poolActive) or 0
        local total = tonumber(body.poolTotal) or 0

        log(string.format(
            "REPORT_ACCEPTED HTTP=%s source=%s added=%d matched=%d upd=%d reactivated=%d playerChg=%d statusChg=%d removed=%d active=%d total=%d taskId=%s",
            tostring(code),
            source,
            newAdded,
            matched,
            updated,
            reactivated,
            playerChanged,
            statusChanged,
            removed,
            active,
            total,
            string.sub(taskId, 1, 8)
        ))

        -- V2.4: Decrement inFlight on completion
        FETCH_STATE.inFlightCount = math.max(0, (FETCH_STATE.inFlightCount or 1) - 1)
        return true
    end

    local responseText = tostring(raw or "")

    if #responseText > 500 then
        responseText = string.sub(responseText, 1, 500)
    end

    log(string.format(
        "REPORT_FAILED HTTP=%s error=%s source=%s page=%s servers=%d taskId=%s response=%s",
        tostring(code),
        tostring(err),
        source,
        tostring(taskInfo.pageIndex),
        serverCount,
        string.sub(taskId, 1, 8),
        responseText
    ), "error")

    -- V2.4: Decrement inFlight on completion
    FETCH_STATE.inFlightCount = math.max(0, (FETCH_STATE.inFlightCount or 1) - 1)
    return false
  end

  local function fetchTask(taskInfo)
    local task = taskInfo
    if not task then return end
    if task.action == "WAIT" then
      local waitSec = (task.waitMs or 5000) / 1000
      log(string.format("WAIT: %ds (reason: %s)", waitSec, task.reason or "none"))
      return
    end
    if task.action ~= "FETCH" then
      log("Unknown task action: " .. tostring(task.action), "warn")
      return
    end

    -- Validate Runtime ID (strict)
    if not task.runtimeId or not FETCH_STATE.runtimeId then
      log("Task or Client missing Runtime ID, skipping", "error")
      return
    end

    if task.runtimeId ~= FETCH_STATE.runtimeId then
      log(string.format("Task Runtime mismatch: task=%s client=%s, skipping",
        tostring(task.runtimeId), tostring(FETCH_STATE.runtimeId)), "warn")
      return
    end

    local source = task.source or "Asc"
    local cursor = task.cursor
    local ok, data = fetchRobloxAPI(SharedConfig.PLACE_ID, source, cursor)
    if not ok then
      log("Roblox fetch failed: " .. tostring(data), "error")
      post("/api/hop/fetcher/fail", {
        collectorId = FETCH_STATE.collectorId,
        leaseToken = FETCH_STATE.leaseToken,
        runtimeId = FETCH_STATE.runtimeId,
        taskId = task.taskId,
        placeId = SharedConfig.PLACE_ID,
        source = source,
        error = tostring(data),
      })
      return
    end
    local servers = parseServers(data)
    reportServers(task, servers, data.nextPageCursor)
  end

  -- V2.4: Delay claim tới khi join() success
  task.spawn(function()
    while not getgenv().CLIENT_JOINED do
      task.wait(0.5)
    end
    log("Join confirmed, claiming fetcher...", "info")
    claim()
  end)

  -- Heartbeat loop với auto-reclaim và STANDBY retry
  task.spawn(function()
    while true do
      if FETCH_STATE.status == "CLAIMED" then
        task.wait(20)
        heartbeat()
      elseif FETCH_STATE.status == "STANDBY" then
        task.wait(30 + math.random(0, 30))
        tryClaimOnce()
      elseif FETCH_STATE.status == "LEASE_LOST" then
        log("Lease lost - attempting reclaim...", "warn")
        if reclaimAfterRestart() then
          log("Reclaim successful, restarting fetch loops", "info")
        else
          task.wait(10)
        end
      else
        task.wait(5)
      end
    end
  end)

  -- Fetch loop with dynamic timing
  task.spawn(function()
      local tickCount = 0
      local nextFetchDelay = SharedConfig.FETCH_INTERVAL or 30

      while true do
        if FETCH_STATE.status == "CLAIMED" then
          tickCount = tickCount + 1
          task.wait(nextFetchDelay)

          local taskData = getTask()
          if taskData then
            -- V2.4: Reject task if runtime changed (generation shifted)
            if SESSION_CONTEXT and SESSION_CONTEXT.runtimeId and FETCH_STATE.runtimeId ~= SESSION_CONTEXT.runtimeId then
              log("REJECT: stale generation (runtime changed) - runtimeId=" .. tostring(FETCH_STATE.runtimeId) .. " vs " .. tostring(SESSION_CONTEXT.runtimeId), "warn")
              FETCH_STATE.inFlightCount = math.max(0, (FETCH_STATE.inFlightCount or 1) - 1)
            elseif taskData.action == "WAIT" then
              local waitSec = (taskData.waitMs or 5000) / 1000
              log(string.format("WAIT: %ds (reason: %s)", waitSec, taskData.reason or "none"))
              nextFetchDelay = waitSec
            elseif taskData.action == "FETCH" then
              fetchTask(taskData)
              nextFetchDelay = SharedConfig.FETCH_INTERVAL or 30
            else
              log("Unknown task action: " .. tostring(taskData.action), "warn")
              nextFetchDelay = 10
            end
          else
            nextFetchDelay = 10
          end
        elseif FETCH_STATE.status == "LEASE_LOST" then
          log("Fetch loop paused - waiting for reclaim", "warn")
          task.wait(5)
          nextFetchDelay = SharedConfig.FETCH_INTERVAL or 30
        else
          task.wait(5)
          nextFetchDelay = SharedConfig.FETCH_INTERVAL or 30
        end
      end
    end)

  -- Phase 1: Stop Fetcher before Teleport
  local function stopFetcherBeforeTeleport()
    if FETCH_STATE.status == "CLAIMED" then
      FETCH_STATE.status = "STOPPING"
      log("State: STOPPING - no new tasks")

      -- V2.4: Wait for in-flight tasks instead of fixed 5s
      local deadline = tick() + 10
      while tick() < deadline do
        if FETCH_STATE.inFlightCount <= 0 then
          log("All in-flight tasks drained")
          break
        end
        task.wait(0.1)
      end
      if FETCH_STATE.inFlightCount > 0 then
        log("Force stop: " .. FETCH_STATE.inFlightCount .. " tasks still in-flight")
      end
    end
  end

  -- Phase 1: Release Fetcher Claim
  local function releaseFetcherClaim()
    if FETCH_STATE.status == "STOPPING" and FETCH_STATE.collectorId then
      FETCH_STATE.status = "RELEASING"
      log("State: RELEASING")

      local ok, body = post("/api/hop/fetcher/stop", {
        collectorId = FETCH_STATE.collectorId,
        leaseToken = FETCH_STATE.leaseToken,
        placeId = SharedConfig.PLACE_ID,
      })
      log("Stop result: " .. tostring(ok))

      local releaseOk, releaseBody = post("/api/hop/fetcher/release", {
        collectorId = FETCH_STATE.collectorId,
        leaseToken = FETCH_STATE.leaseToken,
        placeId = SharedConfig.PLACE_ID,
      })

      if releaseOk then
        FETCH_STATE.status = "RELEASED"
        FETCH_STATE.inFlightCount = 0  -- V2.4: Clear in-flight counter
        log("State: RELEASED - ready for re-claim")
        return true
      else
        log("Release failed, cannot proceed: " .. tostring(releaseBody and releaseBody.error or "unknown"), "error")
        FETCH_STATE.status = "CLAIMED"  -- Revert to claimed
        return false
      end
    end
  end

  -- Phase 1: Retry Claim on new server (max 3 attempts)
  local function retryClaimOnNewServer()
    log("Attempting Claim on new server (retry mode)", "warn")
    local maxAttempts = 3
    for attempt = 1, maxAttempts do
      log(string.format("Claim attempt %d/%d", attempt, maxAttempts), "warn")

      local ok, body = post("/api/hop/fetcher/claim", {
        account = LocalPlayer.Name,
        placeId = SharedConfig.PLACE_ID,
        jobId = game.JobId,
      })

      if ok and body and body.collectorId and body.leaseToken and body.runtimeId then
        FETCH_STATE.collectorId = body.collectorId
        FETCH_STATE.leaseToken = body.leaseToken
        FETCH_STATE.runtimeId = body.runtimeId
        FETCH_STATE.status = "CLAIMED"
        log("Claimed: collectorId=" .. tostring(body.collectorId) .. " runtimeId=" .. tostring(body.runtimeId))
        return true
      elseif body and body.code == "FETCHER_BUSY" then
        log("Claim BUSY, retrying in 2s...", "warn")
        task.wait(2)
      else
        log("Claim error: " .. tostring(body and body.error or "network"), "error")
      end
    end

    log("Claim failed after " .. tostring(maxAttempts) .. " attempts, running as Hop Client only", "error")
    FETCH_STATE.status = "STANDBY"
    return false
  end

  -- Expose callbacks to HOP Client
  getgenv().HopFetcherStop = stopFetcherBeforeTeleport
  getgenv().HopFetcherRelease = releaseFetcherClaim

  getgenv().HopFetcherStats = function()
    return { status = FETCH_STATE.status, collectorId = FETCH_STATE.collectorId, runtimeId = FETCH_STATE.runtimeId }
  end

  getgenv().HopFetcherResumeAfterTeleportFailure = function()
    if FETCH_STATE.status == "CLAIMED" then
      return true
    end
    if FETCH_STATE.status ~= "RELEASED" and FETCH_STATE.status ~= "STANDBY" then
      return false
    end
    return retryClaimOnNewServer()
  end

  log("Initialized")
end

-- ============================================================
-- PART 2: HOP CLIENT
-- ============================================================
local function initHopClient()
  print("[UNIFIED] Starting HOP Client...")

  local Config = {
    WEB_SERVER = SharedConfig.WEB_SERVER,
    HOP_API_KEY = SharedConfig.API_KEY_HOP,
    PLACE_ID = SharedConfig.PLACE_ID,
    HEARTBEAT_INTERVAL = 15,
    AUTO_REHOP_ON_DUPLICATE = true,
    TIMEOUT = SharedConfig.TIMEOUT,
  }

  -- V2.3: Check for API_KEY_HOP
  if not Config.HOP_API_KEY or Config.HOP_API_KEY == "" then
    warn("[TRACKSTAT HOP] Missing API_KEY_HOP. HOP Client disabled.")
    warn("[TRACKSTAT HOP] Configure: getgenv().TrackStatHopConfig = { API_KEY_HOP = 'your-key' }")
    getgenv().TrackStatHop = function()
      warn("[TRACKSTAT HOP] Disabled - no API_KEY_HOP configured")
      return false
    end
    getgenv().TrackStatHopStats = function()
      return {
        account = LocalPlayer.Name,
        placeId = Config.PLACE_ID,
        jobId = game.JobId,
        action = "NO_API_KEY_HOP",
        reservation = nil,
      }
    end
    return
  end

  local PENDING_PATH = "trackstat_hop_pending_" .. LocalPlayer.Name .. ".json"
  local currentReservation = nil
  local stopping = false
  local lastAction = ""

  -- V2.4: Immutable Session context (set after join success)
  local SESSION_CONTEXT = nil

  -- V2.4: State Machine
  local HOP_STATE = {
    IDLE = "IDLE",
    REGISTERING = "REGISTERING",
    ACTIVE = "ACTIVE",
    REHOP_VERIFY = "REHOP_VERIFY",
    QUEUED = "QUEUED",
    WAITING_SLOT = "WAITING_SLOT",
    RESERVED = "RESERVED",
    STOPPING_FETCHER = "STOPPING_FETCHER",
    RELEASING_FETCHER = "RELEASING_FETCHER",
    TELEPORTING = "TELEPORTING",
    CONFIRMING_JOIN = "CONFIRMING_JOIN",
    JOINED = "JOINED",
    RECOVERING = "RECOVERING"
  }

  local hopState = HOP_STATE.IDLE
  local duplicateCount = 0
  local lastDuplicateReason = nil
  local lastHopAttemptMs = 0
  local requestId = nil

  local function nowMs()
    local ok, ms = pcall(function() return DateTime.now().UnixTimestampMillis end)
    if ok and type(ms) == "number" then return ms end
    return os.time() * 1000
  end

  local function getWriteFile()
    return writefile or (syn and syn.writefile) or (fluxus and fluxus.writefile)
  end

  local function getReadFile()
    return readfile or (syn and syn.readfile) or (fluxus and fluxus.readfile)
  end

  local function savePending(data)
    local writeFn = getWriteFile()
    if not writeFn then
      print("[TRACKSTAT HOP] DEBUG: writefile not available")
      return false
    end
    if data then
      local expiresAt = tonumber(data.expiresAt)
      if not data.reservationId or not data.jobId or not data.leaseToken or not data.runtimeId or not expiresAt then
        print("[TRACKSTAT HOP] DEBUG: cannot save incomplete reservation")
        return false
      end
      data.expiresAt = expiresAt
    end
    local ok, encoded = pcall(function() return data and HttpService:JSONEncode(data) or "" end)
    if not ok then
      print("[TRACKSTAT HOP] DEBUG: JSON encode failed - " .. tostring(encoded))
      return false
    end
    local writeOk, writeErr = pcall(writeFn, PENDING_PATH, encoded)
    if writeOk then
      if data then
        print("[TRACKSTAT HOP] DEBUG: saved pending reservationId=" .. tostring(data.reservationId) .. " jobId=" .. tostring(data.jobId) .. " runtimeId=" .. tostring(data.runtimeId) .. " expiresAt=" .. tostring(data.expiresAt))
      else
        print("[TRACKSTAT HOP] DEBUG: cleared pending")
      end
      return true
    else
      print("[TRACKSTAT HOP] DEBUG: writefile failed - " .. tostring(writeErr))
      return false
    end
  end

  local function loadPending()
    local readFn = getReadFile()
    if not readFn then
      print("[TRACKSTAT HOP] DEBUG: readfile not available")
      return nil
    end
    local ok, raw = pcall(readFn, PENDING_PATH)
    if not ok or type(raw) ~= "string" or raw == "" then
      print("[TRACKSTAT HOP] DEBUG: pending file unavailable")
      return nil
    end
    local okDecode, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not okDecode or type(data) ~= "table" then
      print("[TRACKSTAT HOP] DEBUG: pending JSON invalid")
      return nil
    end
    if not data.reservationId or not data.jobId or not data.leaseToken then
      print("[TRACKSTAT HOP] DEBUG: incomplete reservation data")
      return nil
    end
    local expiresAt = tonumber(data.expiresAt)
    if not data.runtimeId then
      print("[TRACKSTAT HOP] DEBUG: no runtimeId in saved data")
      return nil
    end
    if not expiresAt then
      print("[TRACKSTAT HOP] DEBUG: no valid expiresAt in saved data")
      return nil
    end
    local currentTime = nowMs()
    if expiresAt <= currentTime then
      print("[TRACKSTAT HOP] DEBUG: reservation expired expiresAt=" .. tostring(expiresAt) .. " now=" .. tostring(currentTime))
      return nil
    end
    data.expiresAt = expiresAt

    -- Check if Fetcher runtime matches
    local statsFn = getgenv().HopFetcherStats
    if type(statsFn) == "function" then
      local statsOk, stats = pcall(statsFn)
      if statsOk and type(stats) == "table" and stats.runtimeId then
        if tostring(data.runtimeId) ~= tostring(stats.runtimeId) then
          print("[TRACKSTAT HOP] DEBUG: pending runtime mismatch saved=" .. tostring(data.runtimeId) .. " current=" .. tostring(stats.runtimeId))
          return nil
        end
      end
    end

    print("[TRACKSTAT HOP] DEBUG: loaded pending reservation reservationId=" .. tostring(data.reservationId) .. " jobId=" .. tostring(data.jobId) .. " runtimeId=" .. tostring(data.runtimeId))
    return data
  end

  local function post(path, payload)
    if not http then return false, nil, "no request function" end
    local okBody, body = pcall(function() return HttpService:JSONEncode(payload or {}) end)
    if not okBody then return false, nil, tostring(body) end
    local ok, response = pcall(function()
      return http({
        Url = Config.WEB_SERVER .. path,
        Method = "POST",
        Headers = { ["Content-Type"] = "application/json", ["x-api-key"] = Config.HOP_API_KEY },
        Body = body,
        Timeout = Config.TIMEOUT,
      })
    end)
    if not ok or type(response) ~= "table" then return false, nil, tostring(response) end
    local code = tonumber(response.StatusCode or response.Status) or 0
    local parsed = nil
    local raw = response.Body or response.body
    if type(raw) == "string" and raw ~= "" then
      pcall(function() parsed = HttpService:JSONDecode(raw) end)
    end
    return code >= 200 and code < 300, parsed, "HTTP " .. tostring(code)
  end

  local function register()
    -- V2.4: Retry register lúc khởi chạy với exponential backoff
    hopState = HOP_STATE.REGISTERING

    -- Jitter trước lần đầu
    task.wait(math.random() * 10)

    local backoffs = {5, 10, 20}  -- seconds
    local attempt = 0

    while true do
      attempt = attempt + 1
      local ok, body, err = post("/api/hop/register", { account = LocalPlayer.Name, placeId = Config.PLACE_ID, jobId = game.JobId })

      if ok and body then
        if body.hopApiKey then
          warn("[TRACKSTAT HOP] Backend still returns hopApiKey (security issue). Ignoring it.")
        end
        lastAction = body.action or "CONTINUE"

        if body.action == "REHOP" then
          -- V2.4: REHOP từ Register được phân loại, ghi vào state
          hopState = HOP_STATE.REHOP_VERIFY
          lastDuplicateReason = body.reason or "UNKNOWN_REHOP"
          duplicateCount = 1
          print("[TRACKSTAT HOP] Register: REHOP with reason=" .. lastDuplicateReason .. " (count=1)")
          return false
        else
          hopState = HOP_STATE.ACTIVE
          duplicateCount = 0
          lastDuplicateReason = nil
          print("[TRACKSTAT HOP] Registered: action=" .. lastAction)
          return true
        end
      end

      -- Network error hoặc server error - retry
      local waitTime = (backoffs[attempt] or 30) + math.random(0, 5)
      warn("[TRACKSTAT HOP] Register failed (attempt " .. attempt .. "): " .. tostring(body and body.error or err) .. " - retrying in " .. waitTime .. "s")

      if attempt <= 3 then
        task.wait(waitTime)
      else
        -- After 3 attempts, wait 30-60s with jitter, then reset counter
        task.wait(waitTime)
        attempt = 2
      end
    end
  end

  local function requestHop(source, reason)
    -- V2.4: Unified HOP request entry point
    -- source = "FARM" | "STARTUP" | "HEARTBEAT" | "JOIN"
    -- reason = "DUPLICATE_JOB" | "BUCKET_EMPTY" | etc.

    -- Block requests during critical transitions
    local BLOCKED = {
      [HOP_STATE.STOPPING_FETCHER] = true,
      [HOP_STATE.RELEASING_FETCHER] = true,
      [HOP_STATE.TELEPORTING] = true,
      [HOP_STATE.CONFIRMING_JOIN] = true,
      [HOP_STATE.RECOVERING] = true,
      [HOP_STATE.QUEUED] = true,
      [HOP_STATE.WAITING_SLOT] = true,
      [HOP_STATE.RESERVED] = true,
    }
    if BLOCKED[hopState] then
      print("[TRACKSTAT HOP] RequestHop ignored: blocked during " .. hopState)
      return false
    end

    hopState = HOP_STATE.QUEUED
    lastDuplicateReason = reason
    print("[TRACKSTAT HOP] RequestHop: source=" .. source .. " reason=" .. reason)

    -- V2.4: Enqueue request to Global Scheduler
    local ok, body = post("/api/hop/enqueue", { account = LocalPlayer.Name, source = source, reason = reason, placeId = Config.PLACE_ID, currentJobId = game.JobId })
    if not ok or not body or not body.ok then
      print("[TRACKSTAT HOP] RequestHop: Enqueue failed, retrying reserve directly")
      hopState = HOP_STATE.WAITING_SLOT
      return true  -- Still queue, let heartbeat retry
    end

    requestId = body.requestId  -- V2.4: Store requestId for claim-slot
    print("[TRACKSTAT HOP] RequestHop: Enqueued successfully (requestId=" .. (requestId or "nil") .. ")")
    hopState = HOP_STATE.WAITING_SLOT
    return true
  end

  local function releaseReservation(cooldown, dead)
    local r = currentReservation
    if not r then return end

    -- V2.4: Don't delete pending until Backend confirms release
    local ok, body = post("/api/hop/release", {
      account = LocalPlayer.Name,
      placeId = Config.PLACE_ID,
      jobId = r.jobId,
      reservationId = r.reservationId,
      leaseToken = r.leaseToken,
      runtimeId = r.runtimeId,
      cooldown = cooldown == true,
      dead = dead == true
    })

    if ok and body and body.ok then
      currentReservation = nil
      savePending(nil)
      print("[TRACKSTAT HOP] Release confirmed")
    else
      print("[TRACKSTAT HOP] WARN: Release might have failed, keeping pending reservation")
    end
  end

  local function confirmJoin()
    hopState = HOP_STATE.CONFIRMING_JOIN
    local r = currentReservation
    if not r then
      print("[TRACKSTAT HOP] confirmJoin: no reservation")
      hopState = HOP_STATE.ACTIVE
      return false
    end

    -- V2.4: Check reservation expiry
    local nowMsVal = nowMs()
    if r.expiresAt and r.expiresAt <= nowMsVal then
      print("[TRACKSTAT HOP] confirmJoin: reservation expired")
      currentReservation = nil
      savePending(nil)
      hopState = HOP_STATE.ACTIVE
      return false
    end

    print("[TRACKSTAT HOP] confirmJoin - reservation=" .. tostring(r.reservationId) .. " jobId=" .. tostring(r.jobId) .. " currentJobId=" .. tostring(game.JobId))
    if r.jobId ~= game.JobId then
      print("[TRACKSTAT HOP] confirmJoin: Job ID mismatch, clearing pending and re-registering")
      hopState = HOP_STATE.RECOVERING
      releaseReservation(false)
      hopState = HOP_STATE.IDLE
      return register()
    end

    -- V2.4: Retry Join with exponential backoff
    local joinOk = false
    local backoffMs = 500
    for attempt = 1, 3 do
      if attempt > 1 then
        print("[TRACKSTAT HOP] confirmJoin: Retry #" .. attempt .. " after " .. backoffMs .. "ms")
        task.wait(backoffMs / 1000)
        backoffMs = backoffMs * 2
      end

      local ok, body = post("/api/hop/join", { account = LocalPlayer.Name, placeId = Config.PLACE_ID, jobId = game.JobId, reservationId = r.reservationId, leaseToken = r.leaseToken })

      if ok and body and body.ok then
        if body.action == "CONTINUE" then
          currentReservation = nil
          savePending(nil)
          lastAction = "JOINED"
          hopState = HOP_STATE.JOINED
          -- V2.4: Capture immutable session context
          SESSION_CONTEXT = {
            account = LocalPlayer.Name,
            placeId = Config.PLACE_ID,
            jobId = game.JobId,
            generation = body.generation or 1,
            currentSessionId = body.currentSessionId,
            runtimeId = body.runtimeId,
            capturedAt = nowMs(),
          }
          getgenv().CLIENT_JOINED = true  -- Signal fetcher to start claiming
          print("[TRACKSTAT HOP] confirmJoin: SUCCESS - SESSION_CONTEXT=" .. HttpService:JSONEncode(SESSION_CONTEXT))
          return true
        elseif body.action == "REHOP" then
          -- V2.4: Backend rejected Join, requeue
          lastAction = body.reason or "REHOP"
          hopState = HOP_STATE.REHOP_VERIFY
          lastDuplicateReason = body.reason
          duplicateCount = 0
          print("[TRACKSTAT HOP] confirmJoin: Join rejected, requeue reason=" .. lastAction)
          requestHop("JOIN", body.reason)
          return false
        end
      elseif ok and body and body.ok == false then
        currentReservation = nil
        savePending(nil)
        lastAction = "JOIN_REJECTED"
        hopState = HOP_STATE.ACTIVE
        print("[TRACKSTAT HOP] confirmJoin: Backend rejected")
        return false
      end
    end

    -- V2.4: All retries exhausted, keep pending for next startup
    lastAction = "JOIN_PENDING"
    print("[TRACKSTAT HOP] confirmJoin: All retries failed, keeping pending")
    hopState = HOP_STATE.ACTIVE
    return true
  end

  local function stopFetcher()
    -- Phase 1: Signal Fetcher to stop before teleport
    if getgenv().HopFetcherStop then
      pcall(getgenv().HopFetcherStop)
    end
  end

  local function releaseFetcher()
    -- Phase 1: Release old Fetcher Claim before Teleport
    if getgenv().HopFetcherRelease then
      pcall(getgenv().HopFetcherRelease)
    end
  end

  local function reserveAndTeleport()
    -- V2.4: Strict teleport sequence - hold hopBusy (via state machine) until Join or Recovery
    if hopState ~= HOP_STATE.RESERVED and hopState ~= HOP_STATE.WAITING_SLOT then
      print("[TRACKSTAT HOP] DEBUG: reserveAndTeleport not in right state: " .. hopState)
      return false
    end

    if stopping then return false end

    hopState = HOP_STATE.STOPPING_FETCHER
    print("[TRACKSTAT HOP] Phase 1: STOPPING fetcher before teleport")
    stopFetcher()
    task.wait(1)  -- Brief wait for stop to propagate

    hopState = HOP_STATE.RELEASING_FETCHER
    print("[TRACKSTAT HOP] Phase 1: RELEASING fetcher claim")
    releaseFetcher()
    task.wait(1)  -- Wait for release to complete

    -- V2.4: Verify savePending was successful before teleport
    if not currentReservation then
      print("[TRACKSTAT HOP] ERROR: No reservation to teleport with!")
      hopState = HOP_STATE.ACTIVE
      return false
    end

    -- V2.4: Ensure pending is saved before teleport (crash recovery)
    if not savePending(currentReservation) then
      print("[TRACKSTAT HOP] ERROR: Failed to save pending reservation before teleport!")
      hopState = HOP_STATE.ACTIVE
      return false
    end

    hopState = HOP_STATE.TELEPORTING
    print("[TRACKSTAT HOP] Phase 1: TELEPORTING to new server")
    local teleOk, teleErr = pcall(function()
      TeleportService:TeleportToPlaceInstance(Config.PLACE_ID, currentReservation.jobId, LocalPlayer)
    end)
    if not teleOk then
      print("[TRACKSTAT HOP] ERROR: Teleport pcall failed - " .. tostring(teleErr))
      lastAction = "TELEPORT_ERROR"
      hopState = HOP_STATE.RECOVERING
      releaseReservation(true)
      hopState = HOP_STATE.ACTIVE
      return false
    end

    -- Keep state TELEPORTING until Join succeeds or new Startup runs
    print("[TRACKSTAT HOP] Teleport initiated, waiting for Join confirmation on new server")
    return true
  end

  local function claimSlot()
    -- V2.4: Poll for granted slot and reserve if available
    if hopState ~= HOP_STATE.WAITING_SLOT then return end

    local ok, body = post("/api/hop/claim-slot", {
      account = LocalPlayer.Name,
      placeId = Config.PLACE_ID,
      requestId = requestId  -- V2.4: Send requestId to identify which request was granted
    })
    if not ok then
      print("[TRACKSTAT HOP] claimSlot: network error, will retry next heartbeat")
      return
    end

    if body and body.waiting == true then
      print("[TRACKSTAT HOP] claimSlot: still waiting for slot")
      return
    end

    if not body or not body.ok then
      print("[TRACKSTAT HOP] claimSlot: no slot available or error (code: " .. (body and body.error or "unknown") .. ")")
      return
    end

    -- Slot granted! Convert response and save pending
    currentReservation = {
      reservationId = body.reservationId,
      jobId = body.jobId,
      leaseToken = body.leaseToken,
      runtimeId = body.runtimeId,
      expiresAt = nowMs() + (body.expiresIn or 90000)
    }
    hopState = HOP_STATE.RESERVED
    print("[TRACKSTAT HOP] claimSlot: slot granted, saving pending (requestId=" .. (requestId or "nil") .. ")")
    savePending(currentReservation)
    task.spawn(reserveAndTeleport)
  end

  local function heartbeat()
    if stopping then return end

    local ok, body = post("/api/hop/heartbeat", { account = LocalPlayer.Name, placeId = Config.PLACE_ID, jobId = game.JobId })
    if not ok or not body then return end

    if body.action == "CONTINUE" then
      -- V2.4: Reset duplicate counter on CONTINUE
      if duplicateCount > 0 then
        print("[TRACKSTAT HOP] Heartbeat: CONTINUE, resetting duplicate_count from " .. duplicateCount)
        duplicateCount = 0
        lastDuplicateReason = nil
      end
      -- Only set ACTIVE if not in active hop flow
      if hopState == HOP_STATE.IDLE or hopState == HOP_STATE.REHOP_VERIFY or hopState == HOP_STATE.JOINED then
        hopState = HOP_STATE.ACTIVE
      end
      return
    end

    if body.action == "REHOP" then
      -- V2.4: REHOP from Heartbeat - queue request, don't teleport immediately
      local reason = body.reason or "UNKNOWN"

      -- Block REHOP during critical transitions
      local BLOCKED = {
        [HOP_STATE.STOPPING_FETCHER] = true,
        [HOP_STATE.RELEASING_FETCHER] = true,
        [HOP_STATE.TELEPORTING] = true,
        [HOP_STATE.CONFIRMING_JOIN] = true,
        [HOP_STATE.RECOVERING] = true,
        [HOP_STATE.QUEUED] = true,
        [HOP_STATE.WAITING_SLOT] = true,
        [HOP_STATE.RESERVED] = true,
      }
      if BLOCKED[hopState] then
        print("[TRACKSTAT HOP] Heartbeat: REHOP blocked during " .. hopState)
        return
      end

      if reason == lastDuplicateReason then
        duplicateCount = duplicateCount + 1
      else
        duplicateCount = 1
        lastDuplicateReason = reason
      end

      print("[TRACKSTAT HOP] Heartbeat: REHOP reason=" .. reason .. " count=" .. duplicateCount)

      -- SOFT REHOP: wait 2 confirmations before enqueueing
      if duplicateCount >= 2 then
        print("[TRACKSTAT HOP] Heartbeat: Enough REHOP confirmations, enqueueing HOP request")
        requestHop("HEARTBEAT", reason)
      else
        print("[TRACKSTAT HOP] Heartbeat: Need " .. (2 - duplicateCount) .. " more confirmations before HOP")
      end
    end
  end

  TeleportService.TeleportInitFailed:Connect(function(player, result, message)
    if player ~= LocalPlayer or not currentReservation then return end

    hopState = HOP_STATE.RECOVERING

    -- V2.4: Classify error: cooldown server only if server-specific issue
    local shouldCooldown = false
    local isDead = false
    local resultStr = tostring(result.Name or result)
    local msgStr = tostring(message or "")

    -- Server-specific errors (cooldown server)
    if resultStr:find("GameFull") or msgStr:find("full") then
      shouldCooldown = true
      print("[TRACKSTAT HOP] TeleportInitFailed: Server full - cooldown and retry")
    elseif resultStr:find("InvalidPlace") or resultStr:find("GameEnded") then
      shouldCooldown = true
      isDead = true
      print("[TRACKSTAT HOP] TeleportInitFailed: Server closed/invalid - long cooldown (30m) and retry")
    elseif resultStr:find("Unauthorized") or resultStr:find("PrivateServer") then
      shouldCooldown = true
      print("[TRACKSTAT HOP] TeleportInitFailed: Access denied - cooldown and retry")
    else
      -- Client/network errors - keep pending, will retry on next startup
      print("[TRACKSTAT HOP] TeleportInitFailed: " .. resultStr .. " - " .. msgStr .. " (client error, keep pending)")
      hopState = HOP_STATE.ACTIVE
      -- Resume Fetcher if teleport client error
      task.spawn(function()
        local resumeFn = getgenv().HopFetcherResumeAfterTeleportFailure
        if type(resumeFn) == "function" then
          local ok, resumed = pcall(resumeFn)
          if ok and resumed == true then
            print("[TRACKSTAT HOP] Fetcher recovered after Teleport client error")
          end
        end
      end)
      return
    end

    -- V2.4: Server-specific error: release and requeue
    releaseReservation(shouldCooldown, isDead)

    -- Try to resume Fetcher on old server if teleport failed
    task.spawn(function()
      local resumeFn = getgenv().HopFetcherResumeAfterTeleportFailure
      if type(resumeFn) == "function" then
        local ok, resumed = pcall(resumeFn)
        if ok and resumed == true then
          print("[TRACKSTAT HOP] Fetcher recovered after Teleport failure")
        else
          warn("[TRACKSTAT HOP] Fetcher recovery failed")
        end
      end
    end)

    hopState = HOP_STATE.ACTIVE
  end)

  currentReservation = loadPending()

  if currentReservation then
    print("[TRACKSTAT HOP] Startup: Loaded pending reservation, attempting Join recovery")
    hopState = HOP_STATE.CONFIRMING_JOIN
    local accepted = confirmJoin()
    if not accepted then
      print("[TRACKSTAT HOP] Startup: Join recovery failed, will retry on next heartbeat or Teleport")
    end
  else
    print("[TRACKSTAT HOP] Startup: No pending, registering fresh")
    hopState = HOP_STATE.IDLE
    local accepted = register()
    if accepted then
      print("[TRACKSTAT HOP] Startup: Register successful, auto-joining to unlock fetcher")
      local ok, body = post("/api/hop/join", { account = LocalPlayer.Name, placeId = Config.PLACE_ID, jobId = game.JobId })
      if ok and body and body.ok then
        SESSION_CONTEXT = {
          account = LocalPlayer.Name,
          placeId = Config.PLACE_ID,
          jobId = game.JobId,
          generation = body.generation or 1,
          currentSessionId = body.currentSessionId,
          runtimeId = body.runtimeId,
          capturedAt = nowMs(),
        }
        getgenv().CLIENT_JOINED = true
        print("[TRACKSTAT HOP] Startup: Join successful - SESSION_CONTEXT captured, fetcher unlock signal sent")
      else
        print("[TRACKSTAT HOP] Startup: Join failed but continuing (will retry on next heartbeat)")
      end
    else
      print("[TRACKSTAT HOP] Startup: Register returned REHOP, will wait for Heartbeat to claim slot")
    end
  end

  -- Heartbeat loop
  task.spawn(function()
    while not stopping do
      task.wait(Config.HEARTBEAT_INTERVAL)
      heartbeat()
    end
  end)

  -- Poll claim-slot loop (riêng, nhanh hơn heartbeat)
  local claiming = false
  task.spawn(function()
    while not stopping do
      task.wait(3 + math.random())
      if hopState == HOP_STATE.WAITING_SLOT and not claiming then
        claiming = true
        pcall(claimSlot)
        claiming = false
      end
    end
  end)

  -- V2.4: TrackStatHop() enqueues request, not directly teleport
  getgenv().TrackStatHop = function()
    return requestHop("FARM", "BUCKET_EMPTY")
  end

  getgenv().TrackStatHopStats = function()
    return {
      account = LocalPlayer.Name,
      placeId = Config.PLACE_ID,
      jobId = game.JobId,
      action = lastAction,
      reservation = currentReservation and currentReservation.reservationId or nil,
      sessionContext = SESSION_CONTEXT,
    }
  end

  -- V2.4: Expose SESSION_CONTEXT globally for worker threads
  getgenv().HopSessionContext = function()
    return SESSION_CONTEXT
  end

  print("[TRACKSTAT HOP] Ready. Call TrackStatHop() to request a backend-selected server.")
end

-- ============================================================
-- PART 3: TRACKSTAT UPLOADER
-- ============================================================
local function initTrackStat()
  print("[UNIFIED] Starting TrackStat Uploader...")

  -- V2.3: Check for API_KEY_INGEST
  if not SharedConfig.API_KEY_INGEST or SharedConfig.API_KEY_INGEST == "" then
    warn("[TRACKSTAT] Missing API_KEY_INGEST. Uploader disabled.")
    warn("[TRACKSTAT] Configure: getgenv().TrackStatConfig = { API_KEY_INGEST = 'your-key' }")
    getgenv().TrackStatStats = function()
      return { uploaded = 0, failed = 0, status = "NO_API_KEY_INGEST" }
    end
    return
  end

  local ReplicatedStorage = game:GetService("ReplicatedStorage")
  local okSave, SaveModule = pcall(function()
    return require(ReplicatedStorage:WaitForChild("Library"):WaitForChild("Client"):WaitForChild("Save"))
  end)
  if not okSave or not SaveModule then
    warn("[TRACKSTAT] Save module unavailable")
    return
  end

  local Config = {
    WEB_SERVER = SharedConfig.WEB_SERVER,
    API_KEY = SharedConfig.API_KEY_INGEST,
    UPLOAD_INTERVAL = 30,
    AUTO_UPLOAD = true,
    TIMEOUT = SharedConfig.TIMEOUT,
  }

  local QUEUE_PATH = "trackstat_queue_" .. LocalPlayer.Name .. ".json"
  local RetryQueue = {}
  local UploadCount = 0
  local FailCount = 0
  local StopReason = nil

  local function log(msg, level)
    level = level or "info"
    local prefixes = { info = "[OK]", warn = "[WARN]", error = "[ERROR]" }
    print(string.format("[TRACKSTAT] %s %s", prefixes[level] or "[*]", msg))
  end

  local function formatNumber(n)
    n = tonumber(n) or 0
    if n >= 1e9 then return string.format("%.2fB", n / 1e9) end
    if n >= 1e6 then return string.format("%.2fM", n / 1e6) end
    if n >= 1e3 then return string.format("%.2fK", n / 1e3) end
    return tostring(n)
  end

  local function nowMs()
    local ok, ms = pcall(function() return DateTime.now().UnixTimestampMillis end)
    if ok and type(ms) == "number" then return ms end
    return os.time() * 1000
  end

  local function getVariant(data)
    if data.sh or data.Shiny then return "Shiny" end
    if data.pt == 1 or data.gd or data.Gold then return "Gold" end
    if data.pt == 2 or data.rb or data.Rainbow then return "Rainbow" end
    return "Normal"
  end

  local function eachItem(inv, onItem)
    local seen = {}
    local function scan(classItems, defaultCategory)
      if type(classItems) ~= "table" then return end
      for _, data in pairs(classItems) do
        if type(data) == "table" and data.id ~= nil and not seen[data] then
          seen[data] = true
          onItem(data, defaultCategory)
        end
      end
    end
    for category, catItems in pairs(inv) do
      if category ~= "Currency" and category ~= "_uq" and category ~= "ct" then
        scan(catItems, category)
      end
    end
    if type(inv._uq) == "table" then scan(inv._uq.ct, nil) end
    scan(inv.ct, nil)
  end

  local function itemAmount(data)
    return tonumber(data._am or data.am or data.amount or data.Amount or 1) or 1
  end

  local function sanitizeNumber(v, label)
    local n = tonumber(v)
    if not n or n ~= n then n = 0 end
    if n < 0 then n = 0 end
    if n > 1e15 then n = 1e15 end
    return n
  end

  local function aggregateItems(inv)
    local aggregated = {}
    eachItem(inv, function(data, category)
      local variant = getVariant(data)
      local id = tostring(data.id)
      local key = tostring(category or "Unique") .. "|" .. id .. "|" .. variant
      local entry = aggregated[key]
      if not entry then
        entry = { category = tostring(category or "Unique"), id = id, variant = variant, amount = 0 }
        aggregated[key] = entry
      end
      entry.amount = entry.amount + itemAmount(data)
    end)
    local result = {}
    for _, item in pairs(aggregated) do table.insert(result, item) end
    return result
  end

  local function sumItemAmount(inv, targetNames)
    if type(targetNames) == "string" then targetNames = { targetNames } end
    local wanted = {}
    for _, name in ipairs(targetNames) do wanted[tostring(name)] = true end
    local total = 0
    eachItem(inv, function(data)
      if wanted[tostring(data.id)] then total = total + itemAmount(data) end
    end)
    return total
  end

  local function countHugePotion(inv)
    local potion = type(inv.Potion) == "table" and inv.Potion or {}
    local total = 0
    for _, item in pairs(potion) do
      if type(item) == "table" then
        local itemId = item.id or item._id or item.ID
        if tostring(itemId or "") == "Huge" then
          total = total + itemAmount(item)
        end
      end
    end
    return total
  end

  local function collectData()
    local okCall, save = pcall(function() return SaveModule.Get() end)
    if not okCall or type(save) ~= "table" or type(save.Inventory) ~= "table" then
      return nil, "Save.Inventory unavailable"
    end
    local inv = save.Inventory
    local currencies = {}
    if type(inv.Currency) == "table" then
      for _, c in pairs(inv.Currency) do
        if type(c) == "table" and c.id ~= nil then
          local id = tostring(c.id)
          currencies[id] = (currencies[id] or 0) + itemAmount(c)
        end
      end
    end
    local pd = type(save.PlayerData) == "table" and save.PlayerData or {}
    local rank = save.Rank or save.rank or save.PlayerRank or pd.Rank or pd.rank
    local rebirths = save.Rebirths or save.rebirths or save.Rebirth or save.rebirth or pd.Rebirths or pd.rebirths or pd.Rebirth
    return {
      account = LocalPlayer.Name,
      ts = nowMs(),
      gems = sanitizeNumber(currencies["Diamonds"] or 0, "gems"),
      coins = sanitizeNumber(currencies["Coins"] or currencies["Coin"] or currencies["Money"] or 0, "coins"),
      currencies = currencies,
      items = aggregateItems(inv),
      rank = rank,
      rebirths = rebirths,
      hugePotion = sanitizeNumber(countHugePotion(inv), "hugePotion"),
      bucket = sanitizeNumber(sumItemAmount(inv, { "Bucket" }), "bucket"),
      bucketMagic = sanitizeNumber(sumItemAmount(inv, { "Bucket O' Magic", "Bucket o' Magic", "Bucket O Magic", "Bucket o Magic" }), "bucketMagic"),
    }
  end

  local function postJson(path, payload)
    if not http then return false, nil, nil, "no executor request function" end
    local okBody, encoded = pcall(function() return HttpService:JSONEncode(payload) end)
    if not okBody then return false, nil, nil, "JSONEncode failed" end
    local ok, res = pcall(function()
      return http({
        Url = Config.WEB_SERVER .. path,
        Method = "POST",
        Headers = {
          ["Content-Type"] = "application/json",
          ["x-api-key"] = Config.API_KEY,
        },
        Body = encoded,
        Timeout = Config.TIMEOUT,
      })
    end)
    if not ok then return false, nil, nil, tostring(res) end
    if type(res) ~= "table" then return false, nil, nil, "empty response" end
    local code = res.StatusCode or res.Status
    local body = res.Body or res.body
    local parsed = nil
    if type(body) == "string" and body ~= "" then
      local okDecode, decoded = pcall(function() return HttpService:JSONDecode(body) end)
      if okDecode and type(decoded) == "table" then parsed = decoded end
    end
    if code and code >= 200 and code < 300 then return true, code, parsed, nil end
    return false, code, parsed, "HTTP " .. tostring(code)
  end

  local function uploadData(data)
    if not data then return false end
    local sent, code, body, err = postJson("/api/ingest", data)
    if not sent then
      if code == 403 then
        StopReason = "auth"
        log("API key bị từ chối (403). Sửa Config.API_KEY rồi chạy lại.", "error")
      else
        log("Upload failed: " .. tostring(err or code), "warn")
      end
      FailCount = FailCount + 1
      return false
    end
    UploadCount = UploadCount + 1
    return true
  end

  local function tickUpload()
    local data = collectData()
    if not data then
      log("collectData thất bại", "warn")
      return
    end
    local bodySize = #HttpService:JSONEncode(data) / 1024
    log(string.format(
      "Upload %s | Gems: %s | Coins: %s | Items: %d | Rank: %s | RB: %s | Bucket: %s | BoM: %s | Huge Potion: %s | %.1f KB",
      tostring(data.account), formatNumber(data.gems), formatNumber(data.coins), #data.items,
      tostring(data.rank or "-"), tostring(data.rebirths or "-"),
      tostring(data.bucket or 0), tostring(data.bucketMagic or 0), tostring(data.hugePotion or 0), bodySize
    ), "info")
    uploadData(data)
  end

  if Config.AUTO_UPLOAD then
    log("Starting auto-upload...", "info")
    task.spawn(function()
      tickUpload()
      while true do
        task.wait(Config.UPLOAD_INTERVAL)
        tickUpload()
      end
    end)
  end

  getgenv().TrackStatStats = function()
    return { uploaded = UploadCount, failed = FailCount }
  end
end


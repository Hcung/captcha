// Verification Queue check - mỗi 60s
setInterval(() => {
  try {
    const runtime = runtimeManager.getActiveRuntime();
    if (!runtime || runtime.status !== 'ACTIVE') return;

    const placeId = 8737899170;
    const serversDue = verificationService.getServersDue(placeId, runtime.run_id, 500);
    const serversStale = verificationService.getServerStale(placeId, runtime.run_id, 50);

    // Mark servers DUE for re-verification
    if (serversDue.length > 0) {
      console.log(`[HOP-QUEUE] Due for re-verification: ${serversDue.length} servers`);
      for (const s of serversDue) {
        verificationService.markServerDue(placeId, s.job_id, runtime.run_id);
      }
    }

    // Mark servers STALE (>20min without observation)
    if (serversStale.length > 0) {
      console.log(`[HOP-QUEUE] STALE (>20min): ${serversStale.length} servers - locking from Reserve`);
      for (const s of serversStale) {
        verificationService.markServerStale(placeId, s.job_id, runtime.run_id);
      }
    }
  } catch (err) {
    console.error('[HOP-QUEUE] check failed:', err.message);
  }
}, 60 * 1000);


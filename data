-- ============================================================
-- UNIFIED TrackStat + HOP Client + Fetcher v2.3
-- Load once: chứa đầy đủ 3 hệ thống
--
-- V2.3 Changes:
--   - Separate API_KEY_HOP and API_KEY_INGEST credentials
--   - Register no longer returns hopApiKey (security fix)
--   - All requests include x-api-key header
--   - Credential validation before subsystem init
-- ============================================================

if getgenv().TRACKSTAT_UNIFIED_LOADED then
  print("[UNIFIED] Already loaded, skipping")
  return
end
getgenv().TRACKSTAT_UNIFIED_LOADED = true

repeat task.wait() until game:IsLoaded()

local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer or Players.PlayerAdded:Wait()

if not LocalPlayer then

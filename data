// ---------- helpers ----------
const num = v => { const n = Number(v); return Number.isFinite(n) ? n : 0; };
const text = v => {
  if (v == null) return null;
  if (typeof v === 'object') return String(v.Title ?? v.Name ?? v.Rank ?? JSON.stringify(v));
  return String(v);
};

const stmts = {
  getOverviewStats: { get: () => S.overview.get(Date.now() - ONLINE_MS) },
  getCategoryTotals: { all: () => S.categoryTotals.all() },

const crypto = require('crypto');
const { db } = require('./db');

const CFG = {
  staleMs: Number(process.env.HOP_STALE_MS || 90000),
  reservationMs: Number(process.env.HOP_RESERVATION_MS || 90000),
  sessionTimeoutMs: Number(process.env.HOP_SESSION_TIMEOUT_MS || 60000),
  cooldownMs: Number(process.env.HOP_COOLDOWN_MS || 60000),
  maxPlayers: Number(process.env.HOP_MAX_PLAYERS || 0),
};

const now = () => Date.now();
const id = prefix => `${prefix}_${crypto.randomBytes(12).toString('hex')}`;
const token = () => crypto.randomBytes(24).toString('hex');

function upsertServers(placeId, rows, source, runId = 'LEGACY') {
  const ts = now();
  const col = source === 'busy' ? 'busy_seen_at' : 'low_seen_at';
  const tx = db.transaction(items => {
    for (const row of items) {
      if (!row || !row.id) continue;
      const playing = Number(row.playing) || 0;
      const maxPlayers = Number(row.maxPlayers) || 0;
      db.prepare(`
        INSERT INTO hop_servers(place_id, job_id, playing, max_players, ${col}, last_updated, cooldown_until, run_id)
        VALUES(?, ?, ?, ?, ?, ?, 0, ?)
        ON CONFLICT(place_id, job_id) DO UPDATE SET
          playing = excluded.playing,
          max_players = excluded.max_players,
          ${col} = excluded.${col},
          last_updated = excluded.last_updated,
          run_id = excluded.run_id
      `).run(placeId, String(row.id), playing, maxPlayers, ts, ts, runId);
    }
  });
  tx(rows);
  return rows.length;
}

let lastPrune = 0;
function pruneOld(ts) {
  if (ts - lastPrune < 60000) return;
  lastPrune = ts;
  db.prepare(`DELETE FROM hop_servers WHERE last_updated < ?`).run(ts - 6 * 3600000);
  db.prepare(`DELETE FROM hop_reservations WHERE status NOT IN ('RESERVED','JOINED') AND created_at < ?`).run(ts - 86400000);
}

function expireReservations(ts = now()) {
  db.prepare(`UPDATE hop_reservations SET status='EXPIRED' WHERE status IN ('RESERVED','JOINED') AND expires_at < ?`).run(ts);
  db.prepare(`UPDATE hop_sessions SET status='OFFLINE' WHERE status='ACTIVE' AND last_seen < ?`).run(ts - CFG.sessionTimeoutMs);
  pruneOld(ts);
}

function reserve({ account, placeId, currentJobId, requestId }) {
  const ts = now();
  expireReservations(ts);
  // V2.4 FIX: Only return UNUSED reservations (RESERVED), not JOINED ones from current server
  const existing = db.prepare(`
    SELECT * FROM hop_reservations
    WHERE account=? AND status='RESERVED' AND expires_at >= ?
    LIMIT 1
  `).get(account, ts);

  if (existing) {
    console.log(`[HOP] reserve: account ${account} already has valid reservation ${existing.reservation_id}`);
    return {
      reservationId: existing.reservation_id,
      jobId: existing.job_id,
      leaseToken: existing.lease_token,
      expiresAt: existing.expires_at,
      expiresIn: Math.max(0, existing.expires_at - ts)
    };
  }

  const MAX_VERIFICATION_AGE_MS = 1800000; // 30 minutes - must match verificationService.js POOL_CONFIG
  const minVerifiedTime = ts - MAX_VERIFICATION_AGE_MS;

  const getCandidates = () => db.prepare(`
    SELECT s.* FROM hop_servers s
    WHERE s.place_id = ?
      AND s.eligible = 1
      AND s.verify_status IN ('ACTIVE', 'DUE')
      AND s.playing >= 1
      AND s.playing <= 8
      AND COALESCE(s.last_verified_at, 0) >= ?
      AND s.cooldown_until <= ?
      AND (? = '' OR s.job_id <> ?)
      AND COALESCE(s.max_players, 0) > s.playing
      AND NOT EXISTS (
        SELECT 1 FROM hop_reservations r
        WHERE r.place_id=s.place_id AND r.job_id=s.job_id
          AND r.status IN ('RESERVED','JOINED') AND r.expires_at >= ?
      )
      AND NOT EXISTS (
        SELECT 1 FROM hop_sessions h
        WHERE h.place_id=s.place_id AND h.job_id=s.job_id AND h.status='ACTIVE'
      )
    ORDER BY RANDOM()
    LIMIT 20
  `).all(placeId, minVerifiedTime, ts, currentJobId || '', currentJobId || '', ts);

  let candidates = getCandidates();

  if (candidates.length === 0) {
    const activeCount = db.prepare(`
      SELECT COUNT(*) AS count FROM hop_servers
      WHERE place_id=? AND eligible=1 AND verify_status='ACTIVE'
    `).get(placeId);
    console.log(`[HOP] reserve: no candidates for ${account} @ ${placeId} (eligible: ${activeCount ? activeCount.count : 0})`);
  }

  for (const candidate of candidates) {
    const reservationId = id('RES');
    const leaseToken = token();
    const expiresAt = ts + CFG.reservationMs;
    try {
      const tx = db.transaction(() => {
        // Recheck server eligibility inside transaction (race protection)
        const stillEligible = db.prepare(`
          SELECT 1
          FROM hop_servers
          WHERE place_id = ?
            AND job_id = ?
            AND eligible = 1
            AND verify_status IN ('ACTIVE', 'DUE')
            AND playing BETWEEN 1 AND 8
            AND COALESCE(last_verified_at, 0) >= ?
            AND cooldown_until <= ?
            AND COALESCE(max_players, 0) > playing
        `).get(placeId, candidate.job_id, minVerifiedTime, ts);

        if (!stillEligible) {
          return false; // Server became ineligible
        }

        // Check reservation conflicts
        const conflict = db.prepare(`
          SELECT 1 FROM hop_reservations
          WHERE place_id=? AND job_id=?
            AND status IN ('RESERVED','JOINED')
            AND expires_at >= ?
        `).get(placeId, candidate.job_id, ts);

        if (conflict) return false;

        // V2.4 ATOMIC: If requestId provided, mark request as CONSUMED atomically
        if (requestId) {
          const req = db.prepare(`
            SELECT status FROM hop_request_queue WHERE request_id=?
          `).get(requestId);

          if (!req || req.status !== 'GRANTED') {
            return false; // Request not GRANTED anymore
          }
        }

        db.prepare(`
          INSERT INTO hop_reservations(
            reservation_id, request_id, account, place_id, job_id, lease_token,
            status, created_at, expires_at
          ) VALUES(?,?,?,?,?,?,?,?,?)
        `).run(reservationId, requestId || null, account, placeId, candidate.job_id, leaseToken, 'RESERVED', ts, expiresAt);

        // V2.4 ATOMIC: If requestId provided, mark request as CONSUMED
        if (requestId) {
          db.prepare(`
            UPDATE hop_request_queue SET status='CONSUMED', updated_at=? WHERE request_id=?
          `).run(ts, requestId);
        }

        return true;
      })();
      if (tx) {
        console.log(`[HOP] Granted: account=${account} jobId=${candidate.job_id} playing=${candidate.playing}/${candidate.max_players}`);
        return { reservationId, jobId: candidate.job_id, leaseToken, expiresAt, expiresIn: CFG.reservationMs };
      }
    } catch (e) {
      console.error('[HOP] reserve tx failed:', e.message);
    }
  }
  return null;
}

// Hybrid C: register - Register Session mới, không kích hoạt Generation
function register({ account, placeId, jobId, runtimeId, sessionId, generation }) {
  const ts = now();
  if (!jobId || String(jobId) === 'null' || String(jobId).trim() === '') {
    return { ok: false, error: 'INVALID_JOB_ID' };
  }
  if (!account || !placeId) {
    return { ok: false, error: 'INVALID_ACCOUNT_PLACE' };
  }

  try {
    const tx = db.transaction(() => {
      // Check account_session_state hiện tại
      let state = db.prepare(`
        SELECT * FROM account_session_state
        WHERE account = ? AND place_id = ?
      `).get(account, placeId);

      if (!state) {
        // Lần đầu: tạo row với current_generation=0, pending=0
        db.prepare(`
          INSERT INTO account_session_state(account, place_id, current_generation, current_session_id, pending_generation, pending_session_id, state, updated_at)
          VALUES(?, ?, 0, NULL, 0, NULL, 'ACTIVE', ?)
        `).run(account, placeId, ts);
        state = { current_generation: 0, current_session_id: null, pending_generation: 0, pending_session_id: null };
      }

      // Tạo Session PENDING (chuẩn bị cho Join)
      const newSessionId = sessionId || ('SESSION_' + require('crypto').randomBytes(8).toString('hex'));
      const ts_expired = ts + CFG.sessionTimeoutMs;

      db.prepare(`
        INSERT INTO hop_session_history(session_id, account, place_id, job_id, runtime_id, generation, status, created_at, last_seen)
        VALUES(?, ?, ?, ?, ?, ?, 'PENDING', ?, ?)
      `).run(newSessionId, account, placeId, jobId, runtimeId, state.current_generation, ts, ts);

      // Cập nhật account_session_state: pending_session_id
      db.prepare(`
        UPDATE account_session_state
        SET pending_session_id = ?, updated_at = ?
        WHERE account = ? AND place_id = ?
      `).run(newSessionId, ts, account, placeId);

      console.log(`[HOP-REGISTER] Registered: account=${account}, sessionId=${newSessionId}, jobId=${jobId}, status=PENDING`);
    });

    tx();
    return { ok: true, action: 'CONTINUE' };
  } catch (err) {
    console.error('[HOP-REGISTER] error:', err.message);
    return { ok: false, error: err.message };
  }
}

// Hybrid C: join - Join xác nhận, kích hoạt Generation
function join({ account, placeId, jobId, handoffId, sessionId, generation, reservationId }) {
  const ts = now();

  if (!account || !placeId || !sessionId || generation === undefined) {
    return { ok: false, error: 'INVALID_PARAMS' };
  }

  try {
    const tx = db.transaction(() => {
      // Lấy trạng thái Session hiện tại
      const session = db.prepare(`
        SELECT session_id, generation, status FROM hop_session_history
        WHERE session_id = ? AND account = ? AND place_id = ?
        LIMIT 1
      `).get(sessionId, account, placeId);

      if (!session) {
        return { ok: false, error: 'SESSION_NOT_FOUND' };
      }

      // Kiểm tra Session còn PENDING không
      if (session.status !== 'PENDING') {
        // Nếu đã ACTIVE rồi, check idempotency
        if (session.status === 'ACTIVE') {
          return { ok: true, alreadyJoined: true, sessionId, generation: session.generation };
        }
        return { ok: false, error: 'SESSION_INVALID_STATE' };
      }

      // Check Reservation nếu có
      if (reservationId) {
        const res = db.prepare(`
          SELECT * FROM hop_reservations
          WHERE reservation_id = ? AND account = ? AND status = 'RESERVED'
          LIMIT 1
        `).get(reservationId, account);

        if (!res || res.expires_at < ts) {
          return { ok: false, error: 'RESERVATION_EXPIRED' };
        }

        // Update Reservation sang JOINED
        db.prepare(`
          UPDATE hop_reservations
          SET status = 'JOINED', joined_at = ?, expires_at = ?
          WHERE reservation_id = ?
        `).run(ts, ts + CFG.sessionTimeoutMs, reservationId);
      }

      // Check DUPLICATE_JOB
      const other = db.prepare(`
        SELECT account FROM hop_session_history
        WHERE place_id = ? AND job_id = ? AND generation = ? AND status = 'ACTIVE' AND account != ?
        LIMIT 1
      `).get(placeId, jobId, generation, account);

      if (other) {
        // Đánh dấu Session mới thành DUPLICATE
        db.prepare(`
          UPDATE hop_session_history
          SET status = 'DUPLICATE', ended_at = ?
          WHERE session_id = ?
        `).run(ts, sessionId);
        return { ok: true, action: 'REHOP', reason: 'DUPLICATE_JOB' };
      }

      // Kích hoạt Generation: chuyển Session mới sang ACTIVE
      db.prepare(`
        UPDATE hop_session_history
        SET status = 'ACTIVE', joined_at = ?, last_seen = ?
        WHERE session_id = ?
      `).run(ts, ts, sessionId);

      // Cập nhật account_session_state: activate current_generation
      db.prepare(`
        UPDATE account_session_state
        SET
          current_session_id = ?,
          current_generation = ?,
          pending_session_id = NULL,
          pending_generation = NULL,
          state = 'ACTIVE',
          updated_at = ?
        WHERE account = ? AND place_id = ?
      `).run(sessionId, generation, ts, account, placeId);

      // V2.4: Update cooldown tracking on Join success
      db.prepare(`
        INSERT OR REPLACE INTO hop_account_hop_state(account, place_id, last_auto_hop_at)
        VALUES(?, ?, ?)
      `).run(account, placeId, ts);

      console.log(`[HOP-JOIN] Activated: account=${account}, sessionId=${sessionId}, generation=${generation}`);
    });

    const result = tx();
    return result !== undefined ? result : { ok: true };
  } catch (err) {
    console.error('[HOP-JOIN] error:', err.message);
    return { ok: false, error: err.message };
  }
}

// Hybrid C: heartbeat - Xác nhận Session sống, detect handoff
function heartbeat({ account, placeId, jobId }) {
  const ts = now();

  if (!account || !placeId || !jobId) {
    return { ok: false, error: 'INVALID_PARAMS' };
  }

  try {
    // Lấy Session state hiện tại
    const state = db.prepare(`
      SELECT * FROM account_session_state
      WHERE account = ? AND place_id = ?
      LIMIT 1
    `).get(account, placeId);

    if (!state) {
      // Lần đầu: cần register trước
      return { ok: true, action: 'NEED_REGISTER' };
    }

    // Lấy Session ACTIVE hiện tại
    const currentSession = state.current_session_id ? db.prepare(`
      SELECT * FROM hop_session_history
      WHERE session_id = ?
      LIMIT 1
    `).get(state.current_session_id) : null;

    if (!currentSession || currentSession.status !== 'ACTIVE') {
      return { ok: true, action: 'NEED_REGISTER' };
    }

    // Check job_id match
    if (currentSession.job_id !== String(jobId)) {
      return { ok: false, error: 'JOB_ID_MISMATCH' };
    }

    // Kiểm tra DUPLICATE_JOB: có account khác ở generation này không?
    const other = db.prepare(`
      SELECT account FROM hop_session_history
      WHERE place_id = ? AND job_id = ? AND generation = ? AND status = 'ACTIVE' AND account != ?
      LIMIT 1
    `).get(placeId, jobId, state.current_generation, account);

    if (other) {
      db.prepare(`
        UPDATE hop_session_history
        SET status = 'DUPLICATE', ended_at = ?
        WHERE session_id = ?
      `).run(ts, state.current_session_id);
      return { ok: true, action: 'REHOP', reason: 'DUPLICATE_JOB' };
    }

    // Cập nhật last_seen, extend expires_at
    db.prepare(`
      UPDATE hop_session_history
      SET last_seen = ?, expires_at = ?
      WHERE session_id = ?
    `).run(ts, ts + CFG.sessionTimeoutMs, state.current_session_id);

    db.prepare(`
      UPDATE account_session_state
      SET updated_at = ?
      WHERE account = ? AND place_id = ?
    `).run(ts, account, placeId);

    // Kiểm tra có pending handoff không
    if (state.pending_session_id) {
      const pendingSession = db.prepare(`
        SELECT * FROM hop_session_history
        WHERE session_id = ?
        LIMIT 1
      `).get(state.pending_session_id);

      if (pendingSession && pendingSession.status === 'PENDING') {
        return {
          ok: true,
          action: 'HANDOFF_PENDING',
          handoff: {
            jobId: pendingSession.job_id,
            generation: pendingSession.generation,
            sessionId: pendingSession.session_id
          }
        };
      }
    }

    return { ok: true, action: 'CONTINUE' };
  } catch (err) {
    console.error('[HOP-HEARTBEAT] error:', err.message);
    return { ok: false, error: err.message };
  }
}

function release({ account, reservationId, placeId, jobId, cooldown, dead }) {
  // V2.4: Accept STOPPING status too, for Fetcher Phase 1
  // Make idempotent: releasing twice returns ok
  const result = db.prepare(`
    UPDATE hop_reservations
    SET status='RELEASED'
    WHERE reservation_id=? AND account=? AND status IN ('RESERVED','JOINED','STOPPING')
  `).run(reservationId, account);

  if (cooldown && placeId != null && jobId) {
    const cooldownMs = dead ? 30 * 60000 : CFG.cooldownMs;
    db.prepare(`UPDATE hop_servers SET cooldown_until=? WHERE place_id=? AND job_id=?`).run(now() + cooldownMs, placeId, jobId);
  }

  return result.changes > 0;
}

// Hybrid C: releaseReservation - Giải phóng Reservation, hỗ trợ dead server cooldown
function releaseReservation({ account, reservationId, placeId, jobId, dead }) {
  const ts = now();

  if (!account || !reservationId) {
    return { ok: false, error: 'INVALID_PARAMS' };
  }

  try {
    const tx = db.transaction(() => {
      // Cập nhật Reservation sang RELEASED
      const res = db.prepare(`
        SELECT * FROM hop_reservations
        WHERE reservation_id = ? AND account = ?
        LIMIT 1
      `).get(reservationId, account);

      if (!res) {
        return { ok: false, error: 'RESERVATION_NOT_FOUND' };
      }

      db.prepare(`
        UPDATE hop_reservations
        SET status = 'RELEASED', released_at = ?
        WHERE reservation_id = ?
      `).run(ts, reservationId);

      // Nếu dead = true, set cooldown 30 phút cho server này
      if (dead && placeId && jobId) {
        const cooldownUntil = ts + (30 * 60 * 1000);
        db.prepare(`
          INSERT INTO hop_servers(place_id, job_id, cooldown_until, updated_at)
          VALUES(?, ?, ?, ?)
          ON CONFLICT(place_id, job_id) DO UPDATE SET
            cooldown_until = MAX(cooldown_until, excluded.cooldown_until),
            updated_at = excluded.updated_at
        `).run(placeId, jobId, cooldownUntil, ts);

        console.log(`[HOP-RELEASE] Dead server cooldown: placeId=${placeId}, jobId=${jobId}, until=${new Date(cooldownUntil).toISOString()}`);
      }

      console.log(`[HOP-RELEASE] Released: account=${account}, reservationId=${reservationId}`);
    });

    const result = tx();
    return result !== undefined ? result : { ok: true };
  } catch (err) {
    console.error('[HOP-RELEASE] error:', err.message);
    return { ok: false, error: err.message };
  }
}

function leave({ account }) { return db.prepare(`UPDATE hop_sessions SET status='OFFLINE',last_seen=? WHERE account=?`).run(now(), account).changes > 0; }

// Hybrid C: createHandoff - Tạo quá trình Handoff, chuẩn bị job mới
function createHandoff({ account, placeId, newJobId, newRuntimeId }) {
  const ts = now();

  if (!account || !placeId || !newJobId) {
    return { ok: false, error: 'INVALID_PARAMS' };
  }

  try {
    const tx = db.transaction(() => {
      // Lấy state hiện tại
      let state = db.prepare(`
        SELECT * FROM account_session_state
        WHERE account = ? AND place_id = ?
        LIMIT 1
      `).get(account, placeId);

      if (!state) {
        return { ok: false, error: 'NO_ACTIVE_SESSION' };
      }

      // Không được có handoff pending rồi
      if (state.pending_session_id) {
        return { ok: false, error: 'HANDOFF_ALREADY_PENDING' };
      }

      // Tạo Session mới với generation = current + 1
      const newGeneration = state.current_generation + 1;
      const newSessionId = 'SESSION_' + require('crypto').randomBytes(8).toString('hex');
      const ts_expired = ts + CFG.sessionTimeoutMs;

      db.prepare(`
        INSERT INTO hop_session_history(session_id, account, place_id, job_id, runtime_id, generation, status, created_at, last_seen)
        VALUES(?, ?, ?, ?, ?, ?, 'PENDING', ?, ?)
      `).run(newSessionId, account, placeId, newJobId, newRuntimeId, newGeneration, ts, ts);

      // Tạo Handoff record
      const handoffId = 'HANDOFF_' + require('crypto').randomBytes(8).toString('hex');
      db.prepare(`
        INSERT INTO hop_handoffs(handoff_id, account, place_id, from_job_id, to_job_id, from_session_id, to_session_id, status, created_at, expires_at)
        VALUES(?, ?, ?, ?, ?, ?, ?, 'PENDING', ?, ?)
      `).run(handoffId, account, placeId, state.current_session_id ? 'N/A' : null, newJobId, state.current_session_id, newSessionId, ts, ts_expired);

      // Cập nhật account_session_state: pending_session_id, pending_generation
      db.prepare(`
        UPDATE account_session_state
        SET pending_session_id = ?, pending_generation = ?, updated_at = ?
        WHERE account = ? AND place_id = ?
      `).run(newSessionId, newGeneration, ts, account, placeId);

      console.log(`[HOP-HANDOFF] Created: account=${account}, handoffId=${handoffId}, newGeneration=${newGeneration}`);

      return { ok: true, handoffId, newSessionId, newGeneration };
    });

    const result = tx();
    return result !== undefined ? result : { ok: true };
  } catch (err) {
    console.error('[HOP-HANDOFF] error:', err.message);
    return { ok: false, error: err.message };
  }
}

// Hybrid C: drainHandoff - Chuyển Handoff từ PENDING → DRAINING, chuẩn bị để drain old session
function drainHandoff({ account, placeId, handoffId }) {
  const ts = now();

  if (!handoffId || !account || !placeId) {
    return { ok: false, error: 'INVALID_PARAMS' };
  }

  try {
    const tx = db.transaction(() => {
      // Lấy Handoff status
      const handoff = db.prepare(`
        SELECT * FROM hop_handoffs
        WHERE handoff_id = ? AND account = ? AND place_id = ?
        LIMIT 1
      `).get(handoffId, account, placeId);

      if (!handoff) {
        return { ok: false, error: 'HANDOFF_NOT_FOUND' };
      }

      if (handoff.status !== 'PENDING') {
        return { ok: false, error: 'HANDOFF_NOT_PENDING' };
      }

      // Chuyển Handoff sang DRAINING
      db.prepare(`
        UPDATE hop_handoffs
        SET status = 'DRAINING', updated_at = ?
        WHERE handoff_id = ?
      `).run(ts, handoffId);

      console.log(`[HOP-HANDOFF] Draining: handoffId=${handoffId}, account=${account}`);
    });

    const result = tx();
    return result !== undefined ? result : { ok: true };
  } catch (err) {
    console.error('[HOP-HANDOFF-DRAIN] error:', err.message);
    return { ok: false, error: err.message };
  }
}

// Hybrid C: releaseHandoff - Hoàn thành Handoff, chuyển → RELEASED
function releaseHandoff({ account, placeId, handoffId }) {
  const ts = now();

  if (!handoffId || !account || !placeId) {
    return { ok: false, error: 'INVALID_PARAMS' };
  }

  try {
    const tx = db.transaction(() => {
      // Lấy Handoff status
      const handoff = db.prepare(`
        SELECT * FROM hop_handoffs
        WHERE handoff_id = ? AND account = ? AND place_id = ?
        LIMIT 1
      `).get(handoffId, account, placeId);

      if (!handoff) {
        return { ok: false, error: 'HANDOFF_NOT_FOUND' };
      }

      if (handoff.status !== 'DRAINING' && handoff.status !== 'ACTIVATED') {
        return { ok: false, error: 'HANDOFF_INVALID_STATE' };
      }

      // Chuyển Handoff sang RELEASED
      db.prepare(`
        UPDATE hop_handoffs
        SET status = 'RELEASED', ended_at = ?, updated_at = ?
        WHERE handoff_id = ?
      `).run(ts, ts, handoffId);

      console.log(`[HOP-HANDOFF] Released: handoffId=${handoffId}, account=${account}`);
    });

    const result = tx();
    return result !== undefined ? result : { ok: true };
  } catch (err) {
    console.error('[HOP-HANDOFF-RELEASE] error:', err.message);
    return { ok: false, error: err.message };
  }
}

function pool(placeId) { expireReservations(); return db.prepare(`SELECT * FROM hop_servers WHERE place_id=? ORDER BY playing ASC,last_updated DESC`).all(placeId); }
function status(account) { expireReservations(); return account ? db.prepare(`SELECT * FROM hop_sessions WHERE account=?`).get(account) || null : db.prepare(`SELECT * FROM hop_sessions ORDER BY last_seen DESC`).all(); }


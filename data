  if (purged) console.log(`[HOP] Removed ${purged} dummy seed server(s)`);
} catch (err) { console.error('[HOP] purge seed failed:', err.message); }
setInterval(() => {
  try { expireReservations(); } catch (err) { console.error('Hop cleanup failed:', err); }

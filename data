  `);
});

// ---------- graceful shutdown ----------
let isShuttingDown = false;
const shutdown = async (signal) => {
  if (isShuttingDown) {
    console.log(`[SHUTDOWN] Already shutting down, ignoring ${signal}`);
    return;
  }
  isShuttingDown = true;
  console.log(`\n[SHUTDOWN] Received ${signal}, cleaning up...`);
  console.log(`[HOP-RUNTIME] Shutdown requested: ${runtime.run_id} reason: ${signal}`);

  try {
    // Step 1: Stop background jobs
    console.log(`[SHUTDOWN] Stopping background jobs...`);
    clearInterval(updateOfflineStatusInterval);
    clearInterval(idleCleanupInterval);
    clearInterval(schedulerPollInterval);

    // Step 2: Wait briefly for pending requests
    console.log(`[SHUTDOWN] Waiting for pending requests...`);
    await new Promise(resolve => setTimeout(resolve, 500));

    // Step 3: Export runtime data BEFORE cleanup
    console.log(`[SHUTDOWN] Exporting runtime archive...`);
    const runtimeEndTime = new Date();
    const exporter = new RuntimeArchiveExporter(db, runtime.run_id, archiveDir, runtimeLogger);

    // Get actual Collector ID from active lease
    const activeLease = db.prepare(`
      SELECT collector_id FROM hop_fetcher_lease
      WHERE status = 'ACTIVE'
      ORDER BY heartbeat_at DESC
      LIMIT 1
    `).get();

    const { report, error: exportError } = await exporter.exportToTxt(
      runtimeStartTime,
      runtimeEndTime,
      { collectorId: activeLease?.collector_id || 'NONE' },
      signal
    );

    if (exportError) {
      console.error(`[SHUTDOWN] Export error: ${exportError}`);
    } else {
      const { filepath, error: writeError } = await exporter.writeArchiveFile(report);
      if (writeError) {
        console.error(`[SHUTDOWN] Failed to write archive file: ${writeError}`);
      } else {
        console.log(`[SHUTDOWN] Archive saved: ${filepath}`);
      }
    }

    // Step 4: Flush runtime logger
    await runtimeLogger.close();

    // Step 4.5: Clear background intervals
    console.log(`[SHUTDOWN] Clearing background intervals...`);
    if (idleCleanupInterval) clearInterval(idleCleanupInterval);
    if (verificationInterval) clearInterval(verificationInterval);
    if (verificationStaleLockInterval) clearInterval(verificationStaleLockInterval);
    if (updateOfflineStatusInterval) clearInterval(updateOfflineStatusInterval);

    // Step 5: Now run cleanup
    console.log(`[SHUTDOWN] Running runtime cleanup...`);
    runtimeManager.shutdownRuntime(runtime.run_id);

    // Step 6: Bỏ backup .db/.sql, chỉ giữ archive .txt
    console.log(`[SHUTDOWN] === SHUTDOWN COMPLETE: ${runtime.run_id} ===`);
  } catch (err) {
    console.error(`[SHUTDOWN] Fatal error during shutdown:`, err);
  }

  process.exit(0);
};

// Refs to clear intervals
// (declared at top to avoid TDZ)

// Signal handlers
process.on('SIGINT', () => shutdown('SIGINT'));
process.on('SIGTERM', () => shutdown('SIGTERM'));

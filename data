// Verification Service - quản lý verification queue cho server pool
// Mỗi server thêm vào pool cần được verify lại mỗi 5 phút

const POOL_CONFIG = {
  MIN_PLAYERS: 1,
  MAX_PLAYERS: 8,
  MIN_PLAYERS_TO_ADD: 1,
  MAX_PLAYERS_TO_ADD: 8,
  REVALIDATE_INTERVAL_MS: 150000, // 2.5 minutes (150 seconds) - DUE marking interval
  MAX_VERIFICATION_AGE_MS: 1800000, // 30 minutes (1800 seconds) - STALE threshold (covers full Asc+Desc cycle ~25-26min + buffer)
  REQUIRE_VERIFIED: true,
};

module.exports = (db) => {
  const now = () => Date.now();

  // Lấy danh sách server cần verify (đã hết hạn hoặc chưa verify)
  const getServersDueForVerification = (placeId, runId, limit = 50) => {
    try {
      const ts = now();
      return db.prepare(`
        SELECT job_id, playing, max_players, last_verified_at, next_verify_at, verify_status
        FROM hop_servers
        WHERE place_id = ?
          AND run_id = ?
          AND (
            verify_status = 'PENDING'
            OR next_verify_at IS NULL
            OR next_verify_at <= ?
          )
        ORDER BY next_verify_at ASC, last_verified_at ASC
        LIMIT ?
      `).all(placeId, runId, ts, limit);
    } catch (err) {
      console.error('[HOP-VERIFY] getServersDueForVerification error:', err.message);
      return [];
    }
  };

  // Đánh dấu server cần verify
  const markServerForVerification = (placeId, jobId) => {
    try {
      db.prepare(`
        UPDATE hop_servers
        SET verify_status = 'PENDING', next_verify_at = ?
        WHERE place_id = ? AND job_id = ?
      `).run(now(), placeId, jobId);
    } catch (err) {
      console.error('[HOP-VERIFY] markServerForVerification error:', err.message);
    }
  };

  // Cập nhật kết quả verify: thành công
  const markServerVerified = (placeId, jobId, playing, maxPlayers) => {
    try {
      const ts = now();
      const nextVerifyAt = ts + POOL_CONFIG.REVALIDATE_INTERVAL_MS;

      if (playing < POOL_CONFIG.MIN_PLAYERS || playing > POOL_CONFIG.MAX_PLAYERS) {
        db.prepare(`
          UPDATE hop_servers
          SET verify_status = 'OUT_OF_RANGE', eligible = 0, last_verified_at = ?, next_verify_at = ?
          WHERE place_id = ? AND job_id = ?
        `).run(ts, nextVerifyAt, placeId, jobId);
        console.log(`[HOP-VERIFY] Server OUT_OF_RANGE: place=${placeId} job=${jobId} playing=${playing}`);
        return false;
      }

      db.prepare(`
        UPDATE hop_servers
        SET verify_status = 'ACTIVE', eligible = 1, playing = ?, max_players = ?, last_verified_at = ?, next_verify_at = ?
        WHERE place_id = ? AND job_id = ?
      `).run(playing, maxPlayers, ts, nextVerifyAt, placeId, jobId);

      return true;
    } catch (err) {
      console.error('[HOP-VERIFY] markServerVerified error:', err.message);
      return false;
    }
  };

  // Cập nhật kết quả verify: không tìm thấy trong batch này (chưa xác định)
  const markServerPending = (placeId, jobId) => {
    try {
      db.prepare(`
        UPDATE hop_servers
        SET verify_status = 'PENDING'
        WHERE place_id = ? AND job_id = ?
      `).run(placeId, jobId);
    } catch (err) {
      console.error('[HOP-VERIFY] markServerPending error:', err.message);
    }
  };

  // Kiểm tra server có được phép admission vào Pool không (1-8 player)
  const canAdmitServer = (playing, maxPlayers) => {
    return playing >= POOL_CONFIG.MIN_PLAYERS_TO_ADD &&
           playing <= POOL_CONFIG.MAX_PLAYERS_TO_ADD &&
           playing < maxPlayers;
  };

  // Kiểm tra server có được phép ở trong Pool không (1-8 player)
  const canKeepServer = (playing, maxPlayers) => {
    return playing >= POOL_CONFIG.MIN_PLAYERS &&
           playing <= POOL_CONFIG.MAX_PLAYERS &&
           playing < maxPlayers;
  };

  // Lấy pool stats cho verification
  const getVerificationStats = (placeId, runId) => {
    try {
      const verified = db.prepare(`
        SELECT COUNT(*) AS count FROM hop_servers
        WHERE place_id = ? AND run_id = ? AND verify_status = 'VERIFIED'
      `).get(placeId, runId);

      const pending = db.prepare(`
        SELECT COUNT(*) AS count FROM hop_servers
        WHERE place_id = ? AND run_id = ? AND verify_status = 'PENDING'
      `).get(placeId, runId);

      const outOfRange = db.prepare(`
        SELECT COUNT(*) AS count FROM hop_servers
        WHERE place_id = ? AND run_id = ? AND verify_status = 'OUT_OF_RANGE'
      `).get(placeId, runId);

      return {
        verified: verified ? verified.count : 0,
        pending: pending ? pending.count : 0,
        outOfRange: outOfRange ? outOfRange.count : 0,
      };
    } catch (err) {
      console.error('[HOP-VERIFY] getVerificationStats error:', err.message);
      return { verified: 0, pending: 0, outOfRange: 0 };
    }
  };

  // Lấy servers DUE (verification hết hạn trong 2.5 phút)
  // NOTE: Don't change verify_status to DUE - just track that they need re-observation
  const getServersDue = (placeId, runId, limit = 500) => {
    try {
      const ts = now();
      return db.prepare(`
        SELECT job_id, playing, verify_status, next_verify_at, last_verified_at
        FROM hop_servers
        WHERE place_id = ? AND run_id = ?
          AND verify_status = 'ACTIVE'
          AND eligible = 1
          AND next_verify_at IS NOT NULL
          AND next_verify_at <= ?
          AND NOT EXISTS (
            SELECT 1
            FROM hop_verification_queue q
            WHERE q.run_id = hop_servers.run_id
              AND q.place_id = hop_servers.place_id
              AND q.job_id = hop_servers.job_id
              AND q.status = 'DUE'
          )
        ORDER BY next_verify_at ASC
        LIMIT ?
      `).all(placeId, runId, ts, limit);
    } catch (err) {
      console.error('[HOP-VERIFY] getServersDue error:', err.message);
      return [];
    }
  };

  // Lấy servers STALE (verification quá 10 phút chưa cập nhật)
  const getServerStale = (placeId, runId, limit = 50) => {
    try {
      const ts = now();
      const maxAge = ts - POOL_CONFIG.MAX_VERIFICATION_AGE_MS;
      return db.prepare(`
        SELECT job_id, playing, verify_status, last_verified_at
        FROM hop_servers
        WHERE place_id = ? AND run_id = ?
          AND verify_status = 'ACTIVE'
          AND eligible = 1
          AND (last_verified_at IS NULL OR last_verified_at < ?)
        ORDER BY last_verified_at ASC
        LIMIT ?
      `).all(placeId, runId, maxAge, limit);
    } catch (err) {
      console.error('[HOP-VERIFY] getServerStale error:', err.message);
      return [];
    }
  };

  // Track server needing re-verification (don't change status, just queue)
  const markServerDue = (placeId, jobId, runtimeId) => {
    try {
      const ts = now();
      db.prepare(`
        INSERT OR REPLACE INTO hop_verification_queue(
          run_id, place_id, job_id, due_at, status
        ) VALUES (?, ?, ?, ?, 'DUE')
      `).run(runtimeId, placeId, jobId, ts);
    } catch (err) {
      console.error('[HOP-VERIFY] markServerDue error:', err.message);
    }
  };

  // Mark server as STALE (>20 min no verification)
  const markServerStale = (placeId, jobId, runtimeId) => {
    try {
      const ts = now();
      const cutoff = ts - POOL_CONFIG.MAX_VERIFICATION_AGE_MS;

      const tx = db.transaction(() => {
        // Recheck timestamp at UPDATE time to prevent race condition
        const result = db.prepare(`
          UPDATE hop_servers
          SET verify_status = 'STALE',
              eligible = 0
          WHERE place_id = ?
            AND job_id = ?
            AND run_id = ?
            AND verify_status = 'ACTIVE'
            AND eligible = 1
            AND (
              last_verified_at IS NULL
              OR last_verified_at < ?
            )
        `).run(placeId, jobId, runtimeId, cutoff);

        // Server was refreshed or not ACTIVE - skip queue insert
        if (result.changes === 0) {
          return false;
        }

        db.prepare(`
          INSERT OR REPLACE INTO hop_verification_queue(
            run_id, place_id, job_id, due_at, status
          ) VALUES (?, ?, ?, ?, 'STALE')
        `).run(runtimeId, placeId, jobId, ts);

        return true;
      });

      const marked = tx();

      if (marked) {
        console.log(`[HOP-VERIFY] Marked STALE: ${jobId}`);
      }

      return marked;
    } catch (err) {
      console.error('[HOP-VERIFY] markServerStale error:', err.message);
      return false;
    }
  };

  // P2 Fix: Deprecated - bỏ markNotSeenAfterScan hoàn toàn
  // Single-source NOT_SEEN không đáng tin cậy, chỉ paired Asc+Desc evaluation được dùng
  // const markNotSeenAfterScan = (placeId, runtimeId, source, completedScanId) => { ... };

  // Record scan completion and trigger paired-cycle evaluation
  const recordScanCompletion = (placeId, runtimeId, source, scanId, completedAt) => {
    try {
      const ts = completedAt || Date.now();

      // Get or create current cycle
      const currentCycle = db.prepare(`
        SELECT cycle_number, asc_scan_id, desc_scan_id, asc_completed_at, desc_completed_at
        FROM hop_scan_cycles
        WHERE run_id = ? AND place_id = ? AND both_completed = 0
        ORDER BY cycle_number DESC
        LIMIT 1
      `).get(runtimeId, placeId);

      let cycleNumber;

      if (!currentCycle) {
        // Create first cycle
        cycleNumber = 1;
        db.prepare(`
          INSERT INTO hop_scan_cycles (run_id, place_id, cycle_number, created_at)
          VALUES (?, ?, ?, ?)
        `).run(runtimeId, placeId, cycleNumber, ts);
      } else {
        cycleNumber = currentCycle.cycle_number;
      }

      // Update cycle with scan completion
      const field = source === 'Asc' ? 'asc' : 'desc';
      const statusField = source === 'Asc' ? 'asc_status' : 'desc_status';
      const scanIdField = source === 'Asc' ? 'asc_scan_id' : 'desc_scan_id';

      // Phase 3 Fix: Chống ghi đè completion - check xem source này đã hoàn thành chưa
      const existingScanId = currentCycle ? (source === 'Asc' ? currentCycle.asc_scan_id : currentCycle.desc_scan_id) : null;
      if (existingScanId) {
        if (existingScanId === scanId) {
          // Idempotent: cùng scanId gọi lại
          console.log(`[HOP-VERIFY] Idempotent: ${source} scanId=${scanId} already recorded in cycle ${cycleNumber}`);
          return;
        } else {
          // Source này đã hoàn thành với scanId khác - từ chối
          console.log(`[HOP-VERIFY] Reject: ${source} already completed with scanId=${existingScanId}, new=${scanId}`);
          return;
        }
      }

      db.prepare(`
        UPDATE hop_scan_cycles
        SET ${field}_scan_id = ?,
            ${field}_completed_at = ?,
            ${field}_status = 'COMPLETE'
        WHERE run_id = ? AND place_id = ? AND cycle_number = ?
      `).run(scanId, ts, runtimeId, placeId, cycleNumber);

      // Check if both Asc and Desc are complete
      const cycle = db.prepare(`
        SELECT asc_status, desc_status, asc_scan_id, desc_scan_id, both_completed, evaluated_at
        FROM hop_scan_cycles
        WHERE run_id = ? AND place_id = ? AND cycle_number = ?
      `).get(runtimeId, placeId, cycleNumber);

      if (cycle.asc_status === 'COMPLETE' && cycle.desc_status === 'COMPLETE' && !cycle.both_completed) {
        console.log(`[HOP-VERIFY] Paired cycle ${cycleNumber} complete - evaluating NOT_SEEN`);

        // Atomic: Mark both_completed, evaluate NOT_SEEN, create next cycle in transaction
        const tx = db.transaction(() => {
          // 1. Mark cycle as both_completed (chưa evaluated_at)
          db.prepare(`
            UPDATE hop_scan_cycles
            SET both_completed = 1
            WHERE run_id = ? AND place_id = ? AND cycle_number = ?
          `).run(runtimeId, placeId, cycleNumber);

          // 2. Evaluate paired NOT_SEEN - nếu thất bại, transaction rollback
          evaluatePairedNotSeen(placeId, runtimeId, cycleNumber, cycle.asc_scan_id, cycle.desc_scan_id);

          // 3. P3 Fix: Chỉ ghi evaluated_at SAU khi đánh giá thành công
          db.prepare(`
            UPDATE hop_scan_cycles
            SET evaluated_at = ?
            WHERE run_id = ? AND place_id = ? AND cycle_number = ?
          `).run(ts, runtimeId, placeId, cycleNumber);

          // 4. Create next cycle (idempotent via INSERT OR IGNORE on unique(run_id, place_id, cycle_number))
          db.prepare(`
            INSERT OR IGNORE INTO hop_scan_cycles (run_id, place_id, cycle_number, created_at)
            VALUES (?, ?, ?, ?)
          `).run(runtimeId, placeId, cycleNumber + 1, ts);
        });

        tx();
      } else if (cycle.both_completed && !cycle.evaluated_at) {
        // Retry: cycle marked complete but not yet evaluated (crashed mid-evaluation)
        console.log(`[HOP-VERIFY] Retrying cycle ${cycleNumber} evaluation (both_completed but not evaluated_at)`);

        const tx = db.transaction(() => {
          // Evaluate TRƯỚC ghi evaluated_at, nếu lỗi thì rollback
          evaluatePairedNotSeen(placeId, runtimeId, cycleNumber, cycle.asc_scan_id, cycle.desc_scan_id);

          db.prepare(`
            UPDATE hop_scan_cycles
            SET evaluated_at = ?
            WHERE run_id = ? AND place_id = ? AND cycle_number = ?
          `).run(ts, runtimeId, placeId, cycleNumber);
        });

        tx();
      } else {
        console.log(`[HOP-VERIFY] ${source} scan complete - waiting for paired ${source === 'Asc' ? 'Desc' : 'Asc'}`);
      }

    } catch (err) {
      console.error('[HOP-VERIFY] recordScanCompletion error:', err.message);
    }
  };

  // Evaluate paired Asc+Desc NOT_SEEN with grace period
  const evaluatePairedNotSeen = (placeId, runtimeId, cycleNumber, ascScanId, descScanId) => {
    try {
      // Find servers NOT seen in BOTH Asc AND Desc (Asc UNION Desc)
      const notSeenBoth = db.prepare(`
        SELECT job_id, verify_status, not_seen_count, last_seen_cycle
        FROM hop_servers
        WHERE place_id = ? AND run_id = ?
          AND verify_status IN ('ACTIVE', 'DUE')
          AND (last_seen_asc_scan_id != ? OR last_seen_asc_scan_id IS NULL)
          AND (last_seen_desc_scan_id != ? OR last_seen_desc_scan_id IS NULL)
      `).all(placeId, runtimeId, ascScanId, descScanId);

      if (notSeenBoth.length === 0) {
        console.log(`[HOP-VERIFY] Cycle ${cycleNumber}: All servers seen in Asc UNION Desc`);
        return;
      }

      console.log(`[HOP-VERIFY] Cycle ${cycleNumber}: ${notSeenBoth.length} servers not seen in BOTH sources`);

      // Apply grace period: need 2 consecutive cycles
      for (const server of notSeenBoth) {
        const newCount = (server.not_seen_count || 0) + 1;

        if (newCount >= 2) {
          // Mark NOT_SEEN after 2 cycles
          db.prepare(`
            UPDATE hop_servers
            SET verify_status = 'NOT_SEEN',
                eligible = 0,
                not_seen_count = ?,
                last_seen_cycle = ?
            WHERE place_id = ? AND job_id = ? AND run_id = ?
          `).run(newCount, cycleNumber, placeId, server.job_id, runtimeId);

          // Remove from verification queue
          db.prepare(`
            DELETE FROM hop_verification_queue
            WHERE run_id = ? AND place_id = ? AND job_id = ?
          `).run(runtimeId, placeId, server.job_id);

          console.log(`[HOP-VERIFY] Marked NOT_SEEN after ${newCount} cycles: ${server.job_id}`);
        } else {
          // Increment counter, wait for next cycle
          db.prepare(`
            UPDATE hop_servers
            SET not_seen_count = ?, last_seen_cycle = ?
            WHERE place_id = ? AND job_id = ? AND run_id = ?
          `).run(newCount, cycleNumber, placeId, server.job_id, runtimeId);

          console.log(`[HOP-VERIFY] ${server.job_id} not seen count: ${newCount}/2`);
        }
      }

      // Reset counter for servers that WERE seen
      const seenServers = db.prepare(`
        SELECT job_id FROM hop_servers
        WHERE place_id = ? AND run_id = ?
          AND (last_seen_asc_scan_id = ? OR last_seen_desc_scan_id = ?)
          AND not_seen_count > 0
      `).all(placeId, runtimeId, ascScanId, descScanId);

      for (const server of seenServers) {
        db.prepare(`
          UPDATE hop_servers
          SET not_seen_count = 0, last_seen_cycle = ?
          WHERE place_id = ? AND job_id = ? AND run_id = ?
        `).run(cycleNumber, placeId, server.job_id, runtimeId);
      }

      if (seenServers.length > 0) {
        console.log(`[HOP-VERIFY] Reset not_seen_count for ${seenServers.length} servers`);
      }

    } catch (err) {
      console.error('[HOP-VERIFY] evaluatePairedNotSeen error:', err.message);
      throw err;
    }
  };

  return {
    POOL_CONFIG,
    getServersDueForVerification,
    markServerForVerification,
    markServerVerified,
    markServerPending,
    canAdmitServer,
    canKeepServer,
    getVerificationStats,
    getServersDue,
    getServerStale,
    markServerDue,
    markServerStale,
    recordScanCompletion,
    evaluatePairedNotSeen,
  };
};

// Source State Service - manage Asc/Desc state independently
// Handles: cursors, rotation, failures, cooldown
// IMPORTANT: Initialize once, don't reset cursors on each getNextSource

module.exports = (db, verificationService, config = {}) => {
  const now = () => Date.now();
  const SOURCES = ['Asc', 'Desc'];
  const COOLDOWN_DELAYS = [60000, 120000, 240000, 480000, 900000]; // 1m, 2m, 4m, 8m, 15m
  const MAX_PAGES_PER_SOURCE = config.maxPagesPerSource || Infinity;
  const TEST_MODE = config.testMode || false;

  // Initialize source state if not exists — only INSERT, never reset
  const initSourceState = (placeId, source) => {
    try {
      db.prepare(`
        INSERT OR IGNORE INTO hop_source_state(
          place_id,
          source,
          cursor,
          page_index,
          last_attempt_at,
          last_success_at,
          next_fetch_at,
          consecutive_failures,
          status,
          last_error
        )
        VALUES (
          @placeId,
          @source,
          @cursor,
          @pageIndex,
          @lastAttemptAt,
          @lastSuccessAt,
          @nextFetchAt,
          @consecutiveFailures,
          @status,
          @lastError
        )
      `).run({
        placeId,
        source,
        cursor: null,
        pageIndex: 0,
        lastAttemptAt: null,
        lastSuccessAt: null,
        nextFetchAt: now(),
        consecutiveFailures: 0,
        status: 'READY',
        lastError: null
      });

      console.log(`[HOP-SOURCE] Initialized ${source}`);
    } catch (err) {
      if (err.message.includes('UNIQUE constraint')) {
        // Already exists, silent
        return;
      }
      console.error(`[HOP-SOURCE] initSourceState error for ${source}:`, err.message);
      throw err;
    }
  };

  // Initialize both sources at startup — call once only
  const initializeAllSources = (placeId) => {
    SOURCES.forEach(s => {
      try {
        initSourceState(placeId, s);
      } catch (_) {}
    });
  };

  // Get next source to fetch — NO initialization here, just read
  const getNextSource = (placeId) => {
    const now_ms = now();
    try {
      // Reset any expired cooldowns back to READY
      db.prepare(`
        UPDATE hop_source_state
        SET status = 'READY', last_attempt_at = NULL
        WHERE place_id = ? AND status = 'COOLDOWN' AND next_fetch_at <= ?
      `).run(placeId, now_ms);

      // Get first READY source, prefer one with oldest attempt time (natural rotation)
      const ready = db.prepare(`
        SELECT source, page_index FROM hop_source_state
        WHERE place_id = ? AND status = 'READY' AND next_fetch_at <= ?
        ORDER BY COALESCE(last_attempt_at, 0) ASC
        LIMIT 1
      `).get(placeId, now_ms);

      if (ready) {
        console.log(`[HOP-SOURCE] Next source=${ready.source} page=${ready.page_index}`);
        return ready.source;
      }

      // All sources in cooldown — return one with shortest remaining wait
      const cooldown = db.prepare(`
        SELECT source, next_fetch_at FROM hop_source_state
        WHERE place_id = ? AND status = 'COOLDOWN'
        ORDER BY next_fetch_at ASC
        LIMIT 1
      `).get(placeId);

      if (cooldown) {
        return { source: cooldown.source, waitMs: Math.max(0, cooldown.next_fetch_at - now_ms) };
      }

      return null;
    } catch (err) {
      console.error(`[HOP-SOURCE] getNextSource error:`, err.message);
      return null;
    }
  };

  // Get source state for fetching — NO initialization, just read
  const getSourceState = (placeId, source) => {
    try {
      return db.prepare(`SELECT * FROM hop_source_state WHERE place_id = ? AND source = ?`).get(placeId, source);
    } catch (err) {
      console.error(`[HOP-SOURCE] getSourceState error:`, err.message);
      return null;
    }
  };

  // Mark fetch success — update cursor and increment page if more data
  const markSuccess = (placeId, source, nextCursor) => {
    const ts = now();
    const hasNext = Boolean(nextCursor);
    const nextFetchTime = ts + 2000; // 2s delay to force rotation

    try {
      const state = getSourceState(placeId, source);
      const pageIndex = state?.page_index || 0;
      // P0-2 Fix: Ghi nhận scan hoàn thành kể cả 1 trang (không dùng page_index > 0)
      // Scan hoàn thành khi: không còn nextCursor (hasNext=false) + có scan_id hợp lệ
      // TEST_MODE Fix: Partial scan (page_index >= MAX_PAGES) không được mark completed
      const isPartialScan = TEST_MODE && (pageIndex + 1 >= MAX_PAGES_PER_SOURCE);
      const scanCompleted = !hasNext && state && state.scan_id && !isPartialScan;

      // IMPORTANT: Save completed scan_id BEFORE generating new one
      const completedScanId = state?.scan_id || null;
      const newScanId = scanCompleted ? `${source}_SCAN_${ts}_${Math.random().toString(36).substr(2, 6)}` : completedScanId;

      db.prepare(`
        UPDATE hop_source_state
        SET
          cursor = ?,
          page_index = CASE WHEN ? = 1 THEN page_index + 1 ELSE 0 END,
          last_success_at = ?,
          last_attempt_at = ?,
          consecutive_failures = 0,
          status = 'READY',
          next_fetch_at = ?,
          scan_id = ?,
          scan_completed_at = CASE WHEN ? = 1 THEN ? ELSE scan_completed_at END
        WHERE place_id = ? AND source = ?
      `).run(
        nextCursor || null,
        hasNext ? 1 : 0,
        ts,
        ts,
        nextFetchTime,
        newScanId,
        scanCompleted ? 1 : 0,
        scanCompleted ? ts : null,
        placeId,
        source
      );

      if (scanCompleted) {
        console.log(`[HOP-SOURCE] ${source} scan completed, starting new scan: ${newScanId}`);

        // Update cycle completion tracking with COMPLETED scan_id
        const runtimeManager = require('./runtimeManager')(db);
        const runtime = runtimeManager.getActiveRuntime();

        if (runtime && verificationService && verificationService.recordScanCompletion) {
          verificationService.recordScanCompletion(
            placeId,
            runtime.run_id,
            source,
            completedScanId,
            ts
          );
        } else {
          console.log(`[HOP-VERIFY] NOT_SEEN deferred - waiting for paired Asc/Desc verification`);
        }
      } else {
        if (isPartialScan) {
          console.log(`[HOP-SOURCE] Partial scan ${source} page=${pageIndex + 1}/${MAX_PAGES_PER_SOURCE} (TEST_MODE) - NOT marking completed`);
        } else {
          console.log(`[HOP-SOURCE] Success ${source} page=${db.prepare(
            `SELECT page_index FROM hop_source_state WHERE place_id = ? AND source = ?`
          ).get(placeId, source)?.page_index || 0} nextCursor=${hasNext ? 'yes' : 'no'}`);
        }
      }
    } catch (err) {
      console.error(`[HOP-SOURCE] markSuccess error:`, err.message);
      throw err;
    }
  };

  // Mark fetch failure — increment failure count, apply cooldown
  const markFailure = (placeId, source, error) => {
    const ts = now();
    try {
      const state = getSourceState(placeId, source);
      if (!state) return;

      const failures = (state.consecutive_failures || 0) + 1;
      const delayIndex = Math.min(failures - 1, COOLDOWN_DELAYS.length - 1);
      const cooldownMs = COOLDOWN_DELAYS[delayIndex];
      const nextFetch = ts + cooldownMs;

      console.log(`[HOP-SOURCE] ${source} failure #${failures}, cooldown=${cooldownMs}ms`);

      db.prepare(`
        UPDATE hop_source_state
        SET
          last_attempt_at = ?,
          consecutive_failures = ?,
          status = 'COOLDOWN',
          next_fetch_at = ?,
          last_error = ?
        WHERE place_id = ? AND source = ?
      `).run(ts, failures, nextFetch, error || null, placeId, source);
    } catch (err) {
      console.error(`[HOP-SOURCE] markFailure error:`, err.message);
    }
  };

  // Mark fetch attempt without success (used for scan tracking)
  const markAttempt = (placeId, source) => {
    try {
      db.prepare(`
        UPDATE hop_source_state
        SET last_attempt_at = ?
        WHERE place_id = ? AND source = ?
      `).run(now(), placeId, source);
    } catch (err) {
      console.error(`[HOP-SOURCE] markAttempt error:`, err.message);
    }
  };

  // P0 Fix: Update source state (scan_id, etc)
  const updateSourceState = (placeId, source, patch = {}) => {
    try {
      if (Object.prototype.hasOwnProperty.call(patch, 'scan_id')) {
        db.prepare(`
          UPDATE hop_source_state
          SET scan_id = ?
          WHERE place_id = ? AND source = ?
        `).run(patch.scan_id, placeId, source);
        console.log(`[HOP-SOURCE] Updated scan_id for ${source}: ${patch.scan_id}`);
      }
      return getSourceState(placeId, source);
    } catch (err) {
      console.error(`[HOP-SOURCE] updateSourceState error:`, err.message);
      throw err;
    }
  };

  return { initializeAllSources, getNextSource, getSourceState, updateSourceState, markSuccess, markFailure, markAttempt };
};

// Server Pool Service - quản lý Pool theo Runtime ID
// Mỗi Runtime là một Pool riêng biệt

module.exports = (db) => {
  const now = () => Date.now();
  const STALE_MS = 180000; // 3 phút - Server cũ hơn này không được cấp Reservation

  // Player tiers: ưu tiên server ít player
  const PLAYER_TIERS = [
    { min: 0, max: 6, name: 'Low' },
    { min: 7, max: 8, name: 'Medium' },
    { min: 9, max: 10, name: 'High' },
    { min: 11, max: Infinity, name: 'Full' },
  ];

  // Thêm server vào Pool (gọi từ reportServers)
  const upsertServer = (placeId, runId, source, servers) => {
    if (!Array.isArray(servers)) return 0;

    const ts = now();
    let accepted = 0;

    try {
      const tx = db.transaction(() => {
        for (const srv of servers) {
          if (!srv.jobId || typeof srv.playing !== 'number' || typeof srv.maxPlayers !== 'number') {
            continue;
          }

          const col = source === 'Asc' ? 'low_seen_at' : 'busy_seen_at';
          db.prepare(`
            INSERT INTO hop_servers(place_id, job_id, playing, max_players, ${col}, last_updated, cooldown_until, run_id)
            VALUES(?, ?, ?, ?, ?, ?, 0, ?)
            ON CONFLICT(place_id, job_id) DO UPDATE SET
              playing = excluded.playing,
              max_players = excluded.max_players,
              ${col} = excluded.${col},
              last_updated = excluded.last_updated,
              run_id = excluded.run_id
          `).run(placeId, srv.jobId, srv.playing, srv.maxPlayers, ts, ts, runId);

          accepted++;
        }
      });

      tx();
      return accepted;
    } catch (err) {
      console.error('[HOP-POOL] upsertServer error:', err.message);
      return 0;
    }
  };

  // Lấy danh sách server có sẵn (chỉ Runtime hiện tại)
  const getAvailableServers = (placeId, runId, limit = 100) => {
    try {
      return db.prepare(`
        SELECT job_id, playing, max_players
        FROM hop_servers
        WHERE place_id = ?
          AND run_id = ?
          AND last_updated >= ?
        ORDER BY playing ASC
        LIMIT ?
      `).all(placeId, runId, now() - STALE_MS, limit);
    } catch (err) {
      console.error('[HOP-POOL] getAvailableServers error:', err.message);
      return [];
    }
  };

  // Helper: Get candidates từ một tier cụ thể
  const getCandidatesByTier = (placeId, runId, tier) => {
    try {
      return db.prepare(`
        SELECT job_id, playing, max_players
        FROM hop_servers
        WHERE place_id = ?
          AND run_id = ?
          AND last_updated >= ?
          AND playing >= ?
          AND playing <= ?
          AND playing < max_players
        ORDER BY RANDOM()
      `).all(placeId, runId, now() - STALE_MS, tier.min, tier.max);
    } catch (err) {
      console.error(`[HOP-POOL] getCandidatesByTier(${tier.name}) error:`, err.message);
      return [];
    }
  };

  // Lấy random server cho Reserve với ưu tiên Tier
  const selectRandomServer = (placeId, runId) => {
    try {
      for (const tier of PLAYER_TIERS) {
        const candidates = getCandidatesByTier(placeId, runId, tier);

        if (candidates.length > 0) {
          const selected = candidates[0];
          console.log(`[HOP-POOL] Tier ${tier.name}(${tier.min}-${tier.max}): candidates=${candidates.length}, selected=${selected.job_id} playing=${selected.playing}/${selected.max_players}`);
          return selected;
        }
      }

      console.log(`[HOP-POOL] No servers available across all tiers`);
      return null;
    } catch (err) {
      console.error('[HOP-POOL] selectRandomServer error:', err.message);
      return null;
    }
  };

  // Lấy Pool size của Runtime hiện tại
  const getPoolSize = (placeId, runId) => {
    try {
      const result = db.prepare(`
        SELECT COUNT(*) AS count
        FROM hop_servers
        WHERE place_id = ? AND run_id = ?
      `).get(placeId, runId);

      return result ? result.count : 0;
    } catch (err) {
      console.error('[HOP-POOL] getPoolSize error:', err.message);
      return 0;
    }
  };

  // Lấy Pool mới (< 3 phút) của Runtime hiện tại
  const getFreshServerCount = (placeId, runId) => {
    try {
      const result = db.prepare(`
        SELECT COUNT(*) AS count
        FROM hop_servers
        WHERE place_id = ?
          AND run_id = ?
          AND last_updated >= ?
      `).get(placeId, runId, now() - STALE_MS);

      return result ? result.count : 0;
    } catch (err) {
      console.error('[HOP-POOL] getFreshServerCount error:', err.message);
      return 0;
    }
  };

  // Clear Pool (gọi lúc startup/shutdown)
  const clearPool = (placeId) => {
    try {
      const result = db.prepare(`DELETE FROM hop_servers WHERE place_id = ?`).run(placeId);
      console.log(`[HOP-POOL] Cleared pool: place_id=${placeId}, removed=${result.changes}`);
      return result.changes;
    } catch (err) {
      console.error('[HOP-POOL] clearPool error:', err.message);
      return 0;
    }
  };

  // Pool stats
  const getPoolStats = (placeId, runId) => {
    try {
      const total = db.prepare(`
        SELECT COUNT(*) AS count FROM hop_servers
        WHERE place_id = ? AND run_id = ?
      `).get(placeId, runId);

      const fresh = db.prepare(`
        SELECT COUNT(*) AS count FROM hop_servers
        WHERE place_id = ? AND run_id = ? AND last_updated >= ?
      `).get(placeId, runId, now() - STALE_MS);

      const avg_players = db.prepare(`
        SELECT AVG(playing) AS avg FROM hop_servers
        WHERE place_id = ? AND run_id = ?
      `).get(placeId, runId);

      return {
        total: total ? total.count : 0,
        fresh: fresh ? fresh.count : 0,
        avg_players: avg_players && avg_players.avg ? Math.round(avg_players.avg) : 0,
        stale_ms: STALE_MS,
      };
    } catch (err) {
      console.error('[HOP-POOL] getPoolStats error:', err.message);
      return { total: 0, fresh: 0, avg_players: 0, stale_ms: STALE_MS };
    }
  };

  return {
    upsertServer,
    getAvailableServers,
    selectRandomServer,
    getPoolSize,
    getFreshServerCount,
    clearPool,
    getPoolStats,
  };
};

// Runtime Manager - V2.3 FIX
// Quản lý Runtime ID và lifecycle
// Fix: đồng bộ cleanup hop_servers + hop_verification_queue

const crypto = require('crypto');

module.exports = (db) => {
  const now = () => Date.now();

  const generateRuntimeId = () => {
    const date = new Date().toISOString().slice(0, 10).replace(/-/g, '');
    const rand = crypto.randomBytes(3).toString('hex');
    return `RUN_${date}_${rand}`;
  };

  const getActiveRuntime = () => {
    try {
      return db.prepare(`
        SELECT *
        FROM hop_runtime
        WHERE status = 'ACTIVE'
        LIMIT 1
      `).get();
    } catch (err) {
      console.error('[HOP-RUNTIME] getActiveRuntime error:', err.message);
      return null;
    }
  };

  const createRuntime = () => {
    const runId = generateRuntimeId();
    const ts = now();

    db.prepare(`
      INSERT INTO hop_runtime(run_id, started_at, stopped_at, status)
      VALUES(?, ?, NULL, 'STARTING')
    `).run(runId, ts);

    console.log(`[HOP-RUNTIME] Created: ${runId}`);

    return {
      run_id: runId,
      started_at: ts,
      status: 'STARTING',
    };
  };

  const updateRuntimeStatus = (runId, newStatus) => {
    try {
      const result = db.prepare(`
        UPDATE hop_runtime
        SET status = ?
        WHERE run_id = ?
      `).run(newStatus, runId);

      if (result.changes === 0) {
        console.warn(`[HOP-RUNTIME] Runtime not found: ${runId}`);
        return false;
      }

      console.log(`[HOP-RUNTIME] ${runId} -> ${newStatus}`);
      return true;
    } catch (err) {
      console.error('[HOP-RUNTIME] updateRuntimeStatus error:', err.message);
      return false;
    }
  };

  // ========================================================
  // STARTUP
  // ========================================================
  const startupRuntime = () => {
    console.log('[HOP-RUNTIME] === STARTUP SEQUENCE ===');

    const tx = db.transaction(() => {
      const ts = now();

      // 1. Stop các Runtime cũ
      db.prepare(`
        UPDATE hop_runtime
        SET status = 'STOPPED',
            stopped_at = ?
        WHERE status IN ('STARTING', 'ACTIVE', 'STOPPING')
      `).run(ts);

      // 2. Tạo Runtime mới
      const runtime = createRuntime();

      // 3. Xóa Queue cũ trước khi xóa Pool
      // Queue thuộc các Runtime trước không còn được sử dụng.
      const queueResult = db.prepare(`
        DELETE FROM hop_verification_queue
      `).run();

      console.log(
        `[HOP-RUNTIME] Cleared old verification queue: ${queueResult.changes}`
      );

      // 4. Xóa Pool cũ
      const poolResult = db.prepare(`
        DELETE FROM hop_servers
      `).run();

      console.log(
        `[HOP-RUNTIME] Cleared old server pool: ${poolResult.changes}`
      );

      // 5. Reset Asc / Desc source state
      db.prepare(`
        UPDATE hop_source_state
        SET
          cursor = NULL,
          page_index = 0,
          scan_id = NULL,
          scan_started_at = NULL,
          scan_completed_at = NULL,
          last_attempt_at = NULL,
          last_success_at = NULL,
          consecutive_failures = 0,
          status = 'READY',
          next_fetch_at = ?,
          last_error = NULL
      `).run(ts);

      console.log('[HOP-RUNTIME] Reset source state');

      // 6. Fence old Fetcher leases (mark for permanent caching isolation)
      // V2.4: Fence instead of expire to properly mark in-flight tasks
      db.prepare(`
        UPDATE hop_fetcher_leases
        SET status = 'FENCED', fenced_at = ?, fence_reason = 'RUNTIME_RESTART'
        WHERE status = 'ACTIVE'
      `).run(ts);

      // Also mark any in-flight tasks from fenced leases as FENCED for re-assignment
      db.prepare(`
        UPDATE hop_fetch_tasks
        SET status = 'FENCED'
        WHERE lease_id IN (
          SELECT lease_id FROM hop_fetcher_leases WHERE status = 'FENCED'
        ) AND status IN ('PENDING', 'ASSIGNED')
      `).run();

      console.log('[HOP-RUNTIME] Fenced old fetcher leases and marked in-flight tasks');

      // 7. Expire Reservations cũ
      db.prepare(`
        UPDATE hop_reservations
        SET status = 'EXPIRED'
        WHERE status IN ('RESERVED', 'JOINED')
      `).run();

      console.log('[HOP-RUNTIME] Expired old reservations');

      // 8. Expire hop_request_queue cũ
      db.prepare(`
        UPDATE hop_request_queue
        SET status = 'EXPIRED', updated_at = ?
        WHERE status IN ('QUEUED', 'GRANTED')
      `).run(ts);

      console.log('[HOP-RUNTIME] Expired old hop_request_queue');

      // 9. Offline Sessions cũ
      db.prepare(`
        UPDATE hop_sessions
        SET status = 'OFFLINE'
        WHERE status = 'ACTIVE'
      `).run();

      console.log('[HOP-RUNTIME] Offline old sessions');

      // 10. Chuyển Runtime mới sang ACTIVE trong cùng transaction
      db.prepare(`
        UPDATE hop_runtime
        SET status = 'ACTIVE'
        WHERE run_id = ?
      `).run(runtime.run_id);

      runtime.status = 'ACTIVE';

      return runtime;
    });

    const runtime = tx();

    console.log(
      `[HOP-RUNTIME] === STARTUP COMPLETE: ${runtime.run_id} ===`
    );

    return runtime;
  };

  // ========================================================
  // SHUTDOWN
  // ========================================================
  const shutdownRuntime = (runId) => {
    console.log('[HOP-RUNTIME] === SHUTDOWN SEQUENCE ===');

    if (!runId) {
      console.error('[HOP-RUNTIME] shutdownRuntime: missing runId');
      return false;
    }

    try {
      // Không cho Runtime cũ xóa dữ liệu Runtime mới.
      const activeRuntime = getActiveRuntime();

      if (activeRuntime && activeRuntime.run_id !== runId) {
        console.warn(
          `[HOP-RUNTIME] Ignore stale shutdown: requested=${runId}, active=${activeRuntime.run_id}`
        );
        return false;
      }

      const tx = db.transaction(() => {
        const runtime = db.prepare(`
          SELECT run_id, status
          FROM hop_runtime
          WHERE run_id = ?
        `).get(runId);

        if (!runtime) {
          console.warn(`[HOP-RUNTIME] Runtime not found: ${runId}`);
          return false;
        }

        const ts = now();

        // 1. Chuyển sang STOPPING
        db.prepare(`
          UPDATE hop_runtime
          SET status = 'STOPPING'
          WHERE run_id = ?
        `).run(runId);

        // 2. Xóa Queue của đúng Runtime này
        const queueResult = db.prepare(`
          DELETE FROM hop_verification_queue
          WHERE run_id = ?
        `).run(runId);

        console.log(
          `[HOP-RUNTIME] Cleared runtime queue: ${queueResult.changes}`
        );

        // 3. Xóa Pool của đúng Runtime này
        const poolResult = db.prepare(`
          DELETE FROM hop_servers
          WHERE run_id = ?
        `).run(runId);

        console.log(
          `[HOP-RUNTIME] Cleared runtime pool: ${poolResult.changes}`
        );

        // 4. Reset Source State
        db.prepare(`
          UPDATE hop_source_state
          SET
            cursor = NULL,
            page_index = 0,
            scan_id = NULL,
            scan_started_at = NULL,
            scan_completed_at = NULL,
            last_attempt_at = NULL,
            last_success_at = NULL,
            consecutive_failures = 0,
            status = 'READY',
            next_fetch_at = ?,
            last_error = NULL
        `).run(ts);

        console.log('[HOP-RUNTIME] Reset source state');

        // 5. Expire Fetcher leases
        db.prepare(`
          UPDATE hop_fetcher_lease
          SET status = 'EXPIRED'
          WHERE status = 'ACTIVE'
        `).run();

        // 6. Expire Reservations
        db.prepare(`
          UPDATE hop_reservations
          SET status = 'EXPIRED'
          WHERE status IN ('RESERVED', 'JOINED')
        `).run();

        // 7. Expire hop_request_queue
        db.prepare(`
          UPDATE hop_request_queue
          SET status = 'EXPIRED', updated_at = ?
          WHERE status IN ('QUEUED', 'GRANTED')
        `).run(ts);

        // 8. Offline Sessions
        db.prepare(`
          UPDATE hop_sessions
          SET status = 'OFFLINE'
          WHERE status = 'ACTIVE'
        `).run();

        // 9. Chuyển sang STOPPED
        db.prepare(`
          UPDATE hop_runtime
          SET status = 'STOPPED',
              stopped_at = ?
          WHERE run_id = ?
        `).run(ts, runId);

        return true;
      });

      const success = tx();

      if (!success) return false;

      console.log(
        `[HOP-RUNTIME] === SHUTDOWN COMPLETE: ${runId} ===`
      );

      return true;

    } catch (err) {
      console.error(
        '[HOP-RUNTIME] shutdownRuntime error:',
        err.stack || err.message
      );

      return false;
    }
  };

  return {
    generateRuntimeId,
    getActiveRuntime,
    createRuntime,
    updateRuntimeStatus,
    startupRuntime,
    shutdownRuntime,
  };
};

// HOP V2.4 Global Scheduler
// Điều phối mọi yêu cầu HOP qua Queue, Priority, Cooldown, Rate Limit

const crypto = require('crypto');

const SCHEDULER_CONFIG = {
  GLOBAL_HOP_INTERVAL_MS: 5000,        // Mỗi 5s cấp tối đa 1 slot
  MAX_ACTIVE_HOPS: 3,                  // Số HOP đang thực hiện đồng thời
  AUTO_HOP_COOLDOWN_MS: 120000,        // 120s cooldown/account cho auto HOP
  SOFT_REHOP_RANDOM_DELAY_MS: [10000, 30000], // 10-30s random delay
  FARM_PRIORITY: 100,
  SOFT_REHOP_PRIORITY: 10,
  REQUEST_EXPIRE_MS: 600000,           // 10 phút hết hạn request
};

const makeRequestId = () =>
  `REQ_${crypto.randomBytes(12).toString('hex')}`;

class GlobalScheduler {
  constructor(db) {
    this.db = db;
  }

  enqueueRequest(source, reason, account, placeId, currentJobId) {
    // V2.4: Thêm request vào queue với request_id + generation
    // source = FARM | STARTUP | HEARTBEAT | JOIN
    // reason = BUCKET_EMPTY | DUPLICATE_JOB | INVALID_JOB_ID

    const priority = source === 'FARM' ? SCHEDULER_CONFIG.FARM_PRIORITY : SCHEDULER_CONFIG.SOFT_REHOP_PRIORITY;
    const now = Date.now();

    // Lấy generation hiện tại
    const sessionState = this.db.prepare(`
      SELECT current_generation FROM account_session_state
      WHERE account=? AND place_id=?
      LIMIT 1
    `).get(account, placeId);
    const generation = sessionState?.current_generation || 0;

    // Tính not_before: cooldown nếu auto HOP, hoặc random delay nếu SOFT REHOP
    let notBefore = now;
    if (reason === 'DUPLICATE_JOB' && source !== 'FARM') {
      // SOFT REHOP: random delay 10-30s
      const [minMs, maxMs] = SCHEDULER_CONFIG.SOFT_REHOP_RANDOM_DELAY_MS;
      const delay = Math.floor(Math.random() * (maxMs - minMs)) + minMs;
      notBefore = now + delay;
    } else if (reason !== 'BUCKET_EMPTY') {
      // Check account cooldown
      const lastAutoHop = this.db.prepare(`
        SELECT last_auto_hop_at FROM hop_account_hop_state
        WHERE account=? AND place_id=?
      `).get(account, placeId);

      if (lastAutoHop) {
        const timeSinceLastHop = now - (lastAutoHop.last_auto_hop_at || 0);
        if (timeSinceLastHop < SCHEDULER_CONFIG.AUTO_HOP_COOLDOWN_MS) {
          notBefore = now + (SCHEDULER_CONFIG.AUTO_HOP_COOLDOWN_MS - timeSinceLastHop);
        }
      }
    }

    const expiresAt = now + SCHEDULER_CONFIG.REQUEST_EXPIRE_MS;

    try {
      // V2.4: Try INSERT first, if conflict then nâng priority
      const requestId = makeRequestId();
      const stmt = this.db.prepare(`
        INSERT INTO hop_request_queue (
          request_id, account, place_id, current_job_id, source, reason,
          priority, status, created_at, updated_at, not_before, expires_at, attempts, generation
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
      `);

      try {
        stmt.run(
          requestId, account, placeId, currentJobId, source, reason,
          priority, 'QUEUED', now, now, notBefore, expiresAt, 1, generation
        );
        return { ok: true, requestId };
      } catch (insertErr) {
        // Conflict: account đã có request active, nâng priority nếu FARM
        if (insertErr.message.includes('UNIQUE')) {
          const existing = this.db.prepare(`
            SELECT request_id, priority, status FROM hop_request_queue
            WHERE account=? AND place_id=? AND status IN ('QUEUED', 'GRANTED')
            LIMIT 1
          `).get(account, placeId);

          if (existing) {
            // Nâng priority nếu priority mới > priority cũ
            const newPriority = Math.max(existing.priority, priority);
            this.db.prepare(`
              UPDATE hop_request_queue
              SET priority=?, source=?, reason=?, current_job_id=?,
                  updated_at=?, attempts=attempts+1, not_before=?, generation=?
              WHERE request_id=?
            `).run(newPriority, source, reason, currentJobId, now, notBefore, generation, existing.request_id);

            console.log(`[SCHEDULER] Enqueue: Upgraded priority to ${newPriority} for account=${account}`);
            return { ok: true, requestId: existing.request_id };
          }
        }
        throw insertErr;
      }
    } catch (err) {
      console.error('[SCHEDULER] Enqueue failed:', err.message);
      return { ok: false, error: err.message };
    }
  }

  pollScheduler() {
    // V2.4: Mỗi 5s (or when next_allowed_at passes), pop request từ queue, cấp slot
    // Persistent rate limit: dùng hop_scheduler_state, không RAM variable
    const now = Date.now();

    try {
      const tx = this.db.transaction(() => {
        // Expire old requests
        this.db.prepare(`
          UPDATE hop_request_queue
          SET status='EXPIRED', updated_at=?
          WHERE status='QUEUED' AND expires_at <= ?
        `).run(now, now);

        // Expire GRANTED requests abandoned by dead clients
        this.db.prepare(`
          UPDATE hop_request_queue
          SET status='EXPIRED', updated_at=?
          WHERE status='GRANTED' AND updated_at < ?
        `).run(now, now - 60000);

        // Count active HOPs: GRANTED requests + RESERVED reservations
        const activeCount = this.db.prepare(`
          SELECT
            (SELECT COUNT(*) FROM hop_request_queue WHERE status='GRANTED' AND expires_at > ?) +
            (SELECT COUNT(*) FROM hop_reservations WHERE status='RESERVED' AND expires_at > ?) AS count
        `).get(now, now).count;

        if (activeCount >= SCHEDULER_CONFIG.MAX_ACTIVE_HOPS) {
          return [];  // Slot full
        }

        // Find next eligible request (not blocked by rate limit)
        const next = this.db.prepare(`
          SELECT request_id, account, place_id, current_job_id, source, reason, priority, created_at, generation
          FROM hop_request_queue
          WHERE status='QUEUED' AND not_before <= ?
          ORDER BY priority DESC, created_at ASC
          LIMIT 1
        `).get(now);

        if (!next) {
          return [];
        }

        // Hybrid C: Generation sanity check - reject stale requests from old clients
        const sessionState = this.db.prepare(`
          SELECT current_generation FROM account_session_state
          WHERE account=? AND place_id=?
          LIMIT 1
        `).get(next.account, next.place_id);

        if (sessionState && sessionState.current_generation !== next.generation) {
          // Stale request from old generation (after Handoff), mark as EXPIRED
          this.db.prepare(`
            UPDATE hop_request_queue
            SET status='EXPIRED', updated_at=?
            WHERE request_id=?
          `).run(now, next.request_id);

          console.log(`[SCHEDULER] Rejected stale request: account=${next.account}, generation=${next.generation} (current=${sessionState.current_generation})`);
          return [];  // Try next request
        }

        // Check if we're within rate limit window
        const schedulerState = this.db.prepare(`
          SELECT next_allowed_at FROM hop_scheduler_state
          WHERE place_id=?
        `).get(next.place_id);

        if (schedulerState && schedulerState.next_allowed_at > now) {
          // Still within cooldown, can't grant yet
          return [];
        }

        // Grant this request
        this.db.prepare(`
          UPDATE hop_request_queue
          SET status='GRANTED', updated_at=?, slot_granted_at=?
          WHERE request_id=?
        `).run(now, now, next.request_id);

        // Update scheduler state: next slot available 5s from now
        this.db.prepare(`
          INSERT OR REPLACE INTO hop_scheduler_state (place_id, next_allowed_at, last_granted_at, updated_at)
          VALUES (?, ?, ?, ?)
        `).run(next.place_id, now + SCHEDULER_CONFIG.GLOBAL_HOP_INTERVAL_MS, now, now);

        console.log(`[SCHEDULER] Granted slot for ${next.source} HOP (place=${next.place_id}, priority=${next.priority})`);
        return [next];
      });

      return tx();
    } catch (err) {
      console.error('[SCHEDULER] Poll failed:', err.message);
      return [];
    }
  }

  getNextReservation(account, placeId) {
    // V2.4: Client polls để lấy granted request
    // ĐỀ PHÒNG: Không mark CONSUMED ở đây - để hop.js xử lý khi Reservation created thành công
    // Nếu mark quá sớm, request bị mất nếu hopReserve() fail → client mắc kẹt WAITING_SLOT
    const now = Date.now();
    try {
      const granted = this.db.prepare(`
        SELECT request_id, source, reason, current_job_id FROM hop_request_queue
        WHERE account=? AND place_id=? AND status='GRANTED' AND expires_at > ?
        LIMIT 1
      `).get(account, placeId, now);

      if (!granted) {
        return null;
      }

      return {
        requestId: granted.request_id,
        source: granted.source,
        reason: granted.reason,
        currentJobId: granted.current_job_id,
      };
    } catch (err) {
      console.error('[SCHEDULER] getNextReservation failed:', err.message);
      return null;
    }
  }

  getStatus(placeId) {
    // V2.4: Trả về trạng thái Queue cho monitoring
    const now = Date.now();
    try {
      const queueRow = this.db.prepare(`
        SELECT COUNT(*) AS count FROM hop_request_queue
        WHERE place_id=? AND status='QUEUED' AND expires_at > ?
      `).get(placeId, now);
      const queued = queueRow?.count || 0;

      const grantedRow = this.db.prepare(`
        SELECT COUNT(*) AS count FROM hop_request_queue
        WHERE place_id=? AND status='GRANTED'
      `).get(placeId);
      const granted = grantedRow?.count || 0;

      const nextRequest = this.db.prepare(`
        SELECT not_before FROM hop_request_queue
        WHERE place_id=? AND status='QUEUED' AND expires_at > ?
        ORDER BY priority DESC, created_at ASC
        LIMIT 1
      `).get(placeId, now);

      const nextAllowedAt = this.db.prepare(`
        SELECT next_allowed_at FROM hop_scheduler_state
        WHERE place_id=?
      `).get(placeId);

      return {
        ok: true,
        placeId,
        queued,
        granted,
        active: granted,
        maxActive: SCHEDULER_CONFIG.MAX_ACTIVE_HOPS,
        nextSlotMs: Math.max(0, (nextAllowedAt?.next_allowed_at || 0) - now),
        nextRequestWaitMs: nextRequest ? Math.max(0, nextRequest.not_before - now) : null,
      };
    } catch (err) {
      return { ok: false, error: err.message };
    }
  }
}

module.exports = { GlobalScheduler, SCHEDULER_CONFIG };

// Fetcher Service - Phase 2
// Quản lý Fetcher Claim, Heartbeat, Task, Report

const crypto = require('crypto');

const REVALIDATE_INTERVAL_MS = 150000; // 2.5 minutes (150 seconds)

module.exports = (db, sourceStateService, runtimeManager, verificationService, config = {}) => {
  const now = () => Date.now();
  const id = (prefix) => `${prefix}_${crypto.randomBytes(8).toString('hex')}`;

  // Hybrid C: validateSessionGeneration - Kiểm tra Session + Generation còn hiệu lực
  const validateSessionGeneration = (sessionId, generation, leaseId) => {
    try {
      const session = db.prepare(`
        SELECT status FROM hop_session_history
        WHERE session_id = ? AND generation = ?
        LIMIT 1
      `).get(sessionId, generation);

      if (!session) {
        return { valid: false, reason: 'SESSION_NOT_FOUND', code: 'SESSION_NOT_FOUND' };
      }

      if (session.status !== 'ACTIVE') {
        return { valid: false, reason: 'SESSION_NOT_ACTIVE', code: 'STALE_GENERATION' };
      }

      // Kiểm tra Lease có còn gắn với Session này không
      if (leaseId) {
        const lease = db.prepare(`
          SELECT status FROM hop_fetcher_leases
          WHERE lease_id = ? AND session_id = ? AND generation = ?
          LIMIT 1
        `).get(leaseId, sessionId, generation);

        if (!lease) {
          return { valid: false, reason: 'LEASE_MISMATCH', code: 'LEASE_FENCED' };
        }

        if (lease.status === 'RELEASED' || lease.status === 'FENCED') {
          return { valid: false, reason: 'LEASE_NOT_ACTIVE', code: 'LEASE_FENCED' };
        }
      }

      return { valid: true };
    } catch (err) {
      console.error('[HOP-FETCHER] validateSessionGeneration error:', err.message);
      return { valid: false, reason: 'ERROR', code: 'ERROR' };
    }
  };

  // Hybrid C: validateLeaseFence - Kiểm tra Lease còn active hay đã bị fence
  const validateLeaseFence = (leaseId, sessionId, generation) => {
    try {
      const ts = now();
      const lease = db.prepare(`
        SELECT status, expires_at, session_id, generation FROM hop_fetcher_leases
        WHERE lease_id = ?
        LIMIT 1
      `).get(leaseId);

      if (!lease) {
        return { valid: false, reason: 'LEASE_NOT_FOUND', code: 'LEASE_NOT_FOUND' };
      }

      if (lease.status === 'RELEASED' || lease.status === 'FENCED' || lease.status === 'EXPIRED') {
        return { valid: false, reason: 'LEASE_NOT_ACTIVE', code: 'LEASE_FENCED' };
      }

      if (lease.expires_at < ts) {
        return { valid: false, reason: 'LEASE_EXPIRED', code: 'LEASE_FENCED' };
      }

      // Kiểm tra Lease còn gắn với đúng Session/Generation không
      if (lease.session_id !== sessionId || lease.generation !== generation) {
        return { valid: false, reason: 'LEASE_GENERATION_MISMATCH', code: 'STALE_GENERATION' };
      }

      return { valid: true };
    } catch (err) {
      console.error('[HOP-FETCHER] validateLeaseFence error:', err.message);
      return { valid: false, reason: 'ERROR', code: 'ERROR' };
    }
  };

  // Hybrid C: getLeaseStatus - Trả về trạng thái chi tiết của Lease
  const getLeaseStatus = (leaseId) => {
    try {
      const ts = now();
      const lease = db.prepare(`
        SELECT
          lease_id, place_id, account, session_id, generation, status,
          expires_at, heartbeat_at, created_at, released_at, fenced_at
        FROM hop_fetcher_leases
        WHERE lease_id = ?
        LIMIT 1
      `).get(leaseId);

      if (!lease) {
        return { found: false, status: 'NOT_FOUND' };
      }

      const status = {
        found: true,
        leaseId: lease.lease_id,
        placeId: lease.place_id,
        account: lease.account,
        sessionId: lease.session_id,
        generation: lease.generation,
        status: lease.status,
        isActive: lease.status === 'ACTIVE' && lease.expires_at >= ts,
        isStopping: lease.status === 'STOPPING',
        isExpired: lease.expires_at < ts,
        expiresAt: lease.expires_at,
        expiresIn: lease.expires_at - ts,
        heartbeatAt: lease.heartbeat_at,
        createdAt: lease.created_at,
        releasedAt: lease.released_at,
        fencedAt: lease.fenced_at,
      };

      return status;
    } catch (err) {
      console.error('[HOP-FETCHER] getLeaseStatus error:', err.message);
      return { found: false, status: 'ERROR', error: err.message };
    }
  };

  // Hybrid C: getInFlightTasks - Đếm Task đang xử lý của Lease
  const getInFlightTasks = (leaseId, sessionId, generation) => {
    try {
      const result = db.prepare(`
        SELECT COUNT(*) as count FROM hop_fetch_tasks
        WHERE lease_id = ? AND session_id = ? AND generation = ?
          AND status IN ('ASSIGNED', 'PENDING')
        LIMIT 1
      `).get(leaseId, sessionId, generation);

      return { inFlight: result?.count || 0 };
    } catch (err) {
      console.error('[HOP-FETCHER] getInFlightTasks error:', err.message);
      return { inFlight: 0, error: err.message };
    }
  };

  // Hybrid C: drainLease - Chuyển Lease sang STOPPING, ngừng cấp Task mới
  const drainLease = (leaseId) => {
    try {
      const ts = now();
      const lease = db.prepare(`
        SELECT lease_id, status FROM hop_fetcher_leases
        WHERE lease_id = ? LIMIT 1
      `).get(leaseId);

      if (!lease) {
        return { ok: false, error: 'Lease not found' };
      }

      if (lease.status === 'STOPPING' || lease.status === 'RELEASED' || lease.status === 'FENCED') {
        return { ok: true, alreadyDrained: true };
      }

      db.prepare(`
        UPDATE hop_fetcher_leases
        SET status = 'STOPPING', stop_requested_at = ?
        WHERE lease_id = ?
      `).run(ts, leaseId);

      console.log(`[HOP-FETCHER] Drained lease: ${leaseId} (ACTIVE → STOPPING)`);
      return { ok: true };
    } catch (err) {
      console.error('[HOP-FETCHER] drainLease error:', err.message);
      return { ok: false, error: err.message };
    }
  };

  // Hybrid C: fenceLease - Chặn Lease khỏi mọi API, đánh dấu Task chưa hoàn tất để cấp lại
  const fenceLease = (leaseId, reason = 'DRAIN_TIMEOUT') => {
    try {
      const ts = now();
      const lease = db.prepare(`
        SELECT lease_id, status FROM hop_fetcher_leases
        WHERE lease_id = ? LIMIT 1
      `).get(leaseId);

      if (!lease) {
        return { ok: false, error: 'Lease not found' };
      }

      // Transaction: Fence Lease + đánh dấu Task chưa hoàn tất
      const tx = db.transaction(() => {
        // Fence Lease
        db.prepare(`
          UPDATE hop_fetcher_leases
          SET status = 'FENCED', fenced_at = ?, fence_reason = ?
          WHERE lease_id = ?
        `).run(ts, reason, leaseId);

        // Đánh dấu Task chưa hoàn tất (PENDING, ASSIGNED) thành FENCED để có thể cấp lại an toàn
        db.prepare(`
          UPDATE hop_fetch_tasks
          SET status = 'FENCED'
          WHERE lease_id = ? AND status IN ('PENDING', 'ASSIGNED')
        `).run(leaseId);

        console.log(`[HOP-FETCHER] Fenced lease: ${leaseId} (reason: ${reason})`);
      });

      tx();
      return { ok: true };
    } catch (err) {
      console.error('[HOP-FETCHER] fenceLease error:', err.message);
      return { ok: false, error: err.message };
    }
  };

  // Hybrid C: recoverUnfinishedTasks - Đánh dấu Task cũ thành UNFINISHED để cấp cho Fetcher mới
  const recoverUnfinishedTasks = (oldLeaseId) => {
    try {
      const ts = now();
      const result = db.prepare(`
        UPDATE hop_fetch_tasks
        SET status = 'UNFINISHED', recovery_started_at = ?
        WHERE lease_id = ? AND status IN ('PENDING', 'ASSIGNED')
      `).run(ts, oldLeaseId);

      console.log(`[HOP-FETCHER] Recovered ${result.changes} unfinished tasks from lease ${oldLeaseId}`);
      return { ok: true, recovered: result.changes };
    } catch (err) {
      console.error('[HOP-FETCHER] recoverUnfinishedTasks error:', err.message);
      return { ok: false, error: err.message };
    }
  };

  // Claim Fetcher quyền
  const claimFetcher = (placeId, account, jobId) => {
    const runtime = runtimeManager.getActiveRuntime();
    if (!runtime || runtime.status !== 'ACTIVE') {
      console.log(`[HOP-FETCHER] Claim denied: Runtime not ACTIVE (${runtime ? runtime.status : 'NULL'})`);
      return { ok: false, code: 'RUNTIME_NOT_READY', error: 'Runtime not ready' };
    }

    const collectorId = id('COL');
    const leaseToken = crypto.randomBytes(32).toString('hex');
    const ts = now();
    const leaseExpires = ts + 90000; // 90s TTL

    try {
      // Phase 1 Fix: Transaction để tránh race condition
      const tx = db.transaction(() => {
        // Check existing ACTIVE lease (còn hiệu lực)
        const existing = db.prepare(`
          SELECT collector_id, status FROM hop_fetcher_lease
          WHERE place_id = ? AND status = 'ACTIVE' AND expires_at >= ?
        `).get(placeId, ts);

        if (existing) {
          throw new Error(`FETCHER_BUSY: ${existing.collector_id} already active`);
        }

        // Clean up old leases (expired hoặc RELEASED)
        db.prepare(`
          DELETE FROM hop_fetcher_lease
          WHERE place_id = ? AND (status != 'ACTIVE' OR expires_at < ?)
        `).run(placeId, ts);

        // INSERT new lease
        db.prepare(`
          INSERT INTO hop_fetcher_lease(place_id, collector_id, lease_token_hash, account, heartbeat_at, expires_at, status)
          VALUES(?, ?, ?, ?, ?, ?, 'ACTIVE')
        `).run(placeId, collectorId, crypto.createHash('sha256').update(leaseToken).digest('hex'), account, ts, leaseExpires);

        return { collectorId, leaseToken };
      });

      const result = tx();
      console.log(`[HOP-FETCHER] Claimed: ${result.collectorId} runtimeId=${runtime.run_id}`);
      return { ok: true, collectorId: result.collectorId, leaseToken: result.leaseToken, runtimeId: runtime.run_id };
    } catch (err) {
      if (err.message.includes('FETCHER_BUSY')) {
        console.log(`[HOP-FETCHER] Claim denied: ${err.message}`);
        return { ok: false, code: 'FETCHER_BUSY', error: err.message };
      }
      if (err.message.includes('UNIQUE')) {
        console.log(`[HOP-FETCHER] Claim conflict: UNIQUE constraint (old lease still exists)`);
        return { ok: false, code: 'FETCHER_BUSY', error: 'Fetcher already active' };
      }
      console.error('[HOP-FETCHER] Claim error:', err.message);
      return { ok: false, error: err.message };
    }
  };

  // Heartbeat để gia hạn Lease
  const heartbeatFetcher = (placeId, collectorId, leaseToken) => {
    const ts = now();
    const tokenHash = crypto.createHash('sha256').update(leaseToken).digest('hex');

    try {
      // P1 Fix: Kiểm tra lease còn hiệu lực trước khi gia hạn
      const lease = db.prepare(`
        SELECT expires_at FROM hop_fetcher_lease
        WHERE place_id = ? AND collector_id = ? AND lease_token_hash = ? AND status = 'ACTIVE' AND expires_at >= ?
      `).get(placeId, collectorId, tokenHash, ts);

      if (!lease) {
        console.log(`[HOP-FETCHER] Heartbeat: lease not found or expired for ${collectorId}`);
        return { ok: false, error: 'Lease not found or expired' };
      }

      const newExpires = ts + 90000;
      db.prepare(`
        UPDATE hop_fetcher_lease
        SET heartbeat_at = ?, expires_at = ?
        WHERE place_id = ? AND collector_id = ? AND lease_token_hash = ?
      `).run(ts, newExpires, placeId, collectorId, tokenHash);

      console.log(`[HOP-FETCHER] Heartbeat: extended lease expires_at=${newExpires} (now=${ts})`);
      return { ok: true };
    } catch (err) {
      console.error('[HOP-FETCHER] Heartbeat error:', err.message);
      return { ok: false, error: err.message };
    }
  };

  // Get Task: nói cho Fetcher biết fetch gì tiếp theo
  const getTask = (placeId, collectorId, leaseToken) => {
    const ts = now();
    const tokenHash = crypto.createHash('sha256').update(leaseToken).digest('hex');

    try {
      const runtime = runtimeManager.getActiveRuntime();
      if (!runtime || runtime.status !== 'ACTIVE') {
        return { action: 'WAIT', waitMs: 5000, reason: 'RUNTIME_NOT_ACTIVE' };
      }

      const lease = db.prepare(`
        SELECT expires_at FROM hop_fetcher_lease
        WHERE place_id = ? AND collector_id = ? AND lease_token_hash = ? AND status = 'ACTIVE' AND expires_at >= ?
      `).get(placeId, collectorId, tokenHash, ts);

      if (!lease) {
        console.log(`[HOP-FETCHER] GetTask: lease not found (now=${ts})`);
        return { action: 'WAIT', waitMs: 5000, reason: 'LEASE_EXPIRED' };
      }

      // Phase 1 Fix: Check STOPPING status - don't give new tasks
      const fullLease = db.prepare(`
        SELECT status FROM hop_fetcher_lease
        WHERE place_id = ? AND collector_id = ? AND lease_token_hash = ?
      `).get(placeId, collectorId, tokenHash);

      if (fullLease && fullLease.status === 'STOPPING') {
        console.log(`[HOP-FETCHER] GetTask: fetcher in STOPPING mode, waiting for teleport`);
        return { action: 'WAIT', waitMs: 10000, reason: 'FETCHER_STOPPING' };
      }

      const nextSource = sourceStateService.getNextSource(placeId);

      if (!nextSource) {
        return { action: 'WAIT', waitMs: 5000, reason: 'NO_SOURCE' };
      }

      if (nextSource.waitMs) {
        return { action: 'WAIT', waitMs: nextSource.waitMs, reason: 'SOURCE_COOLDOWN' };
      }

      const source = typeof nextSource === 'string' ? nextSource : nextSource.source;
      if (!source) {
        return { action: 'WAIT', waitMs: 5000, reason: 'NO_VALID_SOURCE' };
      }

      const sourceState = sourceStateService.getSourceState(placeId, source);

      // P4-2 Fix: TEST_MODE dừng scan tại MAX_PAGES
      if (config.testMode && sourceState && (sourceState.page_index || 0) >= config.maxPagesPerSource) {
        console.log(`[HOP-FETCHER] TEST_MODE: Reached max pages (${sourceState.page_index}/${config.maxPagesPerSource}) for ${source}, waiting for next cycle`);
        return { action: 'WAIT', waitMs: 60000, reason: 'TEST_MODE_LIMIT_REACHED' };
      }

      // P0-1 Fix: Giữ scan_id xuyên suốt tất cả page của một lần quét
      let scanId = sourceState.scan_id;
      if (!scanId) {
        // Tạo scan ID mới khi bắt đầu scan
        scanId = `${source}_SCAN_${ts}_${crypto.randomBytes(4).toString('hex')}`;
        // LƯU vào source state để tất cả page tiếp theo dùng chung ID này
        sourceStateService.updateSourceState(placeId, source, { scan_id: scanId });
        console.log(`[HOP-FETCHER] Created new scan: ${scanId}`);
      }

      // Debug log để xác nhận updateSourceState hoạt động
      console.log(`[HOP-SOURCE-DEBUG] source=${source} scanId=${scanId} page=${sourceState.page_index || 0} hasCursor=${Boolean(sourceState.cursor)}`);

      // Check for existing PENDING task for this collector + source + page
      const existingTask = db.prepare(`
        SELECT task_id, scan_id, cursor_hash
        FROM hop_fetch_tasks
        WHERE collector_id = ? AND run_id = ? AND place_id = ? AND source = ?
          AND page_index = ? AND status = 'PENDING'
        ORDER BY created_at DESC
        LIMIT 1
      `).get(collectorId, runtime.run_id, placeId, source, sourceState.page_index || 0);

      let taskId, taskScanId, cursorHash;

      if (existingTask) {
        // Return existing PENDING task
        taskId = existingTask.task_id;
        taskScanId = existingTask.scan_id;
        cursorHash = existingTask.cursor_hash;
        console.log(`[HOP-FETCHER] Reusing PENDING task: ${taskId}`);
      } else {
        // Create new task
        taskId = id('TASK');
        taskScanId = scanId;
        cursorHash = sourceState.cursor ? crypto.createHash('sha256').update(sourceState.cursor).digest('hex') : null;

        db.prepare(`
          INSERT INTO hop_fetch_tasks(
            task_id, collector_id, run_id, place_id, source, scan_id, page_index, cursor_hash, status, created_at
          ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'PENDING', ?)
        `).run(
          taskId, collectorId, runtime.run_id, placeId, source, taskScanId,
          sourceState.page_index || 0, cursorHash, ts
        );
      }

      return {
        action: 'FETCH',
        runtimeId: runtime.run_id,
        taskId: taskId,
        source: source,
        scanId: taskScanId,
        pageIndex: sourceState.page_index || 0,
        cursor: sourceState.cursor || null,
        limit: 100,
      };
    } catch (err) {
      console.error('[HOP-FETCHER] GetTask error:', err.message);
      return { action: 'WAIT', waitMs: 5000, reason: 'ERROR' };
    }
  };

  // Report: save servers from Fetcher with detailed statistics
  const reportServers = (placeId, collectorId, leaseToken, taskId, runtimeId, scanId, pageIndex, cursorUsed, source, servers, nextCursor, serverPoolService) => {
    const ts = now();
    const tokenHash = crypto.createHash('sha256').update(leaseToken).digest('hex');

    try {
      // 1. Validate Runtime
      const runtime = runtimeManager.getActiveRuntime();
      if (!runtime || runtime.status !== 'ACTIVE') {
        return { ok: false, error: 'Runtime not ACTIVE' };
      }

      // Verify Runtime ID matches
      if (runtimeId !== runtime.run_id) {
        console.log(`[HOP-FETCHER] Report rejected: Runtime mismatch (expected=${runtime.run_id}, got=${runtimeId})`);
        return { ok: false, error: 'Runtime mismatch' };
      }

      // 2. Validate Lease
      const lease = db.prepare(`
        SELECT expires_at FROM hop_fetcher_lease
        WHERE place_id = ? AND collector_id = ? AND lease_token_hash = ? AND status = 'ACTIVE' AND expires_at >= ?
      `).get(placeId, collectorId, tokenHash, ts);

      if (!lease) {
        return { ok: false, error: 'Lease expired' };
      }

      // 3. Validate Task & check idempotency
      const task = db.prepare(`
        SELECT status, servers_count, source, scan_id, page_index, cursor_hash
        FROM hop_fetch_tasks
        WHERE task_id = ? AND collector_id = ? AND run_id = ? AND place_id = ?
      `).get(taskId, collectorId, runtime.run_id, placeId);

      if (!task) {
        console.log(`[HOP-FETCHER] Report rejected: Task not found (taskId=${taskId})`);
        return { ok: false, error: 'Task not found' };
      }

      if (task.status === 'COMPLETED') {
        console.log(`[HOP-FETCHER] Report idempotent: Task already completed (taskId=${taskId})`);
        return { ok: true, idempotent: true, serversCount: task.servers_count };
      }

      // Validate Task metadata matches Report
      if (task.source !== source) {
        console.log(`[HOP-FETCHER] Report rejected: Source mismatch (task=${task.source} report=${source})`);
        return { ok: false, error: 'Source mismatch' };
      }

      if (task.page_index !== pageIndex) {
        console.log(`[HOP-FETCHER] Report rejected: Page mismatch (task=${task.page_index} report=${pageIndex})`);
        return { ok: false, error: 'Page index mismatch' };
      }

      // Validate cursor hash
      const reportCursorHash = cursorUsed ? crypto.createHash('sha256').update(cursorUsed).digest('hex') : null;
      if (task.cursor_hash !== reportCursorHash) {
        console.log(`[HOP-FETCHER] Report rejected: Cursor mismatch`);
        return { ok: false, error: 'Cursor mismatch' };
      }

      if (!Array.isArray(servers) || servers.length > 100) {
        return { ok: false, error: 'Invalid servers array' };
      }

      // Use Scan ID from Task (don't create new one)
      const taskScanId = task.scan_id;

      // P1-2 Fix: Validate Report Scan ID khớp Task
      if (scanId !== taskScanId) {
        console.log(`[HOP-FETCHER] Report rejected: Scan ID mismatch (task=${taskScanId} report=${scanId})`);
        return { ok: false, error: 'Scan ID mismatch' };
      }

      // Helper: Mark FULL and clean queue in transaction
      const markFullAndClean = (jobId, playing, maxPlayers) => {
        const tx = db.transaction(() => {
          const result = db.prepare(`
            UPDATE hop_servers
            SET
              run_id = ?,
              playing = ?,
              max_players = ?,
              last_updated = ?,
              verify_status = 'FULL',
              eligible = 0,
              last_verified_at = ?,
              next_verify_at = ?,
              last_seen_asc_scan_id = CASE WHEN ? = 'Asc' THEN ? ELSE last_seen_asc_scan_id END,
              last_seen_desc_scan_id = CASE WHEN ? = 'Desc' THEN ? ELSE last_seen_desc_scan_id END,
              last_observed_at = ?
            WHERE place_id = ?
              AND job_id = ?
          `).run(
            runtime.run_id, playing, maxPlayers, ts, ts,
            ts + REVALIDATE_INTERVAL_MS,
            source, scanId, source, scanId, ts,
            placeId, jobId
          );

          if (result.changes > 0) {
            db.prepare(`
              DELETE FROM hop_verification_queue
              WHERE run_id = ? AND place_id = ? AND job_id = ?
            `).run(runtime.run_id, placeId, jobId);
          }
        });
        tx();
      };

      // Helper: Mark OUT_OF_RANGE and clean queue in transaction
      const markOutOfRangeAndClean = (jobId, playing, maxPlayers) => {
        const tx = db.transaction(() => {
          const result = db.prepare(`
            UPDATE hop_servers
            SET
              run_id = ?,
              playing = ?,
              max_players = ?,
              last_updated = ?,
              verify_status = 'OUT_OF_RANGE',
              eligible = 0,
              last_verified_at = ?,
              next_verify_at = ?,
              last_seen_asc_scan_id = CASE WHEN ? = 'Asc' THEN ? ELSE last_seen_asc_scan_id END,
              last_seen_desc_scan_id = CASE WHEN ? = 'Desc' THEN ? ELSE last_seen_desc_scan_id END,
              last_observed_at = ?
            WHERE place_id = ?
              AND job_id = ?
          `).run(
            runtime.run_id, playing, maxPlayers, ts, ts,
            ts + REVALIDATE_INTERVAL_MS,
            source, scanId, source, scanId, ts,
            placeId, jobId
          );

          if (result.changes > 0) {
            db.prepare(`
              DELETE FROM hop_verification_queue
              WHERE run_id = ?
                AND place_id = ?
                AND job_id = ?
            `).run(runtime.run_id, placeId, jobId);
          }

          return result.changes > 0;
        });

        return tx();
      };

      // 4. Process servers with detailed statistics
      const stats = {
        received: servers.length,
        newAdded: 0,
        matchedExisting: 0,
        updated: 0,
        reactivated: 0,
        removedOutOfRange: 0,
        skippedZero: 0,
        skippedAbove8: 0,
        duplicates: 0,
      };

      const seenJobIds = new Set();
      const eligibleServers = [];

      for (const srv of servers) {
        if (!srv.jobId || typeof srv.playing !== 'number' || typeof srv.maxPlayers !== 'number') {
          continue;
        }

        const jobId = String(srv.jobId);
        const playing = srv.playing;
        const maxPlayers = srv.maxPlayers;

        // Check duplicates in this report
        if (seenJobIds.has(jobId)) {
          stats.duplicates++;
          continue;
        }
        seenJobIds.add(jobId);

        // Classify server capacity FIRST (before range check)
        // FULL: playing >= maxPlayers
        if (playing >= maxPlayers) {
          stats.skippedFull = (stats.skippedFull || 0) + 1;
          const existing = db.prepare(`SELECT verify_status FROM hop_servers WHERE place_id = ? AND job_id = ?`).get(placeId, jobId);
          if (existing) {
            markFullAndClean(jobId, playing, maxPlayers);
            stats.removedFull = (stats.removedFull || 0) + 1;
          }
          continue;
        }

        // Classify server by player range
        if (playing === 0) {
          stats.skippedZero++;
          // Mark existing server as OUT_OF_RANGE and clean queue
          const existing = db.prepare(`SELECT verify_status FROM hop_servers WHERE place_id = ? AND job_id = ?`).get(placeId, jobId);
          if (existing) {
            markOutOfRangeAndClean(jobId, 0, maxPlayers);
            stats.removedOutOfRange++;
          }
          continue;
        }

        if (playing < 1 || playing > 8) {
          stats.skippedAbove8++;
          // Mark existing server as OUT_OF_RANGE and clean queue
          const existing = db.prepare(`SELECT verify_status, playing FROM hop_servers WHERE place_id = ? AND job_id = ?`).get(placeId, jobId);
          if (existing) {
            if (existing.verify_status === 'ACTIVE') {
              stats.statusChanged = (stats.statusChanged || 0) + 1;
              console.log(`[HOP-VERIFY] ${jobId} ACTIVE→OUT_OF_RANGE: old=${existing.playing} new=${playing}`);
            }
            markOutOfRangeAndClean(jobId, playing, maxPlayers);
            stats.removedOutOfRange++;
          }
          continue;
        }

        // Server is in valid range 1-8 and not FULL
        const existing = db.prepare(`
          SELECT verify_status, playing FROM hop_servers
          WHERE place_id = ? AND job_id = ?
        `).get(placeId, jobId);

        if (existing) {
          stats.matchedExisting++;
          const oldStatus = existing.verify_status;
          const playerChanged = existing.playing !== playing;

          // Check if reactivating from FULL or OUT_OF_RANGE
          if (oldStatus === 'FULL') {
            stats.reactivated++;
            if (playerChanged) {
              stats.statusChanged = (stats.statusChanged || 0) + 1;
              console.log(`[HOP-VERIFY] ${jobId} FULL→ACTIVE: old=${existing.playing} new=${playing}`);
            }
          } else if (oldStatus === 'OUT_OF_RANGE') {
            stats.reactivated++;
            if (playerChanged) {
              stats.statusChanged = (stats.statusChanged || 0) + 1;
              console.log(`[HOP-VERIFY] ${jobId} OUT_OF_RANGE→ACTIVE: old=${existing.playing} new=${playing}`);
            }
          } else {
            stats.updated++;
            if (playerChanged) {
              stats.playerChanged = (stats.playerChanged || 0) + 1;
              console.log(`[HOP-VERIFY] ${jobId} playerUpdate: old=${existing.playing} new=${playing}`);
            }
          }
        } else {
          stats.newAdded++;
        }

        eligibleServers.push({
          jobId,
          playing,
          maxPlayers,
          source,
          scanId,
        });
      }

      // 5. Upsert eligible servers
      if (eligibleServers.length > 0) {
        const tx = db.transaction(() => {
          for (const srv of eligibleServers) {
            db.prepare(`
              INSERT INTO hop_servers(
                place_id, job_id, playing, max_players, last_updated, run_id,
                verify_status, eligible, last_verified_at, next_verify_at, last_seen_scan_id,
                added_at, last_observed_at, last_source,
                last_seen_asc_scan_id, last_seen_desc_scan_id,
                low_seen_at, busy_seen_at
              )
              VALUES(?, ?, ?, ?, ?, ?, 'ACTIVE', 1, ?, ?, ?,
                ?, ?, ?,
                CASE WHEN ? = 'Asc' THEN ? ELSE NULL END,
                CASE WHEN ? = 'Desc' THEN ? ELSE NULL END,
                CASE WHEN ? = 'Asc' THEN ? ELSE NULL END,
                CASE WHEN ? = 'Desc' THEN ? ELSE NULL END
              )
              ON CONFLICT(place_id, job_id) DO UPDATE SET
                playing = excluded.playing,
                max_players = excluded.max_players,
                last_updated = excluded.last_updated,
                run_id = excluded.run_id,
                verify_status = 'ACTIVE',
                eligible = 1,
                last_verified_at = excluded.last_verified_at,
                next_verify_at = excluded.next_verify_at,
                last_seen_scan_id = excluded.last_seen_scan_id,
                last_observed_at = excluded.last_observed_at,
                last_source = excluded.last_source,
                last_seen_asc_scan_id = CASE WHEN ? = 'Asc' THEN ? ELSE last_seen_asc_scan_id END,
                last_seen_desc_scan_id = CASE WHEN ? = 'Desc' THEN ? ELSE last_seen_desc_scan_id END,
                low_seen_at = CASE WHEN ? = 'Asc' THEN ? ELSE low_seen_at END,
                busy_seen_at = CASE WHEN ? = 'Desc' THEN ? ELSE busy_seen_at END
            `).run(
              placeId, srv.jobId, srv.playing, srv.maxPlayers, ts, runtime.run_id,
              ts, ts + REVALIDATE_INTERVAL_MS, srv.scanId,
              ts, ts, source,
              srv.source, srv.scanId, srv.source, srv.scanId,
              srv.source, ts, srv.source, ts,
              source, srv.scanId, source, srv.scanId,
              srv.source, ts, srv.source, ts
            );

            // Clean verification queue - server has been re-observed
            db.prepare(`
              DELETE FROM hop_verification_queue
              WHERE run_id = ? AND place_id = ? AND job_id = ?
            `).run(runtime.run_id, placeId, srv.jobId);
          }
        });
        tx();
      }

      // 6-7. Mark source state success + task completed (atomic)
      try {
        // P0-2 Fix: markSuccess phải thành công mới được đánh dấu task COMPLETED
        sourceStateService.markSuccess(placeId, source, nextCursor);

        // P1-3 Fix: Lưu cả servers_received và servers_eligible để debug
        db.prepare(`
          UPDATE hop_fetch_tasks
          SET status = 'COMPLETED', completed_at = ?, servers_count = ?
          WHERE task_id = ?
        `).run(ts, eligibleServers.length, taskId);

        // Ghi log thống kê
        console.log(`[HOP-REPORT] Task ${taskId} completed: received=${stats.received} eligible=${eligibleServers.length}`);
      } catch (err) {
        console.error(`[HOP-FETCHER] Report: Failed to mark success or complete task: ${err.message}`);
        // Task remains PENDING, Fetcher sẽ retry
        return { ok: false, error: 'Failed to complete task', reason: err.message };
      }

      // 8. Get pool stats
      const poolActive = db.prepare(`
        SELECT COUNT(*) AS count FROM hop_servers
        WHERE place_id = ? AND run_id = ? AND eligible = 1 AND verify_status = 'ACTIVE'
      `).get(placeId, runtime.run_id);

      const poolTotal = db.prepare(`
        SELECT COUNT(*) AS count FROM hop_servers
        WHERE place_id = ? AND run_id = ?
      `).get(placeId, runtime.run_id);

      stats.poolActive = poolActive ? poolActive.count : 0;
      stats.poolTotal = poolTotal ? poolTotal.count : 0;

      console.log(
        `[HOP-REPORT] ${source}: received=${stats.received} newAdded=${stats.newAdded} ` +
        `matched=${stats.matchedExisting} updated=${stats.updated} reactivated=${stats.reactivated} ` +
        `playerChanged=${stats.playerChanged || 0} statusChanged=${stats.statusChanged || 0} ` +
        `removedOutOfRange=${stats.removedOutOfRange} skipped0=${stats.skippedZero} skipped9+=${stats.skippedAbove8} ` +
        `dup=${stats.duplicates} taskId=${taskId} poolActive=${stats.poolActive} poolTotal=${stats.poolTotal}`
      );

      return { ok: true, ...stats };
    } catch (err) {
      console.error('[HOP-FETCHER] Report error:', err.message);
      return { ok: false, error: err.message };
    }
  };

  // Báo lỗi Fetch
  const failFetch = (placeId, collectorId, leaseToken, source, error) => {
    const ts = now();
    const tokenHash = crypto.createHash('sha256').update(leaseToken).digest('hex');

    try {
      const lease = db.prepare(`
        SELECT expires_at FROM hop_fetcher_lease
        WHERE place_id = ? AND collector_id = ? AND lease_token_hash = ? AND status = 'ACTIVE' AND expires_at >= ?
      `).get(placeId, collectorId, tokenHash, ts);

      if (!lease) {
        console.warn(`[HOP-FETCHER] failFetch: invalid lease for ${collectorId}`);
        return { ok: false, error: 'Lease invalid or expired' };
      }

      console.warn(`[HOP-FETCHER] Fetch ${source} failed: ${error}`);
      sourceStateService.markFailure(placeId, source, error);
      return { ok: true };
    } catch (err) {
      console.error(`[HOP-FETCHER] failFetch error:`, err.message);
      return { ok: false, error: err.message };
    }
  };

  // Phase 1 Fix: Release Fetcher Claim
  const releaseFetcher = (placeId, collectorId, leaseToken) => {
    const tokenHash = crypto.createHash('sha256').update(leaseToken).digest('hex');

    try {
      const tx = db.transaction(() => {
        // V2.4 FIX: Accept both ACTIVE and STOPPING (idempotent Release)
        const lease = db.prepare(`
          SELECT expires_at, status FROM hop_fetcher_lease
          WHERE place_id = ? AND collector_id = ? AND lease_token_hash = ? AND status IN ('ACTIVE', 'STOPPING')
        `).get(placeId, collectorId, tokenHash);

        if (!lease) {
          throw new Error('Lease not found or already released');
        }

        // Mark as RELEASED
        db.prepare(`
          UPDATE hop_fetcher_lease
          SET status = 'RELEASED'
          WHERE place_id = ? AND collector_id = ? AND lease_token_hash = ?
        `).run(placeId, collectorId, tokenHash);

        return true;
      });

      tx();
      console.log(`[HOP-FETCHER] Released: ${collectorId} from place ${placeId}`);
      return { ok: true, code: 'RELEASED' };
    } catch (err) {
      if (err.message.includes('not found')) {
        return { ok: false, code: 'NOT_FOUND', error: err.message };
      }
      console.error(`[HOP-FETCHER] Release error:`, err.message);
      return { ok: false, error: err.message };
    }
  };

  // Phase 1 Fix: Stop Fetcher before Teleport (set lease to STOPPING, don't renew)
  const stopFetcher = (placeId, collectorId, leaseToken) => {
    const tokenHash = crypto.createHash('sha256').update(leaseToken).digest('hex');

    try {
      const lease = db.prepare(`
        SELECT expires_at FROM hop_fetcher_lease
        WHERE place_id = ? AND collector_id = ? AND lease_token_hash = ? AND status = 'ACTIVE'
      `).get(placeId, collectorId, tokenHash);

      if (!lease) {
        return { ok: false, code: 'NOT_FOUND', error: 'Lease not found' };
      }

      // Mark as STOPPING so no new tasks, but don't release yet
      db.prepare(`
        UPDATE hop_fetcher_lease
        SET status = 'STOPPING'
        WHERE place_id = ? AND collector_id = ? AND lease_token_hash = ?
      `).run(placeId, collectorId, tokenHash);

      console.log(`[HOP-FETCHER] Stopped: ${collectorId} from place ${placeId}`);
      return { ok: true, code: 'STOPPING' };
    } catch (err) {
      console.error(`[HOP-FETCHER] Stop error:`, err.message);
      return { ok: false, error: err.message };
    }
  };

  return {
    claimFetcher, heartbeatFetcher, getTask, reportServers, failFetch, releaseFetcher, stopFetcher,
    validateSessionGeneration, getLeaseStatus, getInFlightTasks, drainLease, fenceLease, recoverUnfinishedTasks
  };
};

const path = require('path');
const fs = require('fs');
const crypto = require('crypto');
const Database = require('better-sqlite3');

// ---------- config ----------
const DB_PATH = process.env.DB_PATH
  ? path.resolve(__dirname, process.env.DB_PATH)
  : path.join(__dirname, 'trackstat.db');
const ONLINE_MS = Number.parseInt(process.env.ONLINE_THRESHOLD_MS, 10) || 120000;
const SNAPSHOT_INTERVAL_MS = Number.parseInt(process.env.SNAPSHOT_INTERVAL_MS, 10) || 5 * 60 * 1000;
const DAY_MS = 86400000;
const TZ = /^[+-]\d{1,2} hours$/.test(process.env.HISTORY_TZ_OFFSET || '')
  ? process.env.HISTORY_TZ_OFFSET
  : '+7 hours';

// ---------- open ----------
fs.mkdirSync(path.dirname(DB_PATH), { recursive: true });
const db = new Database(DB_PATH);
db.pragma('journal_mode = WAL');
db.pragma('foreign_keys = ON');
db.pragma('busy_timeout = 5000');

// ---------- schema ----------
// data_ts / items_hash lưu thẳng trong accounts -> không cần cache RAM, restart không mất state.
db.exec(`
  CREATE TABLE IF NOT EXISTS accounts (
    id           TEXT PRIMARY KEY,
    name         TEXT NOT NULL,
    gems         REAL NOT NULL DEFAULT 0,
    rank         TEXT,
    rebirths     INTEGER,
    huge_potion  REAL NOT NULL DEFAULT 0,
    bucket       REAL NOT NULL DEFAULT 0,
    bucket_magic REAL NOT NULL DEFAULT 0,
    coins        REAL NOT NULL DEFAULT 0,
    last_seen    INTEGER NOT NULL,
    status       TEXT NOT NULL DEFAULT 'offline',
    created_at   INTEGER NOT NULL,
    data_ts      INTEGER NOT NULL DEFAULT 0,
    items_hash   TEXT
  );

  CREATE TABLE IF NOT EXISTS items (
    account_id TEXT NOT NULL,
    category   TEXT NOT NULL,
    item_id    TEXT NOT NULL,
    variant    TEXT NOT NULL DEFAULT 'Normal',
    amount     REAL NOT NULL DEFAULT 0,
    PRIMARY KEY (account_id, category, item_id, variant)
  );
  CREATE INDEX IF NOT EXISTS idx_items_account ON items(account_id);
  CREATE INDEX IF NOT EXISTS idx_items_category ON items(category);

  CREATE TABLE IF NOT EXISTS currencies (
    account_id  TEXT NOT NULL,
    currency_id TEXT NOT NULL,
    amount      REAL NOT NULL DEFAULT 0,
    PRIMARY KEY (account_id, currency_id)
  );

  CREATE TABLE IF NOT EXISTS snapshots (
    id         INTEGER PRIMARY KEY AUTOINCREMENT,
    account_id TEXT NOT NULL,
    ts         INTEGER NOT NULL,
    gems       REAL NOT NULL DEFAULT 0,
    payload    TEXT NOT NULL DEFAULT '{}'
  );

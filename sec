    Fire(Leave, S_CR2)
end

-- =========================================================
-- [ SERVER HOP ]
-- Het 360 giay -> chay truc tiep full loadstring
-- =========================================================

local function FastServerHop()
    if not isWorking then
        return
    end

    -- Dung cac luong burst truoc khi hop
    isWorking = false

    pcall(function()
        RunService:Set3dRenderingEnabled(true)
    end)

    print("[ServerHop] Het 360 giay, dang chay Serverhop Low...")

    local ok, err = pcall(function()
        loadstring(game:HttpGet(
            'https://raw.githubusercontent.com/Paule1248/Open-Source/refs/heads/main/Utils/Serverhop%20Low'
        ))()
    end)

    if not ok then
        warn("[ServerHop] Loi khi chay Serverhop Low: " .. tostring(err))
    end
end


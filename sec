-- =========================================================
-- [ RANDOM SERVER FETCHER ]
-- Lấy server từ Roblox Public Servers API.
-- Chỉ bỏ qua JobId hiện tại và loại ID trùng.
-- Không lọc theo player count.
-- =========================================================

local function fetchServerIds()
    local ids = {}
    local seen = {}

    for _, sortOrder in ipairs(HOP_SORT_ORDERS) do
        local cursor = nil

        for page = 1, HOP_MAX_PAGES do
            local url = string.format(
                "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=%s&limit=100&excludeFullGames=%s",
                TARGET_PLACE_ID,
                sortOrder,
                tostring(HOP_EXCLUDE_FULL)
            )

            if cursor then
                url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
            end

            local ok, response = pcall(function()
                local body = game:HttpGet(url)
                return HttpService:JSONDecode(body)
            end)

            if not ok
                or type(response) ~= "table"
                or type(response.data) ~= "table" then

                warn(
                    "[ServerHop] Fetch failed:",
                    sortOrder,
                    "page",
                    page,
                    tostring(response)
                )

                break
            end

            for _, server in ipairs(response.data) do
                local jobId = tostring(server.id or "")

                if jobId ~= ""
                    and jobId ~= game.JobId
                    and not seen[jobId] then

                    seen[jobId] = true
                    ids[#ids + 1] = jobId
                end
            end

            cursor = response.nextPageCursor

            if type(cursor) ~= "string" or cursor == "" then
                break
            end

            wait(HOP_PAGE_DELAY)
        end
    end

    print(
        "[ServerHop] Fetch completed. Candidates:",
        #ids
    )

    return ids
end

-- =========================================================
-- [ ERROR PROMPT DETECTION ]
-- =========================================================

local function findErrorPrompt()
    local ok, prompt = pcall(function()
        local gui = CoreGui:FindFirstChild("RobloxPromptGui")
        local overlay = gui and gui:FindFirstChild("promptOverlay")

        return overlay and overlay:FindFirstChild("ErrorPrompt")
    end)

    if ok then
        return prompt
    end

    return nil
end

-- =========================================================
-- [ RANDOM SERVER HOP ]
--
-- 1. Fetch server list
-- 2. Chọn JobId ngẫu nhiên
-- 3. Bỏ JobId vừa thử
-- 4. Teleport
-- 5. Nếu lỗi: đợi 3s và thử server khác
-- 6. Hết pool thì fetch lại
-- =========================================================

local function RandomServerHop()
    local env = (getgenv and getgenv()) or _G

    -- Chỉ cho phép một vòng Server Hop chạy cùng lúc
    if env.__HOP_ACTIVE then
        print("[ServerHop] Another hop process is already running")
        return
    end

    env.__HOP_ACTIVE = true

    math.randomseed(
        os.time() + math.floor(os.clock() * 100000)
    )

    local pool = {}
    local attempted = {}

    local teleportFailed = false

    local connection = TeleportService.TeleportInitFailed:Connect(
        function(player)
            if player == LocalPlayer then
                teleportFailed = true
            end
        end
    )

    local function refreshPool()
        print("[ServerHop] Fetching random server candidates...")

        local newPool = fetchServerIds()
        local available = {}

        -- Không thử lại các JobId đã thất bại trong batch hiện tại
        for _, jobId in ipairs(newPool) do
            if not attempted[jobId] then
                available[#available + 1] = jobId
            end
        end

        -- Đã thử hết candidate: reset blacklist của batch
        if #available == 0 and #newPool > 0 then
            print("[ServerHop] All candidates attempted. Resetting batch.")

            attempted = {}
            available = newPool
        end

        pool = available

        print(
            "[ServerHop] Available random servers:",
            #pool
        )
    end

    local success, err = pcall(function()
        while true do
            -- Pool hết thì lấy danh sách mới
            if #pool == 0 then
                refreshPool()
            end

            -- Không fetch được server nào
            if #pool == 0 then
                warn("[ServerHop] No server candidates. Retry in 3s...")
                wait(HOP_RETRY_DELAY)
                continue
            end

            -- Lấy ngẫu nhiên một JobId
            local randomIndex = math.random(1, #pool)
            local pickedJobId = table.remove(pool, randomIndex)

            attempted[pickedJobId] = true
            teleportFailed = false

            print(
                "[ServerHop] → Random server:",
                pickedJobId,
                "| Remaining:",
                #pool
            )

            -- Thực hiện Teleport
            local callOk, callErr = pcall(function()
                TeleportService:TeleportToPlaceInstance(
                    TARGET_PLACE_ID,
                    pickedJobId,
                    LocalPlayer
                )
            end)

            local failed = not callOk

            if not callOk then
                warn(
                    "[ServerHop] Teleport call error:",
                    tostring(callErr)
                )
            end

            -- Chờ kết quả Teleport / ErrorPrompt
            if not failed then
                local started = os.clock()

                while os.clock() - started < HOP_TELEPORT_WAIT do
                    local prompt = findErrorPrompt()

                    if prompt or teleportFailed then
                        print(
                            "[ServerHop] Teleport failed / ErrorPrompt detected"
                        )

                        if prompt then
                            pcall(function()
                                prompt:Destroy()
                            end)
                        end

                        failed = true
                        break
                    end

                    wait(0.25)
                end
            end

            if failed then
                print(
                    "[ServerHop] Failed server:",
                    pickedJobId,
                    "| Retry in 3 seconds"
                )

                wait(HOP_RETRY_DELAY)
            else
                print(
                    "[ServerHop] No transition detected after",
                    HOP_TELEPORT_WAIT,
                    "seconds. Trying another server..."
                )

                wait(HOP_RETRY_DELAY)
            end
        end
    end)

    -- Dọn kết nối nếu vòng hop bị dừng do lỗi
    if connection then
        connection:Disconnect()
    end

    env.__HOP_ACTIVE = nil

    if not success then
        warn("[ServerHop] RandomServerHop stopped:", tostring(err))
    end
end

-- =========================================================
-- [ START SERVER HOP ]
-- Thay thế hoàn toàn loadstring Serverhop Low.
-- =========================================================

local function FastServerHop()
    if not isWorking then
        return
    end

    -- Dừng tất cả Burst Thread
    isWorking = false

    pcall(function()
        RunService:Set3dRenderingEnabled(true)
    end)

    print(
        "[ServerHop] Hết",
        HOP_TIME,
        "giây. Starting Random Server Hop..."
    )

    -- Chạy trực tiếp Random Server Hop
    RandomServerHop()
end


local function clearCameraParts()
    pcall(function()
        local cam = workspace.CurrentCamera or workspace:FindFirstChild("Camera")
        if not cam then return end
        for _, v in ipairs(cam:GetChildren()) do
            if v.ClassName == "Part" then
                v:Destroy()
            end
        end
    end)
end

local function openAllGiftBags()
    if bagLoopStarted then
        return
    end
    bagLoopStarted = true
    stopHop = true
    isWorking = false
    phase = "OPENING_BAGS"

    pcall(function()
        RunService:Set3dRenderingEnabled(true)
    end)

    local GiftBagOpen = Network:WaitForChild("GiftBag_Open", 10)
    if not GiftBagOpen then
        warn("[GiftBag] Không tìm thấy Network.GiftBag_Open")
        phase = "DONE"
        return
    end

    print("[GiftBag] Hết Secret Key -> bắt đầu mở Mini Chest, Charm Stone, Large Gift Bag, Gift Bag...")

    local lastTotal = -1
    local stallCount = 0

    while ScreenGui.Parent do
        local _, bagCounts, _, loaded = getTrackCounts()
        if not loaded then
            wait(0.5)
            continue
        end

        local totalLeft = 0
        for _, bag in ipairs(GIFT_BAGS) do
            totalLeft += (bagCounts[bag.id] or 0)
        end

        if totalLeft <= 0 then
            clearCameraParts()
            break
        end

        if totalLeft == lastTotal then
            stallCount += 1
            if stallCount >= 40 then
                warn("[GiftBag] Dừng do số lượng bag không giảm sau nhiều lần thử:", totalLeft)
                break
            end
        else
            lastTotal = totalLeft
            stallCount = 0
        end

        for _, bag in ipairs(GIFT_BAGS) do
            local amt = bagCounts[bag.id] or 0
            if amt > 0 then
                pcall(function()
                    GiftBagOpen:InvokeServer(bag.id, math.min(amt, bag.batch))
                end)
            end
        end

        clearCameraParts()
        wait(0.15)
    end

    phase = "DONE"
    print("[GiftBag] Đã mở xong toàn bộ Gift Bag / Mini Chest / Charm Stone. Dừng (không hop server).")
end


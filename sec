spawn(function()
    wait(5)

    if not isWorking or stopHop or bagLoopStarted then
        return
    end

    -- Bắt đầu countdown sau khi khởi động
    hopDeadline = tick() + HOP_TIME

    pcall(function()
        RunService:Set3dRenderingEnabled(false)
    end)

    pcall(function()
        settings().Physics.PhysicsEnvironmentalThrottle =
            Enum.EnviromentalPhysicsThrottle.Disabled
    end)

    -- Garbage Collection định kỳ
    spawn(function()
        while isWorking do
            wait(30)

            pcall(function()
                collectgarbage("collect")
            end)
        end
    end)

    -- Hết thời gian thì chuyển sang Random Server Hop
    task.delay(HOP_TIME, FastServerHop)

    -- Các luồng Burst
    for i = 1, THREAD_COUNT do
        spawn(function()
            while isWorking do
                UltraBurstFire()
                wait(DELAY_TIME)
            end
        end)
    end
end)


-- =========================================================
-- [ TRACK INVENTORY ]
-- Chi doc item truc tiep trong inventory.
-- Khong quet de quy / khong doc vat pham ben trong Item Box.
-- =========================================================

local SaveModule = require(
    ReplicatedStorage:WaitForChild("Library")
        :WaitForChild("Client")
        :WaitForChild("Save")
)

local TRACK_IDS = {
    ["Secret Key"] = "Secret Key",
    ["Royalty Charm"] = "Royalty",
    ["Overload Charm"] = "Overload",
    ["The Cocktail"] = "The Cocktail",
}

local function getTrackCounts()
    local counts = {
        ["Secret Key"] = 0,
        ["Royalty Charm"] = 0,
        ["Overload Charm"] = 0,
        ["The Cocktail"] = 0,
    }

    local ok, result = pcall(function()
        local data = SaveModule.Get()
        local inventory = data and data.Inventory

        if type(inventory) ~= "table" then
            return false
        end

        for category, items in pairs(inventory) do
            local categoryName = tostring(category):lower()

            -- Bo qua category Item Box neu co
            if not categoryName:find("itembox", 1, true)
                and not categoryName:find("item box", 1, true)
                and type(items) == "table" then

                -- Chi kiem tra item truc tiep, khong quet nested table
                for _, item in pairs(items) do
                    if type(item) == "table" then
                        local id = tostring(item.id or "")

                        for displayName, targetId in pairs(TRACK_IDS) do
                            if id == targetId then
                                counts[displayName] =
                                    counts[displayName]
                                    + (tonumber(item._am) or 1)
                            end
                        end
                    end
                end
            end
        end

        return true
    end)

    if not ok or result ~= true then
        return counts, false
    end

    return counts, true
end


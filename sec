-- Khong quet de quy / khong doc noi dung Item Box.
-- =========================================================

local SaveModule = require(
    ReplicatedStorage:WaitForChild("Library")
        :WaitForChild("Client")
        :WaitForChild("Save")
)

local TRACK_CATEGORIES = {
    Misc = {
        ["Secret Key"] = "Secret Key",
    },

    Charm = {
        ["Royalty Charm"] = "Royalty",
        ["Overload Charm"] = "Overload",
    },

    Potion = {
        ["The Cocktail"] = "The Cocktail",
    },
}

local function getTrackCounts()
    local counts = {
        ["Secret Key"] = 0,
        ["Royalty Charm"] = 0,
        ["Overload Charm"] = 0,
        ["The Cocktail"] = 0,
    }

    local ok, loaded = pcall(function()
        local data = SaveModule.Get()
        local inventory = data and data.Inventory

        if type(inventory) ~= "table" then
            return false
        end

        for category, targets in pairs(TRACK_CATEGORIES) do
            local items = inventory[category]

            if type(items) == "table" then
                for _, item in pairs(items) do
                    if type(item) == "table" then
                        local id = tostring(item.id or "")

                        for displayName, targetId in pairs(targets) do
                            if id == targetId then
                                counts[displayName] +=
                                    tonumber(item._am) or 1
                            end
                        end
                    end
                end
            end
        end

        return true
    end)

    if not ok or loaded ~= true then
        return counts, false
    end

    return counts, true
end


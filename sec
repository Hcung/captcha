local function UltraBurstFire()
    spawn(Invk, Unlock, S_CR1)
    spawn(Invk, Enter, S_CR2)
    spawn(Invk, Custom, S_CR2, S_SC, 2)
    Fire(Leave, S_CR2)
end

-- =========================================================
-- [ SERVER HOP ]
-- =========================================================

local function FastServerHop()
    if not isWorking then
        return
    end

    isWorking = false

    RunService:Set3dRenderingEnabled(true)
    wait(2)

    print("Dang teleport toi Place ID: " .. TARGET_PLACE_ID)

    local ok, err = pcall(function()
        TeleportService:Teleport(TARGET_PLACE_ID, LocalPlayer)
    end)

    if not ok then
        warn("[ServerHop] Teleport loi: " .. tostring(err))
    end

    task.delay(5, function()
        pcall(function()
            TeleportService:Teleport(TARGET_PLACE_ID, LocalPlayer)
        end)
    end)
end


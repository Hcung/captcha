local function formatNumber(n)
    local s = tostring(math.floor(tonumber(n) or 0))
    local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
    if formatted:sub(1, 1) == "," then
        formatted = formatted:sub(2)
    end
    return formatted
end

local function formatRap(val)
    local v = tonumber(val) or 0
    if v >= 1e9 then
        return string.format("%.2fb", v / 1e9)
    elseif v >= 1e6 then
        return string.format("%.2fm", v / 1e6)
    elseif v >= 1e3 then
        return string.format("%.1fk", v / 1e3)
    end
    return tostring(math.floor(v))
end

local function getTrackCounts()
    local counts = {
        ["Secret Key"]       = 0,
        ["Royalty Charm"]    = 0,
        ["Overload Charm"]   = 0,
        ["XP Charm"]         = 0,
        ["Glittering Charm"] = 0,
        ["Tech Key"]         = 0,
        ["Crystal Key"]      = 0,
        ["The Cocktail"]     = 0,
        ["Huge Normal"]      = 0,
        ["Huge Golden"]      = 0,
    }
    local bagCounts = {
        ["Mini Chest"]     = 0,
        ["Charm Stone"]    = 0,
        ["Large Gift Bag"] = 0,
        ["Gift Bag"]       = 0,
    }

    local ok, loaded = pcall(function()
        local data = SaveModule.Get()
        local inventory = data and data.Inventory

        if type(inventory) ~= "table" then
            return false
        end

        for category, targets in pairs(TRACK_CATEGORIES) do
            local items = inventory[category]

            if type(items) == "table" then
                for _, item in pairs(items) do
                    if type(item) == "table" then
                        local id = tostring(item.id or "")

                        for displayName, targetId in pairs(targets) do
                            if id == targetId then
                                counts[displayName] +=
                                    tonumber(item._am) or 1
                            end
                        end

                        if category == "Misc" and bagCounts[id] ~= nil then
                            bagCounts[id] += tonumber(item._am) or 1
                        end
                    end
                end
            end
        end

        local pets = inventory.Pet
        if type(pets) == "table" then
            for _, item in pairs(pets) do
                if type(item) == "table" and tostring(item.id or "") == "Huge Lumi Axolotl" then
                    local am = tonumber(item._am) or 1
                    if item.pt == 1 then
                        counts["Huge Golden"] += am
                    elseif item.pt == nil or item.pt == 0 then
                        counts["Huge Normal"] += am
                    end
                end
            end
        end

        return true
    end)

    if not ok or loaded ~= true then
        return counts, bagCounts, 0, false
    end

    local totalRap = 0
    for itemName, unitRap in pairs(RAP_PRICES) do
        totalRap += (counts[itemName] or 0) * unitRap
    end

    return counts, bagCounts, totalRap, true
end

